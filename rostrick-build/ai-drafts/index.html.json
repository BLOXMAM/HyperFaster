{"job":"jmws0ga1ecj2u","file":"index.html","text":"<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>الرئيسية - ألغاز و العاب ذكاء</title>\n<style>\n:root {\n  --primary: #6200EE;\n  --primary-dark: #3700B3;\n  --accent: #03DAC6;\n  --highlight: #FFEB3B;\n  --control: #B0BEC5;\n  --bg-dark: #121212;\n  --surface: #1E1E1E;\n  --surface-card: #252525;\n  --text-main: #E0E0E0;\n  --text-muted: #9E9E9E;\n  --danger: #CF6679;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n  -webkit-tap-highlight-color: transparent;\n}\n\nbody {\n  background-color: var(--bg-dark);\n  color: var(--text-main);\n  font-family: system-ui, -apple-system, Roboto, sans-serif;\n  padding-top: env(safe-area-inset-top);\n  padding-bottom: env(safe-area-inset-bottom);\n  overflow-x: hidden;\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n  height: calc(100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom));\n}\n\n/* App Bar */\n.app-bar {\n  background-color: var(--surface);\n  height: 56px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 16px;\n  position: sticky;\n  top: 0;\n  z-index: 100;\n  border-bottom: 1px solid rgba(255,255,255,0.08);\n}\n\n.app-title {\n  font-size: 18px;\n  font-weight: bold;\n  color: var(--text-main);\n}\n\n.app-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.icon-btn {\n  background: none;\n  border: none;\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--text-main);\n  cursor: pointer;\n}\n\n.icon-btn:active {\n  background-color: rgba(255,255,255,0.1);\n}\n\n.icon-btn svg {\n  width: 24px;\n  height: 24px;\n  fill: currentColor;\n}\n\n/* Main Content Container */\n.content-container {\n  flex: 1;\n  overflow-y: auto;\n  padding: 16px;\n  padding-bottom: 80px; /* Space for bottom nav */\n}\n\n/* Banner */\n.banner-card {\n  background: linear-gradient(135deg, var(--primary-dark), var(--primary));\n  border-radius: 16px;\n  padding: 20px;\n  margin-bottom: 20px;\n  position: relative;\n  overflow: hidden;\n  box-shadow: 0 4px 12px rgba(98, 0, 238, 0.3);\n}\n\n.banner-title {\n  font-size: 20px;\n  font-weight: bold;\n  color: #ffffff;\n  margin-bottom: 8px;\n}\n\n.banner-desc {\n  font-size: 14px;\n  color: rgba(255,255,255,0.8);\n  margin-bottom: 16px;\n  line-height: 1.4;\n}\n\n.banner-btn {\n  background-color: var(--accent);\n  color: #000000;\n  border: none;\n  padding: 10px 20px;\n  border-radius: 20px;\n  font-weight: bold;\n  font-size: 14px;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.banner-btn:active {\n  opacity: 0.8;\n}\n\n/* Section Header */\n.section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 12px;\n}\n\n.section-title {\n  font-size: 16px;\n  font-weight: bold;\n  color: var(--text-main);\n}\n\n.section-filter {\n  font-size: 12px;\n  color: var(--accent);\n  background: none;\n  border: none;\n  cursor: pointer;\n}\n\n/* Game List / Cards */\n.games-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.game-card {\n  background-color: var(--surface-card);\n  border-radius: 12px;\n  padding: 12px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  cursor: pointer;\n  border: 1px solid rgba(255,255,255,0.04);\n  transition: background-color 0.2s;\n  text-decoration: none;\n  color: inherit;\n}\n\n.game-card:active {\n  background-color: rgba(255,255,255,0.06);\n}\n\n.game-icon {\n  width: 64px;\n  height: 64px;\n  border-radius: 12px;\n  flex-shrink: 0;\n  object-fit: cover;\n}\n\n.game-info {\n  flex: 1;\n  min-width: 0;\n}\n\n.game-title {\n  font-size: 16px;\n  font-weight: bold;\n  color: var(--text-main);\n  margin-bottom: 4px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.game-desc {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  line-height: 1.3;\n}\n\n.game-meta {\n  display: flex;\n  gap: 12px;\n  font-size: 11px;\n  color: var(--control);\n}\n\n.game-meta span {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n/* Bottom Navigation */\n.bottom-nav {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  height: 60px;\n  background-color: var(--surface);\n  display: flex;\n  justify-content: space-around;\n  align-items: center;\n  border-top: 1px solid rgba(255,255,255,0.08);\n  z-index: 100;\n  padding-bottom: env(safe-area-inset-bottom);\n}\n\n.nav-item {\n  flex: 1;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  background: none;\n  border: none;\n  color: var(--text-muted);\n  text-decoration: none;\n  font-size: 10px;\n  gap: 4px;\n  cursor: pointer;\n}\n\n.nav-item.active {\n  color: var(--accent);\n}\n\n.nav-item:active {\n  background-color: rgba(255,255,255,0.05);\n}\n\n.nav-item svg {\n  width: 22px;\n  height: 22px;\n  fill: currentColor;\n}\n\n/* Loading State */\n.loading-box {\n  text-align: center;\n  padding: 40px;\n  color: var(--text-muted);\n  font-size: 14px;\n}\n</style>\n</head>\n<body>\n\n  <!-- App Bar -->\n  <header class=\"app-bar\">\n    <h1 class=\"app-title\">الرئيسية</h1>\n    <div class=\"app-actions\">\n      <a href=\"admin.html\" class=\"icon-btn\" aria-label=\"لوحة التحكم\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z\"/></svg>\n      </a>\n    </div>\n  </header>\n\n  <!-- Main Scrollable Area -->\n  <main class=\"content-container\">\n    \n    <!-- Floating Window Guide Banner -->\n    <div class=\"banner-card\">\n      <h2 class=\"banner-title\">ميزة النافذة العائمة</h2>\n      <p class=\"banner-desc\">تعلم كيف تستخدم النافذة العائمة لحل الألغاز الصعبة فوق التطبيقات الأخرى بكل سهولة ويسر.</p>\n      <a href=\"overlay-guide.html\" class=\"banner-btn\">\n        <span>قراءة الإرشادات</span>\n","at":1795362567324}