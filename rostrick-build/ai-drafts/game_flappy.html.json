{"job":"jmws3yu10zbsm","file":"game_flappy.html","text":"<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <title>البطل الطائر - كوميكس أوفرلاي</title>\n  <style>\n    :root {\n      --primary: #D90429;\n      --primary-dark: #8D0801;\n      --accent: #FFB703;\n      --highlight: #FB8500;\n      --control: #2B2D42;\n      --bg-deep: #141521;\n      --bg-panel: #1E2030;\n      --text-main: #FFFFFF;\n      --text-muted: #CBD5E1;\n      --ink: #0B0C14;\n    }\n\n    * {\n      box-sizing: border-box;\n      -webkit-tap-highlight-color: transparent;\n    }\n\n    html, body {\n      margin: 0;\n      padding: 0;\n      min-height: 100%;\n      background-color: var(--bg-deep);\n      color: var(--text-main);\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Tahoma, Arial, sans-serif;\n      overflow-x: hidden;\n    }\n\n    body {\n      display: flex;\n      flex-direction: column;\n      background-image: radial-gradient(rgba(255, 183, 3, 0.08) 1.5px, transparent 1.5px);\n      background-size: 16px 16px;\n      padding-bottom: calc(68px + env(safe-area-inset-bottom));\n    }\n\n    body.overlay-compact {\n      padding-bottom: env(safe-area-inset-bottom);\n    }\n\n    /* App Bar */\n    .app-bar {\n      position: sticky;\n      top: 0;\n      z-index: 30;\n      background: var(--control);\n      border-bottom: 3px solid var(--accent);\n      box-shadow: 0 4px 0 var(--ink);\n      padding-top: env(safe-area-inset-top);\n    }\n\n    .app-bar-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      height: 56px;\n      padding: 0 10px;\n    }\n\n    .bar-group {\n      display: flex;\n      align-items: center;\n    }\n\n    .icon-btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-width: 44px;\n      min-height: 44px;\n      padding: 0 8px;\n      border-radius: 10px;\n      border: 2px solid var(--ink);\n      background: #383B56;\n      color: var(--text-main);\n      text-decoration: none;\n      cursor: pointer;\n      box-shadow: 0 3px 0 var(--ink);\n      transition: transform 0.1s ease, background-color 0.15s ease;\n    }\n\n    .icon-btn:active {\n      transform: translateY(2px) scale(0.96);\n      box-shadow: 0 1px 0 var(--ink);\n    }\n\n    .icon-btn.is-active {\n      background: var(--accent);\n      color: var(--ink);\n    }\n\n    .icon-btn-primary {\n      background: var(--primary);\n      color: #FFFFFF;\n    }\n\n    .bar-title-wrap {\n      display: flex;\n      flex-direction: column;\n      margin-right: 10px;\n    }\n\n    .bar-title {\n      font-size: 17px;\n      font-weight: 900;\n      line-height: 1.2;\n      letter-spacing: 0.2px;\n      text-shadow: 2px 2px 0 var(--ink);\n    }\n\n    .bar-sub {\n      font-size: 11px;\n      font-weight: 700;\n      color: var(--accent);\n    }\n\n    .bar-actions .icon-btn {\n      margin-right: 6px;\n    }\n\n    /* Main Container */\n    .main-wrap {\n      width: 100%;\n      max-width: 520px;\n      margin: 0 auto;\n      padding: 10px 12px 14px;\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n    }\n\n    /* Score & Mode HUD */\n    .hud-strip {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 10px;\n    }\n\n    .hud-scores {\n      display: flex;\n      align-items: center;\n    }\n\n    .score-pill {\n      display: flex;\n      align-items: center;\n      background: var(--bg-panel);\n      border: 2px solid var(--ink);\n      border-radius: 12px;\n      padding: 6px 12px;\n      box-shadow: 0 3px 0 var(--ink);\n      margin-left: 8px;\n    }\n\n    .score-label {\n      font-size: 11px;\n      color: var(--text-muted);\n      font-weight: 700;\n      margin-left: 6px;\n    }\n\n    .score-val {\n      font-size: 18px;\n      font-weight: 900;\n      color: var(--accent);\n      line-height: 1;\n    }\n\n    .score-val.best {\n      color: #38BDF8;\n    }\n\n    .hud-controls {\n      display: flex;\n      align-items: center;\n    }\n\n    .chip-btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 44px;\n      padding: 0 12px;\n      border-radius: 10px;\n      border: 2px solid var(--ink);\n      background: var(--control);\n      color: var(--text-main);\n      font-size: 12px;\n      font-weight: 800;\n      cursor: pointer;\n      box-shadow: 0 3px 0 var(--ink);\n      transition: transform 0.1s ease, background-color 0.15s ease;\n      margin-right: 6px;\n    }\n\n    .chip-btn:active {\n      transform: translateY(2px) scale(0.96);\n      box-shadow: 0 1px 0 var(--ink);\n    }\n\n    .chip-btn.speed-fast {\n      background: var(--highlight);\n      color: var(--ink);\n    }\n\n    .chip-btn.float-on {\n      background: var(--accent);\n      color: var(--ink);\n    }\n\n    /* Simulated Floating Overlay Frame */\n    .stage-wrapper {\n      width: 100%;\n      transition: all 0.25s ease;\n    }\n\n    .stage-wrapper.floating-sim {\n      background: repeating-linear-gradient(\n        -45deg,\n        #191B2B,\n        #191B2B 10px,\n        #141521 10px,\n        #141521 20px\n      );\n      border: 2px dashed var(--accent);\n      border-radius: 18px;\n      padding: 14px 10px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n\n    .floating-sim-banner {\n      display: none;\n      align-items: center;\n      justify-content: space-between;\n      width: 276px;\n      background: var(--control);\n      border: 2px solid var(--ink);\n      border-bottom: none;\n      border-radius: 12px 12px 0 0;\n      padding: 6px 10px;\n      font-size: 11px;\n      font-weight: 800;\n      color: var(--accent);\n    }\n\n    .stage-wrapper.floating-sim .floating-sim-banner {\n      display: flex;\n    }\n\n    /* Game Stage Box */\n    .game-stage {\n      position: relative;\n      width: 100%;\n      height: 360px;\n      background: #0D1021;\n      border: 3px solid var(--ink);\n      border-radius: 16px;\n      overflow: hidden;\n      box-shadow: 0 6px 0 var(--ink), 0 0 0 2px var(--accent);\n      user-select: none;\n      touch-action: manipulation;\n    }\n\n    .stage-wrapper.floating-sim .game-stage {\n      width: 276px;\n      height: 290px;\n      border-radius: 0 0 14px 14px;\n      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.7), 0 0 0 2px var(--accent);\n    }\n\n    canvas#gameCanvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n      cursor: pointer;\n    }\n\n    /* In-Canvas Floating HUD Button */\n    .stage-pause-btn {\n      position: absolute;\n      top: 10px;\n      left: 10px;\n      z-index: 10;\n      min-width: 44px;\n      min-height: 44px;\n      border-radius: 10px;\n      border: 2px solid var(--ink);\n      background: rgba(43, 45, 66, 0.88);\n      color: #FFFFFF;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      box-shadow: 0 3px 0 var(--ink);\n    }\n\n    .stage-pause-btn:active {\n      transform: translateY(2px) scale(0.95);\n    }\n\n    .stage-combo-badge {\n      position: absolute;\n      top: 12px;\n      right: 12px;\n      z-index: 10;\n      background: var(--primary);\n      color: #FFFFFF;\n      border: 2px solid var(--ink);\n      border-radius: 999px;\n      padding: 4px 10px;\n      font-size: 11px;\n      font-weight: 900;\n      box-shadow: 0 2px 0 var(--ink);\n      opacity: 0;\n      transform: scale(0.85);\n      transition: opacity 0.2s ease, transform 0.2s ease;\n      pointer-events: none;\n    }\n\n    .stage-combo-badge.show {\n      opacity: 1;\n      transform: scale(1);\n    }\n\n    /* Overlays inside Canvas */\n    .stage-overlay {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      z-index: 20;\n      background: rgba(11, 12, 20, 0.82);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 14px;\n    }\n\n    .stage-overlay.hidden {\n      display: none;\n    }\n\n    .comic-modal {\n      width: 100%;\n      max-width: 290px;\n      background: var(--bg-panel);\n      border: 3px solid var(--ink);\n      border-radius: 16px;\n      padding: 16px 14px;\n      text-align: center;\n      box-shadow: 5px 5px 0 var(--accent);\n    }\n\n    .comic-badge {\n      display: inline-block;\n      background: var(--primary);\n      color: #FFFFFF;\n      border: 2px solid var(--ink);\n      border-radius: 8px;\n      padding: 3px 10px;\n      font-size: 11px;\n      font-weight: 900;\n      margin-bottom: 8px;\n      transform: rotate(-2deg);\n    }\n\n    .comic-badge.record {\n      background: var(--accent);\n      color: var(--ink);\n    }\n\n    .modal-title {\n      margin: 0 0 6px;\n      font-size: 20px;\n      font-weight: 900;\n      color: #FFFFFF;\n      text-shadow: 2px 2px 0 var(--ink);\n    }\n\n    .modal-desc {\n      margin: 0 0 12px;\n      font-size: 12px;\n      line-height: 1.5;\n      color: var(--text-muted);\n      font-weight: 600;\n    }\n\n    .modal-stats {\n      display: flex;\n      justify-content: center;\n      margin-bottom: 12px;\n    }\n\n    .modal-stat-box {\n      flex: 1;\n      background: var(--bg-deep);\n      border: 2px solid var(--ink);\n      border-radius: 10px;\n      padding: 8px 6px;\n      margin: 0 4px;\n    }\n\n    .modal-stat-box span {\n      display: block;\n      font-size: 10px;\n      color: var(--text-muted);\n      font-weight: 700;\n    }\n\n    .modal-stat-box strong {\n      display: block;\n      font-size: 20px;\n      font-weight: 900;\n      color: var(--accent);\n      margin-top: 2px;\n    }\n\n    .btn-comic {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      width: 100%;\n      min-height: 46px;\n      padding: 0 14px;\n      border-radius: 12px;\n      border: 2px solid var(--ink);\n      background: var(--primary);\n      color: #FFFFFF;\n      font-size: 15px;\n      font-weight: 900;\n      text-decoration: none;\n      cursor: pointer;\n      box-shadow: 0 4px 0 var(--ink);\n      transition: transform 0.1s ease, background-color 0.15s ease;\n    }\n\n    .btn-comic:active {\n      transform: translateY(2px) scale(0.97);\n      box-shadow: 0 1px 0 var(--ink);\n    }\n\n    .btn-comic.accent {\n      background: var(--accent);\n      color: var(--ink);\n    }\n\n    .btn-comic.secondary {\n      background: var(--control);\n      color: #FFFFFF;\n      margin-top: 8px;\n      font-size: 13px;\n      min-height: 44px;\n    }\n\n    /* Primary Thumb Action Bar */\n    .action-row {\n      display: flex;\n      align-items: center;\n      margin-top: 10px;\n    }\n\n    .flap-thumb-btn {\n      flex: 1;\n      min-height: 52px;\n      border-radius: 14px;\n      border: 3px solid var(--ink);\n      background: linear-gradient(180deg, var(--accent) 0%, var(--highlight) 100%);\n      color: var(--ink);\n      font-size: 16px;\n      font-weight: 900;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      box-shadow: 0 4px 0 var(--ink);\n      transition: transform 0.08s ease;\n    }\n\n    .flap-thumb-btn:active {\n      transform: translateY(3px) scale(0.98);\n      box-shadow: 0 1px 0 var(--ink);\n    }\n\n    .flap-thumb-btn svg {\n      margin-left: 8px;\n    }\n\n    /* Info Card from games.json */\n    .info-card {\n      margin-top: 12px;\n      background: var(--bg-panel);\n      border: 2px solid var(--ink);\n      border-radius: 14px;\n      padding: 12px;\n      box-shadow: 0 4px 0 var(--ink);\n      display: flex;\n      align-items: center;\n    }\n\n    body.overlay-compact .info-card {\n      display: none;\n    }\n\n    .info-cover {\n      width: 58px;\n      height: 58px;\n      border-radius: 12px;\n      border: 2px solid var(--ink);\n      background: var(--bg-deep);\n      flex-shrink: 0;\n      object-fit: cover;\n      margin-left: 12px;\n    }\n\n    .info-body {\n      flex: 1;\n      min-width: 0;\n    }\n\n    .info-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 4px;\n    }\n\n    .info-title {\n      font-size: 14px;\n      font-weight: 900;\n      color: #FFFFFF;\n      margin: 0;\n    }\n\n    .overlay-tag {\n      font-size: 10px;\n      font-weight: 800;\n      padding: 2px 8px;\n      border-radius: 999px;\n      background: #059669;\n      color: #FFFFFF;\n      border: 1.5px solid var(--ink);\n      white-space: nowrap;\n    }\n\n    .info-desc {\n      margin: 0;\n      font-size: 12px;\n      line-height: 1.45;\n      color: var(--text-muted);\n    }\n\n    /* Bottom Navigation */\n    .bottom-nav {\n      position: fixed;\n      bottom: 0;\n      left: 0;\n      right: 0;\n      z-index: 30;\n      background: var(--control);\n      border-top: 3px solid var(--ink);\n      padding-bottom: env(safe-area-inset-bottom);\n      box-shadow: 0 -3px 12px rgba(0, 0, 0, 0.45);\n    }\n\n    body.overlay-compact .bottom-nav {\n      display: none;\n    }\n\n    .bottom-nav-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-around;\n      max-width: 520px;\n      margin: 0 auto;\n      height: 60px;\n      padding: 0 10px;\n    }\n\n    .nav-item {\n      flex: 1;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 46px;\n      margin: 0 5px;\n      border-radius: 12px;\n      border: 2px solid var(--ink);\n      background: #383B56;\n      color: #FFFFFF;\n      text-decoration: none;\n      font-size: 13px;\n      font-weight: 800;\n      box-shadow: 0 3px 0 var(--ink);\n      transition: transform 0.1s ease, background-color 0.15s ease;\n    }\n\n    .nav-item:active {\n      transform: translateY(2px) scale(0.97);\n      box-shadow: 0 1px 0 var(--ink);\n    }\n\n    .nav-item.overlay-cta {\n      background: var(--primary);\n      color: #FFFFFF;\n    }\n\n    .nav-item svg {\n      margin-left: 7px;\n      flex-shrink: 0;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Top App Bar -->\n  <header class=\"app-bar\">\n    <div class=\"app-bar-inner\">\n      <div class=\"bar-group\">\n        <a href=\"games.html\" class=\"icon-btn\" aria-label=\"العودة إلى الألعاب\" title=\"العودة إلى الألعاب\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <polyline points=\"9 18 15 12 9 6\"></polyline>\n          </svg>\n        </a>\n        <div class=\"bar-title-wrap\">\n          <span class=\"bar-title\" id=\"headerTitle\">البطل الطائر</span>\n          <span class=\"bar-sub\" id=\"headerSub\">أركيد سريع متوافق مع النافذة العائمة</span>\n        </div>\n      </div>\n\n      <div class=\"bar-group bar-actions\">\n        <button type=\"button\" id=\"soundToggleBtn\" class=\"icon-btn is-active\" aria-label=\"تبديل المؤثرات الصوتية\" title=\"المؤثرات الصوتية\">\n          <svg id=\"soundOnIcon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon>\n            <path d=\"M15.54 8.46a5 5 0 0 1 0 7.07\"></path>\n            <path d=\"M19.07 4.93a10 10 0 0 1 0 14.14\"></path>\n          </svg>\n          <svg id=\"soundOffIcon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"display:none;\">\n            <polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon>\n            <line x1=\"23\" y1=\"9\" x2=\"17\" y2=\"15\"></line>\n            <line x1=\"17\" y1=\"9\" x2=\"23\" y2=\"15\"></line>\n          </svg>\n        </button>\n\n        <a href=\"overlay_hub.html\" class=\"icon-btn icon-btn-primary\" aria-label=\"تشغيل في الطبقة العائمة\" title=\"إعدادات الطبقة العائمة\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"></rect>\n            <rect x=\"10\" y=\"10\" width=\"9\" height=\"9\" rx=\"2\" fill=\"currentColor\" fill-opacity=\"0.25\"></rect>\n          </svg>\n        </a>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"main-wrap\">\n    <!-- HUD Strip -->\n    <section class=\"hud-strip\" aria-label=\"إحصائيات اللعبة\">\n      <div class=\"hud-scores\">\n        <div class=\"score-pill\">\n          <span class=\"score-label\">النقاط</span>\n          <span class=\"score-val\" id=\"scoreDisplay\">0</span>\n        </div>\n        <div class=\"score-pill\">\n          <span class=\"score-label\">الأعلى</span>\n          <span class=\"score-val best\" id=\"bestDisplay\">0</span>\n        </div>\n      </div>\n\n      <div class=\"hud-controls\">\n        <button type=\"button\" id=\"speedModeBtn\" class=\"chip-btn\" title=\"تبديل سرعة اللعب\">\n          السرعة: عادي\n        </button>\n        <button type=\"button\" id=\"floatPreviewBtn\" class=\"chip-btn\" title=\"معاينة حجم النافذة العائمة\">\n          معاينة عائمة\n        </button>\n      </div>\n    </section>\n\n    <!-- Game Stage -->\n    <section class=\"stage-wrapper\" id=\"stageWrapper\">\n      <div class=\"floating-sim-banner\">\n        <span>نافذة عائمة مصغرة (276×290)</span>\n        <span>فوق التطبيقات</span>\n      </div>\n\n      <div class=\"game-stage\" id=\"gameStage\">\n        <canvas id=\"gameCanvas\" aria-label=\"ساحة لعب البطل الطائر\"></canvas>\n\n        <button type=\"button\" id=\"pauseBtn\" class=\"stage-pause-btn\" aria-label=\"إيقاف مؤقت\" style=\"display:none;\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n            <rect x=\"6\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\"></rect>\n            <rect x=\"14\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\"></rect>\n          </svg>\n        </button>\n\n        <div id=\"comboBadge\" class=\"stage-combo-badge\">نجمة كوميكس +2</div>\n\n        <!-- Start Overlay -->\n        <div class=\"stage-overlay\" id=\"startOverlay\">\n          <div class=\"comic-modal\">\n            <div class=\"comic-badge\">تحدي الأبطال السريع</div>\n            <h1 class=\"modal-title\">انطلق يا بطل!</h1>\n            <p class=\"modal-desc\">انقر في أي مكان أو اضغط زر الطيران للتحليق بين ناطحات السحاب وجمع نجوم الطاقة.</p>\n            <button type=\"button\" id=\"startGameBtn\" class=\"btn-comic accent\">ابدأ التحليق الآن</button>\n          </div>\n        </div>\n\n        <!-- Pause Overlay -->\n        <div class=\"stage-overlay hidden\" id=\"pauseOverlay\">\n          <div class=\"comic-modal\">\n            <div class=\"comic-badge\">استراحة محارب</div>\n            <h2 class=\"modal-title\">اللعبة متوقفة</h2>\n            <p class=\"modal-desc\">يمكنك متابعة الجولة أو البدء من جديد في أي لحظة.</p>\n            <button type=\"button\" id=\"resumeGameBtn\" class=\"btn-comic accent\">متابعة اللعب</button>\n            <button type=\"button\" id=\"restartFromPauseBtn\" class=\"btn-comic secondary\">إعادة الجولة</button>\n          </div>\n        </div>\n\n        <!-- Game Over Overlay -->\n        <div class=\"stage-overlay hidden\" id=\"gameOverOverlay\">\n          <div class=\"comic-modal\">\n            <div class=\"comic-badge\" id=\"overBadge\">انتهت الجولة!</div>\n            <h2 class=\"modal-title\" id=\"overTitle\">اصطدام بالأبراج</h2>\n            <div class=\"modal-stats\">\n              <div class=\"modal-stat-box\">\n                <span>نتيجتك</span>\n                <strong id=\"finalScoreVal\">0</strong>\n              </div>\n              <div class=\"modal-stat-box\">\n                <span>أعلى نتيجة</span>\n                <strong id=\"finalBestVal\">0</strong>\n              </div>\n            </div>\n            <button type=\"button\" id=\"retryGameBtn\" class=\"btn-comic accent\">العب مجدداً</button>\n            <a href=\"overlay_hub.html\" class=\"btn-comic secondary\">إطلاق كنافذة عائمة فوق التطبيقات</a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Thumb Action Button -->\n    <div class=\"action-row\">\n      <button type=\"button\" id=\"flapThumbBtn\" class=\"flap-thumb-btn\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 19V5\"></path>\n          <polyline points=\"5 12 12 5 19 12\"></polyline>\n        </svg>\n        <span>اضغط للطيران السريع</span>\n      </button>\n    </div>\n\n    <!-- Dynamic Metadata Card loaded from games.json -->\n    <section class=\"info-card\" id=\"gameInfoCard\" aria-live=\"polite\">\n      <img id=\"gameCoverImg\" class=\"info-cover\" alt=\"شعار لعبة البطل الطائر\" src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 80'><rect width='80' height='80' rx='14' fill='%232B2D42'/><polygon points='40,14 66,40 40,66 14,40' fill='%23FFB703'/></svg>\">\n      <div class=\"info-body\">\n        <div class=\"info-top\">\n          <h2 class=\"info-title\" id=\"infoTitle\">البطل الطائر</h2>\n          <span class=\"overlay-tag\" id=\"infoOverlayBadge\">متوافق مع الطبقة العائمة</span>\n        </div>\n        <p class=\"info-desc\" id=\"infoDesc\">جارٍ تحميل تفاصيل اللعبة من بيانات التطبيق...</p>\n      </div>\n    </section>\n  </main>\n\n  <!-- Bottom Navigation -->\n  <nav class=\"bottom-nav\" aria-label=\"التنقل السريع\">\n    <div class=\"bottom-nav-inner\">\n      <a href=\"games.html\" class=\"nav-item\">\n        <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"4\"></rect>\n          <line x1=\"6\" y1=\"12\" x2=\"10\" y2=\"12\"></line>\n          <line x1=\"8\" y1=\"10\" x2=\"8\" y2=\"14\"></line>\n          <circle cx=\"16\" cy=\"10\" r=\"1\" fill=\"currentColor\"></circle>\n          <circle cx=\"18\" cy=\"13\" r=\"1\" fill=\"currentColor\"></circle>\n        </svg>\n        <span>قائمة الألعاب</span>\n      </a>\n\n      <a href=\"overlay_hub.html\" class=\"nav-item overlay-cta\">\n        <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"></rect>\n          <rect x=\"11\" y=\"11\" width=\"8\" height=\"8\" rx=\"2\"></rect>\n          <polyline points=\"8 12 8 8 12 8\"></polyline>\n        </svg>\n        <span>الطبقة العائمة</span>\n      </a>\n    </div>\n  </nav>\n\n  <script>\n    (function () {\n      \"use strict\";\n\n      var BEST_KEY = \"comics_overlay_flappy_best_v1\";\n      var SOUND_KEY = \"comics_overlay_flappy_sound_v1\";\n\n      // DOM elements\n      var canvas = document.getElementById(\"gameCanvas\");\n      var ctx = canvas.getContext(\"2d\");\n      var gameStage = document.getElementById(\"gameStage\");\n      var stageWrapper = document.getElementById(\"stageWrapper\");\n\n      var scoreDisplay = document.getElementById(\"scoreDisplay\");\n      var bestDisplay = document.getElementById(\"bestDisplay\");\n      var finalScoreVal = document.getElementById(\"finalScoreVal\");\n      var finalBestVal = document.getElementById(\"finalBestVal\");\n      var overBadge = document.getElementById(\"overBadge\");\n      var overTitle = document.getElementById(\"overTitle\");\n      var comboBadge = document.getElementById(\"comboBadge\");\n\n      var startOverlay = document.getElementById(\"startOverlay\");\n      var pauseOverlay = document.getElementById(\"pauseOverlay\");\n      var gameOverOverlay = document.getElementById(\"gameOverOverlay\");\n      var pauseBtn = document.getElementById(\"pauseBtn\");\n\n      var startGameBtn = document.getElementById(\"startGameBtn\");\n      var resumeGameBtn = document.getElementById(\"resumeGameBtn\");\n      var restartFromPauseBtn = document.getElementById(\"restartFromPauseBtn\");\n      var retryGameBtn = document.getElementById(\"retryGameBtn\");\n      var flapThumbBtn = document.getElementById(\"flapThumbBtn\");\n      var speedModeBtn = document.getElementById(\"speedModeBtn\");\n      var floatPreviewBtn = document.getElementById(\"floatPreviewBtn\");\n\n      var soundToggleBtn = document.getElementById(\"soundToggleBtn\");\n      var soundOnIcon = document.getElementById(\"soundOnIcon\");\n      var soundOffIcon = document.getElementById(\"soundOffIcon\");\n\n      // Safe localStorage helpers\n      function readStorage(key, fallback) {\n        try {\n          var val = window.localStorage.getItem(key);\n          return val !== null ? val : fallback;\n        } catch (e) {\n          return fallback;\n        }\n      }\n\n      function writeStorage(key, val) {\n        try {\n          window.localStorage.setItem(key, String(val));\n        } catch (e) {\n          // Storage unavailable\n        }\n      }\n\n      // Check URL mode=overlay\n      function checkCompactOverlayMode() {\n        try {\n          var search = window.location.search || \"\";\n          if (search.indexOf(\"mode=overlay\") !== -1 || search.indexOf(\"overlay=1\") !== -1) {\n            document.body.classList.add(\"overlay-compact\");\n            gameStage.style.height = \"280px\";\n          }\n        } catch (e) {\n          // Ignore\n        }\n      }\n      checkCompactOverlayMode();\n\n      // Web Audio API short SFX\n      var soundEnabled = readStorage(SOUND_KEY, \"1\") === \"1\";\n      var audioCtx = null;\n\n      function updateSoundUI() {\n        if (soundEnabled) {\n          soundToggleBtn.classList.add(\"is-active\");\n          soundOnIcon.style.display = \"block\";\n          soundOffIcon.style.display = \"none\";\n        } else {\n          soundToggleBtn.classList.remove(\"is-active\");\n          soundOnIcon.style.display = \"none\";\n          soundOffIcon.style.display = \"block\";\n        }\n      }\n      updateSoundUI();\n\n      function ensureAudio() {\n        if (!soundEnabled) return null;\n        try {\n          if (!audioCtx) {\n            var Ctx = window.AudioContext || window.webkitAudioContext;\n            if (Ctx) {\n              audioCtx = new Ctx();\n            }\n          }\n          if (audioCtx && audioCtx.state === \"suspended\") {\n            audioCtx.resume();\n          }\n          return audioCtx;\n        } catch (e) {\n          return null;\n        }\n      }\n\n      function playSfx(type) {\n        if (!soundEnabled) return;\n        var ac = ensureAudio();\n        if (!ac) return;\n        try {\n          var now = ac.currentTime;\n          var osc = ac.createOscillator();\n          var gain = ac.createGain();\n          osc.connect(gain);\n          gain.connect(ac.destination);\n\n          if (type === \"flap\") {\n            osc.type = \"triangle\";\n            osc.frequency.setValueAtTime(280, now);\n            osc.frequency.exponentialRampToValueAtTime(540, now + 0.08);\n            gain.gain.setValueAtTime(0.12, now);\n            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);\n            osc.start(now);\n            osc.stop(now + 0.09);\n          } else if (type === \"score\") {\n            osc.type = \"sine\";\n            osc.frequency.setValueAtTime(587, now);\n            osc.frequency.setValueAtTime(880, now + 0.06);\n            gain.gain.setValueAtTime(0.13, now);\n            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.16);\n            osc.start(now);\n            osc.stop(now + 0.16);\n          } else if (type === \"star\") {\n            osc.type = \"square\";\n            osc.frequency.setValueAtTime(660, now);\n            osc.frequency.setValueAtTime(990, now + 0.05);\n            osc.frequency.setValueAtTime(1320, now + 0.1);\n            gain.gain.setValueAtTime(0.09, now);\n            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);\n            osc.start(now);\n            osc.stop(now + 0.18);\n          } else if (type === \"hit\") {\n            osc.type = \"sawtooth\";\n            osc.frequency.setValueAtTime(190, now);\n            osc.frequency.exponentialRampToValueAtTime(55, now + 0.22);\n            gain.gain.setValueAtTime(0.16, now);\n            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.24);\n            osc.start(now);\n            osc.stop(now + 0.24);\n          }\n        } catch (e) {\n          // Ignore audio errors\n        }\n      }\n\n      soundToggleBtn.addEventListener(\"click\", function () {\n        soundEnabled = !soundEnabled;\n        writeStorage(SOUND_KEY, soundEnabled ? \"1\" : \"0\");\n        updateSoundUI();\n        if (soundEnabled) {\n          playSfx(\"score\");\n        }\n      });\n\n      // Game State\n      var state = \"ready\"; // ready | playing | paused | gameover\n      var score = 0;\n      var bestScore = parseInt(readStorage(BEST_KEY, \"0\"), 10) || 0;\n      bestDisplay.textContent = String(bestScore);\n\n      var isFastMode = false;\n      var isFloatingPreview = false;\n\n      var width = 340;\n      var height = 360;\n      var dpr = 1;\n\n      // Hero physics\n      var hero = {\n        x: 78,\n        y: 160,\n        vy: 0,\n        radius: 15,\n        rot: 0,\n        capePhase: 0\n      };\n\n      var pipes = [];\n      var stars = [];\n      var particles = [];\n      var popups = [];\n      var bgBuildings = [];\n      var bgStars = [];\n      var pipeTimer = 0;\n      var groundOffset = 0;\n      var comboTimeout = null;\n\n      function initBackground() {\n        bgStars = [];\n        for (var i = 0; i < 24; i++) {\n          bgStars.push({\n            x: Math.random() * width,\n            y: Math.random() * (height * 0.72),\n            r: 1 + Math.random() * 1.8,\n            alpha: 0.3 + Math.random() * 0.6\n          });\n        }\n        bgBuildings = [];\n        var bx = 0;\n        while (bx < width + 80) {\n          var bw = 28 + Math.floor(Math.random() * 26);\n          var bh = 45 + Math.floor(Math.random() * 75);\n          bgBuildings.push({\n            x: bx,\n            w: bw,\n            h: bh,\n            tone: Math.random() > 0.5 ? \"#1B2038\" : \"#232846\"\n          });\n          bx += bw + 4;\n        }\n      }\n\n      function resizeCanvas() {\n        var rect = gameStage.getBoundingClientRect();\n        width = Math.max(220, Math.floor(rect.width));\n        height = Math.max(220, Math.floor(rect.height));\n        dpr = Math.min(window.devicePixelRatio || 1, 2);\n        canvas.width = Math.floor(width * dpr);\n        canvas.height = Math.floor(height * dpr);\n        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n\n        hero.x = Math.floor(width * 0.24);\n        if (state === \"ready\") {\n          hero.y = Math.floor(height * 0.45);\n        }\n        initBackground();\n      }\n\n      resizeCanvas();\n      window.addEventListener(\"resize\", resizeCanvas);\n\n      function showComboBadge(text) {\n        comboBadge.textContent = text;\n        comboBadge.classList.add(\"show\");\n        if (comboTimeout) {\n          clearTimeout(comboTimeout);\n        }\n        comboTimeout = setTimeout(function () {\n          comboBadge.classList.remove(\"show\");\n        }, 950);\n      }\n\n      function addPopup(x, y, text, color) {\n        popups.push({\n          x: x,\n          y: y,\n          text: text,\n          color: color || \"#FFB703\",\n          life: 0.75,\n          maxLife: 0.75\n        });\n      }\n\n      function spawnJetParticles(x, y, count, color) {\n        for (var i = 0; i < count; i++) {\n          particles.push({\n            x: x - 8,\n            y: y + (Math.random() - 0.5) * 10,\n            vx: -60 - Math.random() * 70,\n            vy: (Math.random() - 0.5) * 60,\n            r: 2.5 + Math.random() * 3,\n            color: color,\n            life: 0.35 + Math.random() * 0.2,\n            maxLife: 0.55\n          });\n        }\n      }\n\n      function resetGame() {\n        score = 0;\n        scoreDisplay.textContent = \"0\";\n        hero.x = Math.floor(width * 0.24);\n        hero.y = Math.floor(height * 0.45);\n        hero.vy = 0;\n        hero.rot = 0;\n        pipes = [];\n        stars = [];\n        particles = [];\n        popups = [];\n        pipeTimer = 0.2;\n      }\n\n      function startGame() {\n        resetGame();\n        state = \"playing\";\n        startOverlay.classList.add(\"hidden\");\n        pauseOverlay.classList.add(\"hidden\");\n        gameOverOverlay.classList.add(\"hidden\");\n        pauseBtn.style.display = \"inline-flex\";\n        flap();\n      }\n\n      function pauseGame() {\n        if (state !== \"playing\") return;\n        state = \"paused\";\n        pauseOverlay.classList.remove(\"hidden\");\n      }\n\n      function resumeGame() {\n        if (state !== \"paused\") return;\n        state = \"playing\";\n        pauseOverlay.classList.add(\"hidden\");\n        lastTime = performance.now();\n      }\n\n      function triggerGameOver() {\n        if (state === \"gameover\") return;\n        state = \"gameover\";\n        pauseBtn.style.display = \"none\";\n        playSfx(\"hit\");\n        spawnJetParticles(hero.x, hero.y, 16, \"#D90429\");\n\n        var isNewRecord = false;\n        if (score > bestScore) {\n          bestScore = score;\n          writeStorage(BEST_KEY, bestScore);\n          bestDisplay.textContent = String(bestScore);\n          isNewRecord = true;\n        }\n\n        finalScoreVal.textContent = String(score);\n        finalBestVal.textContent = String(bestScore);\n\n        if (isNewRecord && score > 0) {\n          overBadge.textContent = \"رقم قياسي جديد!\";\n          overBadge.classList.add(\"record\");\n          overTitle.textContent = \"أداء أسطوري!\";\n        } else {\n          overBadge.textContent = \"انتهت الجولة!\";\n          overBadge.classList.remove(\"record\");\n          overTitle.textContent = score >= 10 ? \"تحليق رائع!\" : \"اصطدام بالأبراج\";\n        }\n\n        gameOverOverlay.classList.remove(\"hidden\");\n      }\n\n      function flap() {\n        if (state === \"ready\") {\n          startGame();\n          return;\n        }\n        if (state !== \"playing\") return;\n\n        var jumpImpulse = isFastMode ? -315 : -285;\n        hero.vy = jumpImpulse;\n        hero.rot = -0.42;\n        playSfx(\"flap\");\n        spawnJetParticles(hero.x, hero.y + 4, 6, \"#FFB703\");\n      }\n\n      function spawnPipe() {\n        var groundH = 26;\n        var playH = height - groundH;\n        var baseGap = isFastMode ? 108 : 122;\n        var minGap = height < 310 ? 96 : 102;\n        var gap = Math.max(minGap, baseGap - Math.min(20, score * 0.6));\n        var margin = 38;\n        var maxTop = Math.max(margin + 10, playH - gap - margin);\n        var topH = margin + Math.random() * (maxTop - margin);\n        var pipeW = width < 300 ? 46 : 52;\n\n        pipes.push({\n          x: width + 16,\n          w: pipeW,\n          topH: topH,\n          gap: gap,\n          passed: false\n        });\n\n        // 60% chance to spawn a collectible comic energy star inside or near gap\n        if (Math.random() < 0.65) {\n          stars.push({\n            x: width + 16 + pipeW / 2,\n            y: topH + gap * (0.35 + Math.random() * 0.3),\n            r: 10,\n            collected: false,\n            spin: 0\n          });\n        }\n      }\n\n      function update(dt) {\n        var groundH = 26;\n        var floorY = height - groundH;\n\n        // Parallax ground\n        var baseSpeed = (isFastMode ? 175 : 140) + Math.min(65, score * 1.8);\n        if (state === \"ready\") {\n          groundOffset = (groundOffset + 60 * dt) % 32;\n          hero.capePhase += dt * 8;\n          hero.y = height * 0.45 + Math.sin(performance.now() * 0.004) * 7;\n          return;\n        }\n\n        if (state !== \"playing\") return;\n\n        groundOffset = (groundOffset + baseSpeed * dt) % 32;\n        hero.capePhase += dt * 14;\n\n        // Gravity & Hero velocity\n        var gravity = isFastMode ? 880 : 760;\n        hero.vy += gravity * dt;\n        if (hero.vy > 460) hero.vy = 460;\n        hero.y += hero.vy * dt;\n\n        // Smooth tilt rotation\n        var targetRot = Math.min(1.1, Math.max(-0.45, hero.vy / 340));\n        hero.rot += (targetRot - hero.rot) * Math.min(1, dt * 10);\n\n        // Ceiling & floor check\n        if (hero.y - hero.radius < 2) {\n          hero.y = hero.radius + 2;\n          hero.vy = 0;\n        }\n        if (hero.y + hero.radius >= floorY) {\n          hero.y = floorY - hero.radius;\n          triggerGameOver();\n          return;\n        }\n\n        // Spawn pipes\n        pipeTimer -= dt;\n        if (pipeTimer <= 0) {\n          spawnPipe();\n          pipeTimer = isFastMode ? 1.32 : 1.56;\n        }\n\n        // Move & collide pipes\n        for (var i = pipes.length - 1; i >= 0; i--) {\n          var p = pipes[i];\n          p.x -= baseSpeed * dt;\n\n          // Score check\n          if (!p.passed && p.x + p.w < hero.x) {\n            p.passed = true;\n            score += 1;\n            scoreDisplay.textContent = String(score);\n            playSfx(\"score\");\n            addPopup(hero.x, hero.y - 24, \"+1\", \"#FFFFFF\");\n          }\n\n          // Circle-rect collision (slightly forgiving hitbox)\n          var hitR = hero.radius - 3;\n          if (hero.x + hitR > p.x && hero.x - hitR < p.x + p.w) {\n            if (hero.y - hitR < p.topH || hero.y + hitR > p.topH + p.gap) {\n              triggerGameOver();\n              return;\n            }\n          }\n\n          if (p.x + p.w < -20) {\n            pipes.splice(i, 1);\n          }\n        }\n\n        // Stars\n        for (var s = stars.length - 1; s >= 0; s--) {\n          var st = stars[s];\n          st.x -= baseSpeed * dt;\n          st.spin += dt * 4;\n\n          if (!st.collected) {\n            var dx = hero.x - st.x;\n            var dy = hero.y - st.y;\n            if (dx * dx + dy * dy <= (hero.radius + st.r) * (hero.radius + st.r)) {\n              st.collected = true;\n              score += 2;\n              scoreDisplay.textContent = String(score);\n              playSfx(\"star\");\n              spawnJetParticles(st.x, st.y, 10, \"#FFB703\");\n              addPopup(st.x, st.y - 14, \"+2 طاقة!\", \"#FFB703\");\n              showComboBadge(\"نجمة كوميكس +2\");\n            }\n          }\n\n          if (st.collected || st.x < -30) {\n            stars.splice(s, 1);\n          }\n        }\n\n        // Particles\n        for (var k = particles.length - 1; k >= 0; k--) {\n          var pt = particles[k];\n          pt.x += pt.vx * dt;\n          pt.y += pt.vy * dt;\n          pt.life -= dt;\n          if (pt.life <= 0) {\n            particles.splice(k, 1);\n          }\n        }\n\n        // Popups\n        for (var m = popups.length - 1; m >= 0; m--) {\n          var pop = popups[m];\n          pop.y -= 36 * dt;\n          pop.life -= dt;\n          if (pop.life <= 0) {\n            popups.splice(m, 1);\n          }\n        }\n      }\n\n      function drawComicStar(cx, cy, outerR, innerR, points, rot) {\n        ctx.beginPath();\n        for (var i = 0; i < points * 2; i++) {\n          var r = i % 2 === 0 ? outerR : innerR;\n          var angle = rot + (i * Math.PI) / points;\n          var px = cx + Math.cos(angle) * r;\n          var py = cy + Math.sin(angle) * r;\n          if (i === 0) ctx.moveTo(px, py);\n          else ctx.lineTo(px, py);\n        }\n        ctx.closePath();\n      }\n\n      function draw() {\n        var groundH = 26;\n        var floorY = height - groundH;\n\n        // Sky gradient\n        var grad = ctx.createLinearGradient(0, 0, 0, height);\n        grad.addColorStop(0, \"#0F172A\");\n        grad.addColorStop(0.65, \"#1E1B4B\");\n        grad.addColorStop(1, \"#31102F\");\n        ctx.fillStyle = grad;\n        ctx.fillRect(0, 0, width, height);\n\n        // Background stars\n        for (var i = 0; i < bgStars.length; i++) {\n          var bs = bgStars[i];\n          ctx.fillStyle = \"rgba(255, 255, 255, \" + bs.alpha + \")\";\n          ctx.beginPath();\n          ctx.arc(bs.x, bs.y, bs.r, 0, Math.PI * 2);\n          ctx.fill();\n        }\n\n        // Comic Moon / Emblem\n        ctx.fillStyle = \"rgba(255, 183, 3, 0.16)\";\n        ctx.beginPath();\n        ctx.arc(width * 0.8, height * 0.2, 34, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.fillStyle = \"rgba(255, 183, 3, 0.35)\";\n        ctx.beginPath();\n        ctx.arc(width * 0.8, height * 0.2, 22, 0, Math.PI * 2);\n        ctx.fill();\n\n        // City skyline silhouette\n        for (var b = 0; b < bgBuildings.length; b++) {\n          var bld = bgBuildings[b];\n          ctx.fillStyle = bld.tone;\n          ctx.fillRect(bld.x, floorY - bld.h, bld.w, bld.h);\n          ctx.fillStyle = \"rgba(255, 183, 3, 0.18)\";\n          for (var wy = floorY - bld.h + 8; wy < floorY - 10; wy += 12) {\n            ctx.fillRect(bld.x + 6, wy, 4, 5);\n            if (bld.w > 34) {\n              ctx.fillRect(bld.x + bld.w - 11, wy, 4, 5);\n            }\n          }\n        }\n\n        // Pipes (Comic Neon Towers)\n        for (var pIdx = 0; pIdx < pipes.length; pIdx++) {\n          var p = pipes[pIdx];\n          var bottomY = p.topH + p.gap;\n          var bottomH = floorY - bottomY;\n\n          // Top tower body\n          ctx.fillStyle = \"#2B2D42\";\n          ctx.strokeStyle = \"#0B0C14\";\n          ctx.lineWidth = 3;\n          ctx.fillRect(p.x, -2, p.w, p.topH + 2);\n          ctx.strokeRect(p.x, -2, p.w, p.topH + 2);\n\n          // Top tower highlight strip\n          ctx.fillStyle = \"#3F4263\";\n          ctx.fillRect(p.x + 5, 0, 8, Math.max(0, p.topH - 14));\n\n          // Top cap\n          ctx.fillStyle = \"#D90429\";\n          ctx.fillRect(p.x - 4, p.topH - 14, p.w + 8, 14);\n          ctx.strokeRect(p.x - 4, p.topH - 14, p.w + 8, 14);\n\n          // Bottom tower body\n          ctx.fillStyle = \"#2B2D42\";\n          ctx.fillRect(p.x, bottomY, p.w, bottomH);\n          ctx.strokeRect(p.x, bottomY, p.w, bottomH);\n\n          ctx.fillStyle = \"#3F4263\";\n          ctx.fillRect(p.x + 5, bottomY + 14, 8, Math.max(0, bottomH - 14));\n\n          // Bottom cap\n          ctx.fillStyle = \"#D90429\";\n          ctx.fillRect(p.x - 4, bottomY, p.w + 8, 14);\n          ctx.strokeRect(p.x - 4, bottomY, p.w + 8, 14);\n\n          // Warning accent line on caps\n          ctx.fillStyle = \"#FFB703\";\n          ctx.fillRect(p.x - 1, p.topH - 5, p.w + 2, 2.5);\n          ctx.fillRect(p.x - 1, bottomY + 3, p.w + 2, 2.5);\n        }\n\n        // Collectible Comic Stars\n        for (var s = 0; s < stars.length; s++) {\n          var st = stars[s];\n          ctx.save();\n          ctx.fillStyle = \"#FFB703\";\n          ctx.strokeStyle = \"#0B0C14\";\n          ctx.lineWidth = 2.5;\n          drawComicStar(st.x, st.y, st.r, st.r * 0.48, 5, st.spin);\n          ctx.fill();\n          ctx.stroke();\n          ctx.restore();\n        }\n\n        // Particles\n        for (var k = 0; k < particles.length; k++) {\n          var pt = particles[k];\n          ctx.globalAlpha = Math.max(0, pt.life / pt.maxLife);\n          ctx.fillStyle = pt.color;\n          ctx.beginPath();\n          ctx.arc(pt.x, pt.y, pt.r, 0, Math.PI * 2);\n          ctx.fill();\n        }\n        ctx.globalAlpha = 1;\n\n        // Ground Strip\n        ctx.fillStyle = \"#FFB703\";\n        ctx.fillRect(0, floorY, width, groundH);\n        ctx.fillStyle = \"#0B0C14\";\n        ctx.fillRect(0, floorY, width, 3);\n        ctx.fillStyle = \"#FB8500\";\n        for (var gx = -groundOffset; gx < width + 32; gx += 32) {\n          ctx.beginPath();\n          ctx.moveTo(gx, floorY + 3);\n          ctx.lineTo(gx + 16, floorY + 3);\n          ctx.lineTo(gx + 6, height);\n          ctx.lineTo(gx - 10, height);\n          ctx.closePath();\n          ctx.fill();\n        }\n\n        // Flying Hero Character\n        ctx.save();\n        ctx.translate(hero.x, hero.y);\n        ctx.rotate(hero.rot);\n\n        // Fluttering comic cape\n        var capeWave = Math.sin(hero.capePhase) * 4;\n        ctx.fillStyle = \"#D90429\";\n        ctx.strokeStyle = \"#0B0C14\";\n        ctx.lineWidth = 2.5;\n        ctx.beginPath();\n        ctx.moveTo(-4, -2);\n        ctx.quadraticCurveTo(-18, -8 + capeWave, -24, 6 + capeWave);\n        ctx.lineTo(-10, 10);\n        ctx.closePath();\n        ctx.fill();\n        ctx.stroke();\n\n        // Hero suit body\n        ctx.fillStyle = \"#FFB703\";\n        ctx.beginPath();\n        ctx.arc(0, 0, hero.radius, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.stroke();\n\n        // Hero chest emblem\n        ctx.fillStyle = \"#D90429\";\n        ctx.beginPath();\n        ctx.moveTo(-2, -6);\n        ctx.lineTo(5, -6);\n        ctx.lineTo(1, 0);\n        ctx.lineTo(6, 0);\n        ctx.lineTo(-3, 8);\n        ctx.lineTo(0, 2);\n        ctx.lineTo(-4, 2);\n        ctx.closePath();\n        ctx.fill();\n\n        // Hero mask & glowing visor\n        ctx.fillStyle = \"#2B2D42\";\n        ctx.beginPath();\n        ctx.roundRect ? ctx.roundRect(1, -9, 13, 8, 4) : ctx.rect(1, -9, 13, 8);\n        ctx.fill();\n        ctx.stroke();\n\n        ctx.fillStyle = \"#38BDF8\";\n        ctx.beginPath();\n        ctx.arc(8, -5, 2.7, 0, Math.PI * 2);\n        ctx.fill();\n\n        ctx.restore();\n\n        // Score Popups\n        for (var m = 0; m < popups.length; m++) {\n          var pop = popups[m];\n          ctx.save();\n          ctx.globalAlpha = Math.max(0, pop.life / pop.maxLife);\n          ctx.font = \"900 14px system-ui, Tahoma, Arial\";\n          ctx.textAlign = \"center\";\n          ctx.lineWidth = 3.5;\n          ctx.strokeStyle = \"#0B0C14\";\n          ctx.strokeText(pop.text, pop.x, pop.y);\n          ctx.fillStyle = pop.color;\n          ctx.fillText(pop.text, pop.x, pop.y);\n          ctx.restore();\n        }\n      }\n\n      var lastTime = performance.now();\n      function loop(now) {\n        var dt = (now - lastTime) / 1000;\n        lastTime = now;\n        if (dt > 0.05) dt = 0.05;\n        update(dt);\n        draw();\n        requestAnimationFrame(loop);\n      }\n      requestAnimationFrame(loop);\n\n      // Input Handlers\n      function handleCanvasPress(e) {\n        if (e && e.target === pauseBtn) return;\n        if (state === \"playing\") {\n          if (e && e.cancelable) e.preventDefault();\n          flap();\n        }\n      }\n\n      canvas.addEventListener(\"pointerdown\", handleCanvasPress);\n      flapThumbBtn.addEventListener(\"pointerdown\", function (e) {\n        if (e && e.cancelable) e.preventDefault();\n        if (state === \"gameover\") {\n          startGame();\n        } else if (state === \"paused\") {\n          resumeGame();\n        } else {\n          flap();\n        }\n      });\n\n","at":1795369614129}