{"job":"jmwrvmvwyh5mc","file":"settings.html","text":"<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>الإعدادات - مكتبة الألعاب المتواضعة</title>\n<style>\n:root{\n  --primary:#6200EE;\n  --primary-dark:#3700B3;\n  --accent:#03DAC6;\n  --highlight:#FF0266;\n  --control:#B0BEC5;\n  --bg:#121212;\n  --surface:#1E1E1E;\n  --surface-card:#2A2A2A;\n  --text:#FFFFFF;\n  --text-secondary:#B3B3B3;\n  --border:#333333;\n}\n\nbody.light-theme {\n  --bg:#F5F5F5;\n  --surface:#FFFFFF;\n  --surface-card:#EFEFEF;\n  --text:#121212;\n  --text-secondary:#666666;\n  --border:#DDDDDD;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n  font-family: Tahoma, Arial, sans-serif;\n  -webkit-tap-highlight-color: transparent;\n}\n\nbody {\n  background-color: var(--bg);\n  color: var(--text);\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n  padding-bottom: 70px;\n}\n\nheader {\n  background-color: var(--surface);\n  border-bottom: 1px solid var(--border);\n  padding: 16px;\n  text-align: center;\n  position: sticky;\n  top: 0;\n  z-index: 10;\n}\n\nheader h1 {\n  font-size: 1.2rem;\n  color: var(--text);\n}\n\n.container {\n  padding: 16px;\n  max-width: 600px;\n  margin: 0 auto;\n  width: 100%;\n}\n\n.section-title {\n  font-size: 1rem;\n  color: var(--text-secondary);\n  margin-bottom: 12px;\n  margin-top: 16px;\n  text-transform: uppercase;\n}\n\n.card {\n  background-color: var(--surface);\n  border-radius: 8px;\n  border: 1px solid var(--border);\n  margin-bottom: 12px;\n  overflow: hidden;\n}\n\n.setting-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 16px;\n  border-bottom: 1px solid var(--border);\n}\n\n.setting-item:last-child {\n  border-bottom: none;\n}\n\n.setting-info {\n  display: flex;\n  align-items: center;\n}\n\n.setting-icon {\n  width: 24px;\n  height: 24px;\n  margin-left: 12px;\n  fill: var(--accent);\n}\n\n.setting-text h3 {\n  font-size: 0.95rem;\n  color: var(--text);\n  margin-bottom: 2px;\n}\n\n.setting-text p {\n  font-size: 0.8rem;\n  color: var(--text-secondary);\n}\n\n/* Switch UI */\n.switch {\n  position: relative;\n  display: inline-block;\n  width: 50px;\n  height: 26px;\n}\n\n.switch input {\n  opacity: 0;\n  width: 0;\n  height: 0;\n}\n\n.slider {\n  position: absolute;\n  cursor: pointer;\n  top: 0; left: 0; right: 0; bottom: 0;\n  background-color: var(--control);\n  transition: .3s;\n  border-radius: 26px;\n}\n\n.slider:before {\n  position: absolute;\n  content: \"\";\n  height: 20px;\n  width: 20px;\n  left: 3px;\n  bottom: 3px;\n  background-color: white;\n  transition: .3s;\n  border-radius: 50%;\n}\n\ninput:checked + .slider {\n  background-color: var(--primary);\n}\n\ninput:checked + .slider:before {\n  transform: translateX(-24px);\n}\n\n.btn-action {\n  background: none;\n  border: 1px solid var(--border);\n  color: var(--text);\n  padding: 8px 16px;\n  border-radius: 6px;\n  font-size: 0.85rem;\n  cursor: pointer;\n  min-height: 44px;\n  min-width: 44px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.btn-action:active {\n  background-color: var(--border);\n}\n\n.btn-danger {\n  color: var(--highlight);\n  border-color: var(--highlight);\n}\n\n.app-version {\n  text-align: center;\n  color: var(--text-secondary);\n  font-size: 0.8rem;\n  margin-top: 24px;\n}\n\n/* Navigation bar */\nnav {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background-color: var(--surface);\n  border-top: 1px solid var(--border);\n  display: flex;\n  justify-content: space-around;\n  padding: 8px 0;\n  z-index: 100;\n}\n\nnav a {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-decoration: none;\n  color: var(--text-secondary);\n  font-size: 0.75rem;\n  width: 25%;\n  min-height: 44px;\n  justify-content: center;\n}\n\nnav a.active {\n  color: var(--accent);\n}\n\nnav a svg {\n  width: 22px;\n  height: 22px;\n  margin-bottom: 4px;\n  fill: currentColor;\n}\n</style>\n</head>\n<body>\n\n<header>\n  <h1>إعدادات التطبيق</h1>\n</header>\n\n<div class=\"container\">\n  \n  <div class=\"section-title\">التفضيلات العامة</div>\n  <div class=\"card\">\n    <div class=\"setting-item\">\n      <div class=\"setting-info\">\n        <svg class=\"setting-icon\" viewBox=\"0 0 24 24\"><path d=\"M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-3.03 0-5.5-2.47-5.5-5.5 0-1.82.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z\"/></svg>\n        <div class=\"setting-text\">\n          <h3>المظهر الفاتح</h3>\n          <p>تفعيل الألوان الفاتحة للواجهة</p>\n        </div>\n      </div>\n      <label class=\"switch\">\n        <input type=\"checkbox\" id=\"themeSwitch\">\n        <span class=\"slider\"></span>\n      </label>\n    </div>\n\n    <div class=\"setting-item\">\n      <div class=\"setting-info\">\n        <svg class=\"setting-icon\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 16h-2v-2h2v2zm1.07-7.75l-.9.92C12.45 11.9 12 12.5 12 14h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.03-.42 1.98-1.07 2.75z\"/></svg>\n        <div class=\"setting-text\">\n          <h3>المؤثرات الصوتية</h3>\n          <p>تشغيل الأصوات عند النقر</p>\n        </div>\n      </div>\n      <label class=\"switch\">\n        <input type=\"checkbox\" id=\"soundSwitch\" checked>\n        <span class=\"slider\"></span>\n      </label>\n    </div>\n  </div>\n\n  <div class=\"section-title\">التخزين والبيانات</div>\n  <div class=\"card\">\n    <div class=\"setting-item\">\n      <div class=\"setting-info\">\n        <svg class=\"setting-icon\" viewBox=\"0 0 24 24\"><path d=\"M19 4h-3.5l-1-1h-5l-1 1H5v2h14M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12z\"/></svg>\n        <div class=\"setting-text\">\n          <h3>مسح بيانات التخزين المؤقت</h3>\n          <p>إزالة الألعاب المحفوظة مؤقتاً وبيانات التصفح</p>\n        </div>\n      </div>\n      <button class=\"btn-action btn-danger\" id=\"clearCacheBtn\">مسح</button>\n    </div>\n  </div>\n\n  <div class=\"section-title\">حول التطبيق</div>\n","at":1795354540740}