cles[i];\n      ctx.shadowBlur = 10;\n      ctx.shadowColor = obs.color;\n      ctx.fillStyle = obs.color;\n\n      if (obs.type === 'barrier') {\n        ctx.fillRect(obs.x, obs.y, obs.w, obs.h);\n        ctx.strokeStyle = '#FFFFFF';\n        ctx.strokeRect(obs.x + 2, obs.y + 2, obs.w - 4, obs.h - 4);\n      } else if (obs.type === 'laser') {\n        ctx.fillRect(obs.x, obs.y, obs.w, 12);\n        ctx.fillStyle = 'rgba(0, 229, 255, 0.3)';\n        ctx.fillRect(obs.x + 4, obs.y + 12, obs.w - 8, obs.h - 12);\n      } else if (obs.type === 'drone') {\n        ctx.beginPath();\n        ctx.moveTo(obs.x + obs.w / 2, obs.y);\n        ctx.lineTo(obs.x + obs.w, obs.y + obs.h / 2);\n        ctx.lineTo(obs.x + obs.w / 2, obs.y + obs.h);\n        ctx.lineTo(obs.x, obs.y + obs.h / 2);\n        ctx.closePath();\n        ctx.fill();\n      }\n      ctx.shadowBlur = 0;\n    }\n\n    for (var j = 0; j < gems.length; j++) {\n      var g = gems[j];\n      if (!g.collected) {\n        ctx.shadowBlur = 15;\n        ctx.shadowColor = '#FFD60A';\n        ctx.fillStyle = '#FFD60A';\n        ctx.beginPath();\n        ctx.arc(g.x, g.y, g.r, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.shadowBlur = 0;\n      }\n    }\n\n    for (var k = 0; k < particles.length; k++) {\n      var p = particles[k];\n      ctx.fillStyle = p.color;\n      ctx.fillRect(p.x, p.y, 4, 4);\n    }\n\n    ctx.shadowBlur = 15;\n    ctx.shadowColor = '#00E5FF';\n\n    var rx = runner.x;\n    var ry = runner.y;\n    var rw = runner.width;\n    var rh = runner.isSliding ? runner.slideHeight : runner.normalHeight;\n\n    if (runner.isSliding) {\n      ctx.fillStyle = '#00E5FF';\n      ctx.fillRect(rx, ry, rw + 10, rh);\n      ctx.fillStyle = '#FF3D7F';\n      ctx.fillRect(rx + rw, ry + 4, 8, 8);\n    } else {\n","at":1795413881143}