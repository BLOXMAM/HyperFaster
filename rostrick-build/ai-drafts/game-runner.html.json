{"job":"jmwsqrwc5vubm","file":"game-runner.html","text":"<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\">\n<title>عداء السايبر</title>\n<style>\n:root {\n  --primary: #6C3BFF;\n  --primary-dark: #4A22C9;\n  --accent: #00E5FF;\n  --highlight: #FF3D7F;\n  --control: #B8B5D1;\n  --bg-dark: #0A0915;\n  --bg-card: #15132A;\n  --bg-card-border: #2A2650;\n  --text-main: #FFFFFF;\n  --text-sub: #9E9BB8;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n  -webkit-tap-highlight-color: transparent;\n  user-select: none;\n  -webkit-user-select: none;\n}\n\nbody {\n  background-color: var(--bg-dark);\n  color: var(--text-main);\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  padding-top: var(--rt-statusbar-height, 0px);\n}\n\n/* App Bar */\n.app-header {\n  height: 56px;\n  background: rgba(21, 19, 42, 0.95);\n  border-bottom: 1px solid var(--bg-card-border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 12px;\n  position: relative;\n  z-index: 20;\n  box-shadow: 0 4px 20px rgba(108, 59, 255, 0.2);\n}\n\n.header-title-box {\n  display: flex;\n  align-items: center;\n}\n\n.header-title-box .app-title {\n  font-size: 1.1rem;\n  font-weight: 800;\n  color: #fff;\n  letter-spacing: 0.5px;\n  text-shadow: 0 0 10px rgba(0, 229, 255, 0.5);\n  margin-right: 8px;\n}\n\n.badge-neon {\n  background: rgba(255, 61, 127, 0.2);\n  color: var(--highlight);\n  border: 1px solid var(--highlight);\n  font-size: 0.65rem;\n  font-weight: bold;\n  padding: 2px 6px;\n  border-radius: 4px;\n  margin-right: 6px;\n  text-shadow: 0 0 6px var(--highlight);\n}\n\n.btn-icon {\n  width: 44px;\n  height: 44px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: transparent;\n  border: none;\n  color: var(--control);\n  border-radius: 10px;\n  cursor: pointer;\n  transition: background 0.2s, color 0.2s;\n  text-decoration: none;\n}\n\n.btn-icon:active {\n  background: rgba(108, 59, 255, 0.25);\n  color: var(--accent);\n}\n\n.header-actions {\n  display: flex;\n  align-items: center;\n}\n\n/* Main Container */\n.game-container {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  position: relative;\n  background: radial-gradient(circle at center, #181436 0%, #0a0915 100%);\n}\n\n/* Score Bar */\n.hud-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 10px 16px;\n  background: rgba(15, 13, 30, 0.8);\n  border-bottom: 1px solid rgba(108, 59, 255, 0.3);\n}\n\n.hud-item {\n  display: flex;\n  flex-direction: column;\n}\n\n.hud-label {\n  font-size: 0.7rem;\n  color: var(--text-sub);\n  margin-bottom: 2px;\n}\n\n.hud-val {\n  font-size: 1.2rem;\n  font-weight: 800;\n  font-family: monospace, monospace;\n}\n\n.val-score {\n  color: var(--accent);\n  text-shadow: 0 0 8px rgba(0, 229, 255, 0.6);\n}\n\n.val-high {\n  color: var(--highlight);\n  text-shadow: 0 0 8px rgba(255, 61, 127, 0.6);\n}\n\n.val-speed {\n  color: #FFD60A;\n}\n\n/* Canvas Viewport */\n.canvas-wrapper {\n  flex: 1;\n  position: relative;\n  width: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n}\n\ncanvas {\n  width: 100%;\n  height: 100%;\n  display: block;\n  background: transparent;\n}\n\n/* Game Controls Area */\n.touch-controls {\n  padding: 12px 16px;\n  padding-bottom: 12px;\n  padding-bottom: calc(12px + env(safe-area-inset-bottom));\n  background: rgba(15, 13, 30, 0.95);\n  border-top: 1px solid var(--bg-card-border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.btn-ctrl {\n  flex: 1;\n  height: 64px;\n  border-radius: 14px;\n  border: 2px solid;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  font-weight: bold;\n  font-size: 1.1rem;\n  cursor: pointer;\n  transition: transform 0.1s, box-shadow 0.1s;\n  touch-action: manipulation;\n}\n\n.btn-jump {\n  background: linear-gradient(135deg, rgba(0, 229, 255, 0.2), rgba(108, 59, 255, 0.4));\n  border-color: var(--accent);\n  color: #fff;\n  margin-left: 8px;\n  box-shadow: 0 0 15px rgba(0, 229, 255, 0.3);\n}\n\n.btn-jump:active {\n  transform: scale(0.96);\n  background: linear-gradient(135deg, rgba(0, 229, 255, 0.4), rgba(108, 59, 255, 0.7));\n  box-shadow: 0 0 25px rgba(0, 229, 255, 0.6);\n}\n\n.btn-slide {\n  background: linear-gradient(135deg, rgba(255, 61, 127, 0.2), rgba(74, 34, 201, 0.4));\n  border-color: var(--highlight);\n  color: #fff;\n  margin-right: 8px;\n  box-shadow: 0 0 15px rgba(255, 61, 127, 0.3);\n}\n\n.btn-slide:active {\n  transform: scale(0.96);\n  background: linear-gradient(135deg, rgba(255, 61, 127, 0.4), rgba(74, 34, 201, 0.7));\n  box-shadow: 0 0 25px rgba(255, 61, 127, 0.6);\n}\n\n.ctrl-sub {\n  font-size: 0.7rem;\n  opacity: 0.8;\n  font-weight: normal;\n  margin-top: 2px;\n}\n\n/* Modals & Overlays */\n.overlay-screen {\n  position: absolute;\n  top: 0; left: 0; right: 0; bottom: 0;\n  background: rgba(10, 9, 21, 0.88);\n  backdrop-filter: blur(8px);\n  -webkit-backdrop-filter: blur(8px);\n  z-index: 50;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 24px;\n  text-align: center;\n  transition: opacity 0.3s;\n}\n\n.overlay-screen.hidden {\n  display: none !important;\n}\n\n.card-modal {\n  width: 100%;\n  max-width: 360px;\n  background: var(--bg-card);\n  border: 1px solid var(--primary);\n  border-radius: 20px;\n  padding: 24px;\n  box-shadow: 0 0 30px rgba(108, 59, 255, 0.4);\n}\n\n.modal-icon {\n  width: 64px;\n  height: 64px;\n  margin: 0 auto 16px auto;\n  border-radius: 50%;\n  background: rgba(108, 59, 255, 0.2);\n  border: 2px solid var(--accent);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--accent);\n  box-shadow: 0 0 15px rgba(0, 229, 255, 0.4);\n}\n\n.modal-title {\n  font-size: 1.4rem;\n  font-weight: 800;\n  color: #fff;\n  margin-bottom: 8px;\n}\n\n.modal-desc {\n  font-size: 0.9rem;\n  color: var(--text-sub);\n  line-height: 1.5;\n  margin-bottom: 20px;\n}\n\n.btn-primary-action {\n  width: 100%;\n  height: 50px;\n  background: linear-gradient(90deg, var(--primary), var(--primary-dark));\n  border: 1px solid var(--accent);\n  color: #fff;\n  font-weight: bold;\n  font-size: 1.05rem;\n  border-radius: 12px;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 4px 15px rgba(108, 59, 255, 0.5);\n  margin-bottom: 12px;\n}\n\n.btn-primary-action:active {\n  transform: translateY(2px);\n  box-shadow: 0 2px 8px rgba(108, 59, 255, 0.5);\n}\n\n.btn-secondary-action {\n  width: 100%;\n  height: 44px;\n  background: rgba(255, 255, 255, 0.06);\n  border: 1px solid rgba(255, 255, 255, 0.15);\n  color: #fff;\n  font-size: 0.95rem;\n  font-weight: 600;\n  border-radius: 12px;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 10px;\n}\n\n.btn-secondary-action:active {\n  background: rgba(255, 255, 255, 0.12);\n}\n\n.btn-icon-label {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.btn-icon-label svg {\n  margin-left: 8px;\n}\n\n.score-summary {\n  background: rgba(10, 9, 21, 0.6);\n  border-radius: 12px;\n  padding: 12px;\n  margin-bottom: 20px;\n  border: 1px solid rgba(108, 59, 255, 0.3);\n  display: flex;\n  justify-content: space-around;\n}\n\n.stat-box {\n  display: flex;\n  flex-direction: column;\n}\n\n.stat-label {\n  font-size: 0.75rem;\n  color: var(--text-sub);\n}\n\n.stat-val {\n  font-size: 1.3rem;\n  font-weight: 800;\n}\n\n.stat-score { color: var(--accent); }\n.stat-high { color: var(--highlight); }\n\n.quick-nav {\n  display: flex;\n  justify-content: center;\n  margin-top: 10px;\n}\n\n.quick-nav-link {\n  color: var(--control);\n  font-size: 0.85rem;\n  text-decoration: none;\n  margin: 0 10px;\n  display: flex;\n  align-items: center;\n}\n\n.quick-nav-link:active {\n  color: var(--accent);\n}\n\n.toast {\n  position: absolute;\n  bottom: 80px;\n  left: 50%;\n  transform: translateX(-50%);\n  background: rgba(108, 59, 255, 0.95);\n  color: #fff;\n  padding: 8px 18px;\n  border-radius: 20px;\n  font-size: 0.85rem;\n  box-shadow: 0 4px 15px rgba(0,0,0,0.5);\n  z-index: 100;\n  opacity: 0;\n  transition: opacity 0.3s;\n  pointer-events: none;\n  white-space: nowrap;\n}\n.toast.show {\n  opacity: 1;\n}\n</style>\n</head>\n<body>\n\n  <!-- App Header -->\n  <header class=\"app-header\">\n    <div style=\"display: flex; align-items: center;\">\n      <a href=\"games.html\" id=\"btn-back\" class=\"btn-icon\" aria-label=\"الرجوع للألعاب\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line>\n          <polyline points=\"12 19 5 12 12 5\"></polyline>\n        </svg>\n      </a>\n      <div class=\"header-title-box\">\n        <span class=\"app-title\">عداء السايبر</span>\n        <span class=\"badge-neon\">أركيد</span>\n      </div>\n    </div>\n\n    <div class=\"header-actions\">\n      <button id=\"btn-overlay\" class=\"btn-icon\" aria-label=\"تشغيل كـ Overlay\" title=\"تشغيل كـ Overlay\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect>\n          <rect x=\"9\" y=\"9\" width=\"10\" height=\"10\" rx=\"1\" ry=\"1\"></rect>\n        </svg>\n      </button>\n\n      <button id=\"btn-sound\" class=\"btn-icon\" aria-label=\"الصوت\" title=\"تشغيل / كتم الصوت\">\n        <svg id=\"sound-icon-on\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon>\n          <path d=\"M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07\"></path>\n        </svg>\n        <svg id=\"sound-icon-off\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"display:none;\">\n          <polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon>\n          <line x1=\"23\" y1=\"9\" x2=\"17\" y2=\"15\"></line>\n          <line x1=\"17\" y1=\"9\" x2=\"23\" y2=\"15\"></line>\n        </svg>\n      </button>\n\n      <button id=\"btn-share\" class=\"btn-icon\" aria-label=\"مشاركة\" title=\"مشاركة النتيجة\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"18\" cy=\"5\" r=\"3\"></circle>\n          <circle cx=\"6\" cy=\"12\" r=\"3\"></circle>\n          <circle cx=\"18\" cy=\"19\" r=\"3\"></circle>\n          <line x1=\"8.59\" y1=\"13.51\" x2=\"15.42\" y2=\"17.49\"></line>\n          <line x1=\"15.41\" y1=\"6.51\" x2=\"8.59\" y2=\"10.49\"></line>\n        </svg>\n      </button>\n    </div>\n  </header>\n\n  <!-- Game Container -->\n  <main class=\"game-container\">\n    <!-- HUD -->\n    <div class=\"hud-bar\">\n      <div class=\"hud-item\">\n        <span class=\"hud-label\">النقاط</span>\n        <span class=\"hud-val val-score\" id=\"ui-score\">0</span>\n      </div>\n      <div class=\"hud-item\" style=\"align-items: center;\">\n        <span class=\"hud-label\">السرعة</span>\n        <span class=\"hud-val val-speed\" id=\"ui-speed\">1.0x</span>\n      </div>\n      <div class=\"hud-item\" style=\"align-items: flex-end;\">\n        <span class=\"hud-label\">أعلى نتيجة</span>\n        <span class=\"hud-val val-high\" id=\"ui-highscore\">0</span>\n      </div>\n    </div>\n\n    <!-- Canvas -->\n    <div class=\"canvas-wrapper\">\n      <canvas id=\"gameCanvas\"></canvas>\n\n      <!-- Start Menu Overlay -->\n      <div id=\"start-overlay\" class=\"overlay-screen\">\n        <div class=\"card-modal\">\n          <div class=\"modal-icon\">\n            <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon>\n            </svg>\n          </div>\n          <h2 class=\"modal-title\">عداء السايبر</h2>\n          <p class=\"modal-desc\">اقفز وازحف لتفادي حواجز النيون وتجمييع كبسولات الطاقة في المضمار الرقمي!</p>\n\n          <div class=\"score-summary\">\n            <div class=\"stat-box\">\n              <span class=\"stat-label\">أعلى سجل</span>\n              <span class=\"stat-val stat-high\" id=\"start-highscore-val\">0</span>\n            </div>\n          </div>\n\n          <button id=\"btn-start-game\" class=\"btn-primary-action\">\n            <div class=\"btn-icon-label\">\n              <span>انطلاق للعب</span>\n              <svg width=\"20\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <polygon points=\"5 3 19 12 5 21 5 3\"></polygon>\n              </svg>\n            </div>\n          </button>\n\n          <button id=\"btn-start-overlay\" class=\"btn-secondary-action\">\n            <div class=\"btn-icon-label\">\n              <span>فتح النافذة العائمة (Overlay)</span>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"></rect>\n                <rect x=\"9\" y=\"9\" width=\"10\" height=\"10\" rx=\"1\"></rect>\n              </svg>\n            </div>\n          </button>\n\n          <div class=\"quick-nav\">\n            <a href=\"games.html\" class=\"quick-nav-link\">صالة الألعاب</a>\n            <span style=\"color:var(--text-sub);\">•</span>\n            <a href=\"home.html\" class=\"quick-nav-link\">الرئيسية</a>\n          </div>\n        </div>\n      </div>\n\n      <!-- Game Over Overlay -->\n      <div id=\"gameover-overlay\" class=\"overlay-screen hidden\">\n        <div class=\"card-modal\">\n          <div class=\"modal-icon\" style=\"border-color: var(--highlight); color: var(--highlight); box-shadow: 0 0 15px rgba(255, 61, 127, 0.4);\">\n            <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"></path>\n              <line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line>\n              <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n            </svg>\n          </div>\n          <h2 class=\"modal-title\">انتهت اللعبة!</h2>\n          <p class=\"modal-desc\" id=\"gameover-desc\">اصطدمت بحاجز نيون في مضمار السايبر!</p>\n\n          <div class=\"score-summary\">\n            <div class=\"stat-box\">\n              <span class=\"stat-label\">النقاط الحالية</span>\n              <span class=\"stat-val stat-score\" id=\"go-score-val\">0</span>\n            </div>\n            <div class=\"stat-box\">\n              <span class=\"stat-label\">أفضل نتيجة</span>\n              <span class=\"stat-val stat-high\" id=\"go-high-val\">0</span>\n            </div>\n          </div>\n\n          <button id=\"btn-restart-game\" class=\"btn-primary-action\">\n            <div class=\"btn-icon-label\">\n              <span>إعادة المحاولة</span>\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <polyline points=\"23 4 23 10 17 10\"></polyline>\n                <path d=\"M20.49 15a9 9 0 1 1-2.12-9.36L23 10\"></path>\n              </svg>\n            </div>\n          </button>\n\n          <button id=\"btn-share-final\" class=\"btn-secondary-action\">\n            <div class=\"btn-icon-label\">\n              <span>مشاركة النتيجة</span>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <circle cx=\"18\" cy=\"5\" r=\"3\"></circle><circle cx=\"6\" cy=\"12\" r=\"3\"></circle><circle cx=\"18\" cy=\"19\" r=\"3\"></circle>\n                <line x1=\"8.59\" y1=\"13.51\" x2=\"15.42\" y2=\"17.49\"></line>\n                <line x1=\"15.41\" y1=\"6.51\" x2=\"8.59\" y2=\"10.49\"></line>\n              </svg>\n            </div>\n          </button>\n\n          <div class=\"quick-nav\">\n            <a href=\"games.html\" class=\"quick-nav-link\">صالة الألعاب</a>\n            <span style=\"color:var(--text-sub);\">•</span>\n            <a href=\"overlay-hub.html?section=runner\" class=\"quick-nav-link\">النافذة العائمة</a>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Controls -->\n    <div class=\"touch-controls\">\n      <button id=\"btn-ctrl-jump\" class=\"btn-ctrl btn-jump\">\n        <span>قفز</span>\n        <span class=\"ctrl-sub\">أو لمس للأعلى</span>\n      </button>\n\n      <button id=\"btn-ctrl-slide\" class=\"btn-ctrl btn-slide\">\n        <span>انزلاق</span>\n        <span class=\"ctrl-sub\">أو لمس للأسفل</span>\n      </button>\n    </div>\n  </main>\n\n  <div id=\"toast\" class=\"toast\">تم النسخ بنجاح</div>\n\n<script>\n(function() {\n  // Sound System (Web Audio API)\n  var soundEnabled = true;\n  var audioCtx = null;\n\n  function initAudio() {\n    if (!audioCtx) {\n      var AudioContextClass = window.AudioContext || window.webkitAudioContext;\n      if (AudioContextClass) {\n        audioCtx = new AudioContextClass();\n      }\n    }\n    if (audioCtx && audioCtx.state === 'suspended') {\n      audioCtx.resume();\n    }\n  }\n\n  function playSound(type) {\n    if (!soundEnabled) return;\n    initAudio();\n    if (!audioCtx) return;\n\n    try {\n      var osc = audioCtx.createOscillator();\n      var gain = audioCtx.createGain();\n      osc.connect(gain);\n      gain.connect(audioCtx.destination);\n\n      var now = audioCtx.currentTime;\n\n      if (type === 'jump') {\n        osc.type = 'sine';\n        osc.frequency.setValueAtTime(220, now);\n        osc.frequency.exponentialRampToValueAtTime(600, now + 0.15);\n        gain.gain.setValueAtTime(0.3, now);\n        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);\n        osc.start(now);\n        osc.stop(now + 0.15);\n      } else if (type === 'slide') {\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(400, now);\n        osc.frequency.exponentialRampToValueAtTime(150, now + 0.2);\n        gain.gain.setValueAtTime(0.2, now);\n        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);\n        osc.start(now);\n        osc.stop(now + 0.2);\n      } else if (type === 'gem') {\n        osc.type = 'sine';\n        osc.frequency.setValueAtTime(587.33, now);\n        osc.frequency.setValueAtTime(880, now + 0.08);\n        gain.gain.setValueAtTime(0.25, now);\n        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);\n        osc.start(now);\n        osc.stop(now + 0.2);\n      } else if (type === 'crash') {\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(160, now);\n        osc.frequency.exponentialRampToValueAtTime(40, now + 0.3);\n        gain.gain.setValueAtTime(0.4, now);\n        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);\n        osc.start(now);\n        osc.stop(now + 0.3);\n      } else if (type === 'click') {\n        osc.type = 'triangle';\n        osc.frequency.setValueAtTime(440, now);\n        gain.gain.setValueAtTime(0.15, now);\n        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);\n        osc.start(now);\n        osc.stop(now + 0.05);\n      }\n    } catch(e) {}\n  }\n\n  function triggerHaptic(type) {\n    if (window.RosTrickDevice && typeof window.RosTrickDevice.haptic === 'function') {\n      try {\n        window.RosTrickDevice.haptic(type || 'click');\n      } catch(e) {}\n    }\n  }\n\n  // Toast notice\n  function showToast(msg) {\n    var t = document.getElementById('toast');\n    if (t) {\n      t.textContent = msg;\n      t.classList.add('show');\n      setTimeout(function() {\n        t.classList.remove('show');\n      }, 2500);\n    }\n  }\n\n  // Native Back Button\n  if (window.RosTrickBack && typeof window.RosTrickBack.onBack === 'function') {\n    window.RosTrickBack.onBack(function() {\n      if (gameState === 'playing') {\n        gameOver();\n        return true;\n      }\n      return false;\n    });\n  }\n\n  // High Score Storage\n  var STORAGE_KEY = 'rostrick_runner_highscore';\n  function getHighScore() {\n    try {\n      var val = localStorage.getItem(STORAGE_KEY);\n      return val ? parseInt(val, 10) || 0 : 0;\n    } catch(e) {\n      return 0;\n    }\n  }\n  function saveHighScore(scoreVal) {\n    try {\n      var current = getHighScore();\n      if (scoreVal > current) {\n        localStorage.setItem(STORAGE_KEY, scoreVal.toString());\n        return true;\n      }\n    } catch(e) {}\n    return false;\n  }\n\n  // Canvas & Game Loop Setup\n  var canvas = document.getElementById('gameCanvas');\n  var ctx = canvas.getContext('2d');\n\n  var gameState = 'menu';\n  var score = 0;\n  var highScore = getHighScore();\n  var gameSpeed = 6;\n  var speedMultiplier = 1.0;\n  var animFrameId = null;\n  var distanceRun = 0;\n\n  // DOM Elements\n  var uiScore = document.getElementById('ui-score');\n  var uiSpeed = document.getElementById('ui-speed');\n  var uiHighScore = document.getElementById('ui-highscore');\n  var startOverlay = document.getElementById('start-overlay');\n  var gameoverOverlay = document.getElementById('gameover-overlay');\n  var startHighVal = document.getElementById('start-highscore-val');\n  var goScoreVal = document.getElementById('go-score-val');\n  var goHighVal = document.getElementById('go-high-val');\n\n  uiHighScore.textContent = highScore;\n  startHighVal.textContent = highScore;\n\n  // Canvas Resize\n  function resizeCanvas() {\n    var rect = canvas.parentElement.getBoundingClientRect();\n    canvas.width = rect.width;\n    canvas.height = rect.height;\n  }\n  window.addEventListener('resize', resizeCanvas);\n  resizeCanvas();\n\n  // Runner Object\n  var runner = {\n    x: 60,\n    y: 0,\n    width: 34,\n    height: 56,\n    normalHeight: 56,\n    slideHeight: 28,\n    vy: 0,\n    gravity: 0.8,\n    jumpPower: -13.5,\n    isGrounded: false,\n    isSliding: false,\n    slideTimer: 0,\n    jumpCount: 0,\n    maxJumps: 2\n  };\n\n  var groundY = 0;\n  var obstacles = [];\n  var gems = [];\n  var particles = [];\n  var bgStars = [];\n\n  for (var i = 0; i < 40; i++) {\n    bgStars.push({\n      x: Math.random() * 800,\n      y: Math.random() * 400,\n      size: Math.random() * 2 + 1,\n      speed: Math.random() * 0.5 + 0.2\n    });\n  }\n\n  function resetGame() {\n    score = 0;\n    speedMultiplier = 1.0;\n    gameSpeed = 6;\n    distanceRun = 0;\n    obstacles = [];\n    gems = [];\n    particles = [];\n\n    groundY = canvas.height - 70;\n    runner.y = groundY - runner.normalHeight;\n    runner.height = runner.normalHeight;\n    runner.vy = 0;\n    runner.isGrounded = true;\n    runner.isSliding = false;\n    runner.jumpCount = 0;\n\n    uiScore.textContent = '0';\n    uiSpeed.textContent = '1.0x';\n  }\n\n  function spawnObstacle() {\n    var type = Math.random();\n    var groundPos = groundY;\n\n    if (type < 0.5) {\n      obstacles.push({\n        x: canvas.width + 50,\n        y: groundPos - 40,\n        w: 30,\n        h: 40,\n        type: 'barrier',\n        color: '#FF3D7F'\n      });\n    } else if (type < 0.8) {\n      obstacles.push({\n        x: canvas.width + 50,\n        y: groundPos - 95,\n        w: 35,\n        h: 45,\n        type: 'laser',\n        color: '#00E5FF'\n      });\n    } else {\n      obstacles.push({\n        x: canvas.width + 50,\n        y: groundPos - 70,\n        w: 28,\n        h: 28,\n        type: 'drone',\n        color: '#FFD60A'\n      });\n    }\n\n    if (Math.random() < 0.6) {\n      gems.push({\n        x: canvas.width + 100,\n        y: groundPos - (type < 0.8 ? 90 : 35),\n        r: 10,\n        collected: false\n      });\n    }\n  }\n\n  function doJump() {\n    if (gameState !== 'playing') return;\n    if (runner.jumpCount < runner.maxJumps) {\n      runner.vy = runner.jumpPower;\n      runner.isGrounded = false;\n      runner.jumpCount++;\n      runner.isSliding = false;\n      runner.height = runner.normalHeight;\n      playSound('jump');\n      triggerHaptic('tick');\n\n      for (var j = 0; j < 6; j++) {\n        particles.push({\n          x: runner.x + runner.width / 2,\n          y: runner.y + runner.height,\n          vx: (Math.random() - 0.5) * 4,\n          vy: Math.random() * -2,\n          life: 15,\n          color: '#00E5FF'\n        });\n      }\n    }\n  }\n\n  function doSlide() {\n    if (gameState !== 'playing') return;\n    if (!runner.isSliding) {\n      runner.isSliding = true;\n      runner.height = runner.slideHeight;\n      runner.slideTimer = 35;\n      if (runner.isGrounded) {\n        runner.y = groundY - runner.slideHeight;\n      }\n      playSound('slide');\n      triggerHaptic('tick');\n    }\n  }\n\n  function update() {\n    if (gameState !== 'playing') return;\n\n    distanceRun += gameSpeed * speedMultiplier;\n    score = Math.floor(distanceRun / 10);\n    uiScore.textContent = score;\n\n    spee