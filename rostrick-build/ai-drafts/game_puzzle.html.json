{"job":"jmws3yu10zbsm","file":"game_puzzle.html","text":"<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>لعبة ألغاز الكوميكس - كوميكس أوفرلاي</title>\n<style>\n  :root {\n    --primary: #D90429;\n    --primary-dark: #8D0801;\n    --accent: #FFB703;\n    --highlight: #FB8500;\n    --control: #2B2D42;\n    --bg-dark: #141624;\n    --surface: #1E2134;\n    --surface-light: #272B42;\n    --ink: #0B0C14;\n    --text-main: #FFFFFF;\n    --text-muted: #B8C0D9;\n    --success: #06D6A0;\n  }\n\n  * {\n    box-sizing: border-box;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  html, body {\n    margin: 0;\n    padding: 0;\n    background-color: var(--bg-dark);\n    color: var(--text-main);\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Noto Sans Arabic\", Tahoma, Arial, sans-serif;\n    min-height: 100vh;\n    overflow-x: hidden;\n  }\n\n  body {\n    background-image: radial-gradient(rgba(255, 183, 3, 0.08) 1.5px, transparent 1.5px);\n    background-size: 14px 14px;\n    padding-bottom: 84px;\n    padding-bottom: calc(84px + env(safe-area-inset-bottom));\n  }\n\n  a {\n    text-decoration: none;\n    color: inherit;\n  }\n\n  button {\n    font-family: inherit;\n    cursor: pointer;\n    border: none;\n    outline: none;\n  }\n\n  /* Top App Bar */\n  .app-bar {\n    position: sticky;\n    top: 0;\n    z-index: 50;\n    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);\n    border-bottom: 3px solid var(--ink);\n    box-shadow: 0 4px 0 var(--ink);\n    padding: 10px 12px;\n    padding-top: calc(10px + env(safe-area-inset-top));\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n\n  .app-bar-right {\n    display: flex;\n    align-items: center;\n    min-width: 0;\n  }\n\n  .icon-btn {\n    width: 44px;\n    height: 44px;\n    min-width: 44px;\n    min-height: 44px;\n    border-radius: 12px;\n    background: var(--control);\n    color: var(--text-main);\n    border: 2px solid var(--ink);\n    box-shadow: 0 3px 0 var(--ink);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.15s ease;\n    margin-left: 8px;\n  }\n\n  .icon-btn:active {\n    transform: translateY(2px);\n    box-shadow: 0 1px 0 var(--ink);\n  }\n\n  .icon-btn.active {\n    background: var(--accent);\n    color: var(--ink);\n  }\n\n  .app-title-wrap {\n    display: flex;\n    flex-direction: column;\n    min-width: 0;\n    margin-left: 6px;\n  }\n\n  .app-title {\n    font-size: 17px;\n    font-weight: 800;\n    line-height: 1.2;\n    color: #FFFFFF;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .app-subtitle {\n    font-size: 11px;\n    font-weight: 700;\n    color: var(--accent);\n    margin-top: 2px;\n  }\n\n  .app-bar-left {\n    display: flex;\n    align-items: center;\n  }\n\n  .app-bar-left .icon-btn {\n    margin-left: 0;\n    margin-right: 8px;\n  }\n\n  .app-bar-left .icon-btn:first-child {\n    margin-right: 0;\n  }\n\n  /* Main Container */\n  .main-wrap {\n    max-width: 540px;\n    margin: 0 auto;\n    padding: 14px 14px 18px 14px;\n    transition: all 0.25s ease;\n  }\n\n  /* Floating Overlay Simulation Mode */\n  .main-wrap.overlay-sim {\n    max-width: 332px;\n    margin-top: 16px;\n    background: var(--surface);\n    border: 3px solid var(--accent);\n    border-radius: 20px;\n    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.65), 0 6px 0 var(--ink);\n    padding: 10px;\n  }\n\n  .overlay-sim-bar {\n    display: none;\n    align-items: center;\n    justify-content: space-between;\n    background: var(--control);\n    border: 2px solid var(--ink);\n    border-radius: 12px;\n    padding: 6px 10px;\n    margin-bottom: 10px;\n  }\n\n  .main-wrap.overlay-sim .overlay-sim-bar {\n    display: flex;\n  }\n\n  .overlay-sim-label {\n    display: flex;\n    align-items: center;\n    font-size: 12px;\n    font-weight: 800;\n    color: var(--accent);\n  }\n\n  .overlay-sim-label svg {\n    margin-left: 6px;\n  }\n\n  .overlay-sim-close {\n    min-width: 44px;\n    min-height: 36px;\n    padding: 4px 10px;\n    border-radius: 8px;\n    background: var(--primary);\n    color: #fff;\n    font-size: 11px;\n    font-weight: 800;\n    border: 2px solid var(--ink);\n  }\n\n  /* Comic Panel Cards */\n  .comic-card {\n    background: var(--surface);\n    border: 3px solid var(--ink);\n    border-radius: 16px;\n    box-shadow: 0 5px 0 var(--ink);\n    padding: 12px;\n    margin-bottom: 12px;\n  }\n\n  .main-wrap.overlay-sim .comic-card {\n    padding: 9px;\n    margin-bottom: 9px;\n    border-radius: 12px;\n  }\n\n  /* Alert Banner */\n  .alert-banner {\n    display: none;\n    background: #3A1622;\n    border: 2px solid var(--primary);\n    border-radius: 12px;\n    padding: 10px 12px;\n    margin-bottom: 12px;\n    align-items: center;\n    justify-content: space-between;\n  }\n\n  .alert-banner.visible {\n    display: flex;\n  }\n\n  .alert-text {\n    font-size: 12px;\n    font-weight: 700;\n    color: #FFD6DE;\n    margin-left: 8px;\n    line-height: 1.4;\n  }\n\n  .retry-btn {\n    min-width: 44px;\n    min-height: 44px;\n    padding: 0 12px;\n    border-radius: 10px;\n    background: var(--accent);\n    color: var(--ink);\n    font-weight: 800;\n    font-size: 12px;\n    border: 2px solid var(--ink);\n    flex-shrink: 0;\n  }\n\n  /* Comic Scene Selector */\n  .section-head {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 10px;\n  }\n\n  .section-title {\n    font-size: 14px;\n    font-weight: 800;\n    color: var(--accent);\n    display: flex;\n    align-items: center;\n  }\n\n  .section-title svg {\n    margin-left: 6px;\n  }\n\n  .comic-badge {\n    background: var(--highlight);\n    color: var(--ink);\n    font-size: 11px;\n    font-weight: 800;\n    padding: 3px 9px;\n    border-radius: 999px;\n    border: 2px solid var(--ink);\n  }\n\n  .comics-strip {\n    display: flex;\n    overflow-x: auto;\n    padding-bottom: 4px;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  .comics-strip::-webkit-scrollbar {\n    height: 4px;\n  }\n\n  .comics-strip::-webkit-scrollbar-thumb {\n    background: var(--control);\n    border-radius: 4px;\n  }\n\n  .comic-chip {\n    flex: 0 0 auto;\n    width: 96px;\n    background: var(--surface-light);\n    border: 2px solid var(--ink);\n    border-radius: 12px;\n    padding: 6px;\n    margin-left: 8px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    transition: transform 0.12s ease, border-color 0.15s ease, background-color 0.15s ease;\n    min-height: 44px;\n  }\n\n  .comic-chip:last-child {\n    margin-left: 0;\n  }\n\n  .comic-chip:active {\n    transform: scale(0.96);\n  }\n\n  .comic-chip.selected {\n    background: var(--control);\n    border-color: var(--accent);\n    box-shadow: 0 0 0 2px var(--accent);\n  }\n\n  .comic-chip img {\n    width: 56px;\n    height: 56px;\n    border-radius: 8px;\n    border: 2px solid var(--ink);\n    object-fit: cover;\n    background: var(--bg-dark);\n    margin-bottom: 5px;\n    display: block;\n  }\n\n  .comic-chip-name {\n    font-size: 11px;\n    font-weight: 700;\n    color: var(--text-main);\n    line-height: 1.25;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n  }\n\n  .main-wrap.overlay-sim .comic-chip {\n    width: 78px;\n    padding: 4px;\n  }\n\n  .main-wrap.overlay-sim .comic-chip img {\n    width: 44px;\n    height: 44px;\n  }\n\n  /* Controls Row (Grid Size + Tile Numbers + Peek) */\n  .controls-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    margin-top: 8px;\n  }\n\n  .seg-group {\n    display: inline-flex;\n    background: var(--bg-dark);\n    border: 2px solid var(--ink);\n    border-radius: 12px;\n    padding: 3px;\n    margin-bottom: 4px;\n  }\n\n  .seg-btn {\n    min-height: 38px;\n    min-width: 58px;\n    padding: 6px 10px;\n    border-radius: 9px;\n    background: transparent;\n    color: var(--text-muted);\n    font-size: 12px;\n    font-weight: 800;\n    transition: background-color 0.15s ease, color 0.15s ease;\n  }\n\n  .seg-btn.active {\n    background: var(--accent);\n    color: var(--ink);\n  }\n\n  .mini-toggles {\n    display: flex;\n    align-items: center;\n    margin-bottom: 4px;\n  }\n\n  .pill-btn {\n    min-height: 44px;\n    padding: 0 12px;\n    border-radius: 12px;\n    background: var(--control);\n    color: var(--text-main);\n    border: 2px solid var(--ink);\n    box-shadow: 0 3px 0 var(--ink);\n    font-size: 12px;\n    font-weight: 800;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    margin-right: 6px;\n    transition: transform 0.12s ease, background-color 0.15s ease;\n  }\n\n  .pill-btn:first-child {\n    margin-right: 0;\n  }\n\n  .pill-btn:active {\n    transform: translateY(2px);\n    box-shadow: 0 1px 0 var(--ink);\n  }\n\n  .pill-btn.active {\n    background: var(--highlight);\n    color: var(--ink);\n  }\n\n  .pill-btn svg {\n    margin-left: 5px;\n  }\n\n  /* HUD Stats */\n  .hud-grid {\n    display: flex;\n    align-items: stretch;\n    justify-content: space-between;\n    margin-bottom: 8px;\n  }\n\n  .hud-box {\n    flex: 1;\n    background: var(--bg-dark);\n    border: 2px solid var(--ink);\n    border-radius: 12px;\n    padding: 7px 6px;\n    text-align: center;\n    margin-left: 6px;\n  }\n\n  .hud-box:last-child {\n    margin-left: 0;\n  }\n\n  .hud-label {\n    font-size: 10px;\n    font-weight: 700;\n    color: var(--text-muted);\n    margin-bottom: 2px;\n  }\n\n  .hud-val {\n    font-size: 16px;\n    font-weight: 900;\n    color: var(--accent);\n    font-variant-numeric: tabular-nums;\n  }\n\n  .hud-val.best {\n    color: var(--success);\n  }\n\n  .progress-track {\n    width: 100%;\n    height: 10px;\n    background: var(--bg-dark);\n    border: 2px solid var(--ink);\n    border-radius: 999px;\n    overflow: hidden;\n  }\n\n  .progress-fill {\n    height: 100%;\n    width: 0%;\n    background: linear-gradient(90deg, var(--highlight), var(--accent), var(--success));\n    transition: width 0.25s ease;\n  }\n\n  /* Puzzle Board */\n  .board-card {\n    position: relative;\n    background: var(--surface);\n    border: 3px solid var(--ink);\n    border-radius: 18px;\n    box-shadow: 0 6px 0 var(--ink);\n    padding: 10px;\n    margin-bottom: 12px;\n  }\n\n  .board-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 8px;\n  }\n\n  .current-comic-title {\n    font-size: 14px;\n    font-weight: 800;\n    color: #FFFFFF;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    margin-left: 8px;\n  }\n\n  .puzzle-stage {\n    position: relative;\n    width: 100%;\n    padding-top: 100%; /* 1:1 square container */\n    background: #0D0F1A;\n    border: 3px solid var(--ink);\n    border-radius: 12px;\n    overflow: hidden;\n    direction: ltr; /* Deterministic tile coordinates */\n    touch-action: none;\n  }\n\n  .puzzle-grid {\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    padding: 3px;\n  }\n\n  .tile-slot {\n    position: absolute;\n    padding: 3px;\n    transition: left 0.16s cubic-bezier(0.22, 1, 0.36, 1), top 0.16s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  .tile-btn {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    padding: 0;\n    border-radius: 8px;\n    overflow: hidden;\n    border: 2px solid var(--ink);\n    background: var(--surface-light);\n    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.75);\n    display: block;\n  }\n\n  .tile-btn:active {\n    transform: scale(0.96);\n  }\n\n  .tile-btn.correct {\n    border-color: var(--success);\n  }\n\n  .tile-art {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    pointer-events: none;\n  }\n\n  .tile-art img {\n    position: absolute;\n    max-width: none;\n    pointer-events: none;\n    user-select: none;\n    display: block;\n  }\n\n  .tile-num {\n    position: absolute;\n    top: 4px;\n    right: 4px;\n    min-width: 22px;\n    height: 22px;\n    padding: 0 5px;\n    border-radius: 6px;\n    background: rgba(11, 12, 20, 0.85);\n    color: var(--accent);\n    border: 1.5px solid var(--accent);\n    font-size: 11px;\n    font-weight: 900;\n    line-height: 19px;\n    text-align: center;\n    pointer-events: none;\n  }\n\n  .tile-btn.correct .tile-num {\n    background: var(--success);\n    color: var(--ink);\n    border-color: var(--ink);\n  }\n\n  .hide-numbers .tile-num {\n    display: none;\n  }\n\n  .empty-slot-marker {\n    position: absolute;\n    padding: 3px;\n    pointer-events: none;\n    transition: left 0.16s ease, top 0.16s ease;\n  }\n\n  .empty-slot-inner {\n    width: 100%;\n    height: 100%;\n    border-radius: 8px;\n    border: 2px dashed rgba(255, 183, 3, 0.45);\n    background: rgba(255, 183, 3, 0.04);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: rgba(255, 183, 3, 0.5);\n  }\n\n  /* Peek Overlay */\n  .peek-layer {\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    background: rgba(11, 12, 20, 0.94);\n    display: none;\n    align-items: center;\n    justify-content: center;\n    padding: 12px;\n    z-index: 20;\n  }\n\n  .peek-layer.visible {\n    display: flex;\n  }\n\n  .peek-layer img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    border-radius: 10px;\n    border: 3px solid var(--accent);\n  }\n\n  .peek-tag {\n    position: absolute;\n    bottom: 16px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: var(--accent);\n    color: var(--ink);\n    font-size: 12px;\n    font-weight: 900;\n    padding: 4px 12px;\n    border-radius: 999px;\n    border: 2px solid var(--ink);\n    white-space: nowrap;\n  }\n\n  /* Win Overlay */\n  .win-layer {\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    background: rgba(15, 18, 32, 0.92);\n    display: none;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 18px;\n    z-index: 30;\n    text-align: center;\n    direction: rtl;\n  }\n\n  .win-layer.visible {\n    display: flex;\n    animation: popIn 0.28s ease-out;\n  }\n\n  @keyframes popIn {\n    from { opacity: 0; transform: scale(0.92); }\n    to { opacity: 1; transform: scale(1); }\n  }\n\n  .win-burst {\n    background: var(--accent);\n    color: var(--ink);\n    border: 3px solid var(--ink);\n    box-shadow: 0 4px 0 var(--ink);\n    border-radius: 14px;\n    padding: 6px 16px;\n    font-size: 18px;\n    font-weight: 900;\n    margin-bottom: 10px;\n  }\n\n  .win-stats {\n    font-size: 13px;\n    font-weight: 700;\n    color: var(--text-main);\n    background: var(--surface-light);\n    border: 2px solid var(--ink);\n    border-radius: 12px;\n    padding: 10px 14px;\n    margin-bottom: 14px;\n    line-height: 1.6;\n  }\n\n  .win-record {\n    display: inline-block;\n    background: var(--success);\n    color: var(--ink);\n    font-size: 11px;\n    font-weight: 900;\n    padding: 2px 8px;\n    border-radius: 999px;\n    margin-top: 4px;\n  }\n\n  .win-actions {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n  }\n\n  .action-btn {\n    min-height: 44px;\n    padding: 0 16px;\n    border-radius: 12px;\n    font-size: 13px;\n    font-weight: 800;\n    border: 2px solid var(--ink);\n    box-shadow: 0 3px 0 var(--ink);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    margin: 4px;\n    transition: transform 0.12s ease;\n  }\n\n  .action-btn:active {\n    transform: translateY(2px);\n    box-shadow: 0 1px 0 var(--ink);\n  }\n\n  .btn-primary {\n    background: var(--primary);\n    color: #FFFFFF;\n  }\n\n  .btn-accent {\n    background: var(--accent);\n    color: var(--ink);\n  }\n\n  .btn-control {\n    background: var(--control);\n    color: #FFFFFF;\n  }\n\n  /* Board Action Row */\n  .board-actions {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-top: 10px;\n  }\n\n  .board-actions .action-btn {\n    flex: 1;\n    margin: 0 4px;\n  }\n\n  .board-actions .action-btn:first-child {\n    margin-right: 0;\n  }\n\n  .board-actions .action-btn:last-child {\n    margin-left: 0;\n  }\n\n  /* Overlay Launch Card */\n  .overlay-promo {\n    background: linear-gradient(135deg, #2B2D42 0%, #1D1F30 100%);\n    border: 3px solid var(--ink);\n    border-radius: 16px;\n    box-shadow: 0 5px 0 var(--ink);\n    padding: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n\n  .overlay-promo-info {\n    margin-left: 10px;\n  }\n\n  .overlay-promo-title {\n    font-size: 14px;\n    font-weight: 800;\n    color: var(--accent);\n    margin-bottom: 3px;\n  }\n\n  .overlay-promo-desc {\n    font-size: 12px;\n    color: var(--text-muted);\n    line-height: 1.4;\n  }\n\n  .overlay-launch-link {\n    min-height: 44px;\n    min-width: 112px;\n    padding: 0 12px;\n    border-radius: 12px;\n    background: var(--highlight);\n    color: var(--ink);\n    border: 2px solid var(--ink);\n    box-shadow: 0 3px 0 var(--ink);\n    font-size: 12px;\n    font-weight: 900;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    transition: transform 0.12s ease;\n  }\n\n  .overlay-launch-link:active {\n    transform: translateY(2px);\n    box-shadow: 0 1px 0 var(--ink);\n  }\n\n  .overlay-launch-link svg {\n    margin-left: 6px;\n  }\n\n  /* Bottom Navigation Bar */\n  .bottom-nav {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    z-index: 60;\n    background: var(--surface);\n    border-top: 3px solid var(--ink);\n    padding: 6px 12px;\n    padding-bottom: calc(6px + env(safe-area-inset-bottom));\n    display: flex;\n    align-items: center;\n    justify-content: space-around;\n  }\n\n  .nav-item {\n    flex: 1;\n    max-width: 180px;\n    min-height: 48px;\n    border-radius: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 13px;\n    font-weight: 800;\n    color: var(--text-muted);\n    background: transparent;\n    transition: background-color 0.15s ease, color 0.15s ease;\n    margin: 0 4px;\n  }\n\n  .nav-item:active {\n    background: var(--surface-light);\n  }\n\n  .nav-item.highlight {\n    background: var(--primary);\n    color: #FFFFFF;\n    border: 2px solid var(--ink);\n    box-shadow: 0 3px 0 var(--ink);\n  }\n\n  .nav-item svg {\n    margin-left: 7px;\n  }\n</style>\n</head>\n<body>\n\n  <!-- Top App Bar -->\n  <header class=\"app-bar\">\n    <div class=\"app-bar-right\">\n      <a href=\"games.html\" class=\"icon-btn\" aria-label=\"العودة إلى الألعاب المصغرة\" title=\"الألعاب المصغرة\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <polyline points=\"9 18 15 12 9 6\"></polyline>\n        </svg>\n      </a>\n      <div class=\"app-title-wrap\">\n        <span class=\"app-title\">ألغاز لوحات الكوميكس</span>\n        <span class=\"app-subtitle\" id=\"modeBadge\">وضع المكتبة الكامل</span>\n      </div>\n    </div>\n\n    <div class=\"app-bar-left\">\n      <button type=\"button\" class=\"icon-btn active\" id=\"soundToggleBtn\" aria-label=\"تبديل المؤثرات الصوتية\" title=\"المؤثرات الصوتية\">\n        <svg id=\"soundIconOn\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon>\n          <path d=\"M15.54 8.46a5 5 0 0 1 0 7.07\"></path>\n          <path d=\"M19.07 4.93a10 10 0 0 1 0 14.14\"></path>\n        </svg>\n        <svg id=\"soundIconOff\" style=\"display:none;\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon>\n          <line x1=\"23\" y1=\"9\" x2=\"17\" y2=\"15\"></line>\n          <line x1=\"17\" y1=\"9\" x2=\"23\" y2=\"15\"></line>\n        </svg>\n      </button>\n\n      <button type=\"button\" class=\"icon-btn\" id=\"simOverlayBtn\" aria-label=\"معاينة النافذة العائمة\" title=\"معاينة الحجم العائم\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"></rect>\n          <rect x=\"11\" y=\"11\" width=\"8\" height=\"8\" rx=\"1.5\" fill=\"currentColor\"></rect>\n        </svg>\n      </button>\n    </div>\n  </header>\n\n  <main class=\"main-wrap\" id=\"mainWrap\">\n\n    <!-- Floating Window Preview Header -->\n    <div class=\"overlay-sim-bar\">\n      <div class=\"overlay-sim-label\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\">\n          <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"3\"></rect>\n          <path d=\"M8 12h8\"></path>\n        </svg>\n        <span>معاينة النافذة العائمة المصغرة</span>\n      </div>\n      <button type=\"button\" class=\"overlay-sim-close\" id=\"exitSimBtn\">تكبير</button>\n    </div>\n\n    <!-- Error / Offline Fallback Banner -->\n    <div class=\"alert-banner\" id=\"dataAlert\">\n      <div class=\"alert-text\" id=\"dataAlertText\">تعذر تحميل ملف القصص المصورة. تم تفعيل لوحة احتياطية للعب الفوري.</div>\n      <button type=\"button\" class=\"retry-btn\" id=\"retryLoadBtn\">إعادة المحاولة</button>\n    </div>\n\n    <!-- Comic Scene & Settings Card -->\n    <section class=\"comic-card\" aria-label=\"اختيار لوحة القصة والمستوى\">\n      <div class=\"section-head\">\n        <div class=\"section-title\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"></rect>\n            <rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"></rect>\n            <rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"></rect>\n            <rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"></rect>\n          </svg>\n          <span>اختر غلاف القصة للترتيب</span>\n        </div>\n        <span class=\"comic-badge\" id=\"comicsCountBadge\">...</span>\n      </div>\n\n      <div class=\"comics-strip\" id=\"comicsStrip\"></div>\n\n      <div class=\"controls-row\">\n        <div class=\"seg-group\" role=\"group\" aria-label=\"حجم الشبكة\">\n          <button type=\"button\" class=\"seg-btn active\" data-size=\"3\">3×3 سريع</button>\n          <button type=\"button\" class=\"seg-btn\" data-size=\"4\">4×4 تحدي</button>\n        </div>\n\n        <div class=\"mini-toggles\">\n          <button type=\"button\" class=\"pill-btn active\" id=\"toggleNumbersBtn\">\n            <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\">\n              <line x1=\"4\" y1=\"9\" x2=\"20\" y2=\"9\"></line>\n              <line x1=\"4\" y1=\"15\" x2=\"20\" y2=\"15\"></line>\n              <line x1=\"10\" y1=\"3\" x2=\"8\" y2=\"21\"></line>\n              <line x1=\"16\" y1=\"3\" x2=\"14\" y2=\"21\"></line>\n            </svg>\n            <span>أرقام</span>\n          </button>\n\n          <button type=\"button\" class=\"pill-btn\" id=\"peekBtn\">\n            <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\">\n              <path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"></path>\n              <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n            </svg>\n            <span>معاينة</span>\n          </button>\n        </div>\n      </div>\n    </section>\n\n    <!-- HUD Stats -->\n    <section class=\"comic-card\" aria-label=\"إحصائيات اللغز\">\n      <div class=\"hud-grid\">\n        <div class=\"hud-box\">\n          <div class=\"hud-label\">الحركات</div>\n          <div class=\"hud-val\" id=\"movesVal\">0</div>\n        </div>\n        <div class=\"hud-box\">\n          <div class=\"hud-label\">الوقت</div>\n          <div class=\"hud-val\" id=\"timerVal\">00:00</div>\n        </div>\n        <div class=\"hud-box\">\n          <div class=\"hud-label\">أفضل نتيجة</div>\n          <div class=\"hud-val best\" id=\"bestVal\">--</div>\n        </div>\n      </div>\n      <div class=\"progress-track\" aria-label=\"نسبة اكتمال اللغز\">\n        <div class=\"progress-fill\" id=\"progressFill\"></div>\n      </div>\n    </section>\n\n    <!-- Interactive Puzzle Board -->\n    <section class=\"board-card\" aria-label=\"لوحة اللغز\">\n      <div class=\"board-header\">\n        <div class=\"current-comic-title rt-selectable\" id=\"activeComicTitle\">جاري التحميل...</div>\n        <span class=\"comic-badge\" id=\"progressBadge\">0%</span>\n      </div>\n\n      <div class=\"puzzle-stage\" id=\"puzzleStage\">\n        <div class=\"puzzle-grid\" id=\"puzzleGrid\"></div>\n\n        <!-- Original Image Peek Layer -->\n        <div class=\"peek-layer\" id=\"peekLayer\">\n          <img id=\"peekImage\" src=\"\" alt=\"معاينة اللوحة الأصلية\">\n          <span class=\"peek-tag\">اضغط للإغلاق</span>\n        </div>\n\n        <!-- Win Celebration Overlay -->\n        <div class=\"win-layer\" id=\"winLayer\">\n          <div class=\"win-burst\">اكتمل مشهد الكوميكس!</div>\n          <div class=\"win-stats rt-selectable\" id=\"winStatsText\"></div>\n          <div class=\"win-actions\">\n            <button type=\"button\" class=\"action-btn btn-accent\" id=\"playAgainBtn\">العب مجدداً</button>\n            <button type=\"button\" class=\"action-btn btn-primary\" id=\"nextComicBtn\">القصة التالية</button>\n            <a href=\"games.html\" class=\"action-btn btn-control\">كل الألعاب</a>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"board-actions\">\n        <button type=\"button\" class=\"action-btn btn-primary\" id=\"shuffleBtn\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"margin-left:6px;\">\n            <polyline points=\"16 3 21 3 21 8\"></polyline>\n            <line x1=\"4\" y1=\"20\" x2=\"21\" y2=\"3\"></line>\n            <polyline points=\"21 16 21 21 16 21\"></polyline>\n            <line x1=\"15\" y1=\"15\" x2=\"21\" y2=\"21\"></line>\n            <line x1=\"4\" y1=\"4\" x2=\"9\" y2=\"9\"></line>\n          </svg>\n          <span>خلط جديد</span>\n        </button>\n\n        <button type=\"button\" class=\"action-btn btn-control\" id=\"hintMoveBtn\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"margin-left:6px;\">\n            <polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon>\n          </svg>\n          <span>ترتيب تلقائي</span>\n        </button>\n      </div>\n    </section>\n\n    <!-- Overlay Hub Launch Card -->\n    <section class=\"overlay-promo\" aria-label=\"التشغيل في الطبقة العائمة\">\n      <div class=\"overlay-promo-info\">\n        <div class=\"overlay-promo-title\">العب فوق التطبيقات الأخرى</div>\n        <div class=\"overlay-promo-desc\">ثبّت لغز الكوميكس في نافذة عائمة مصغرة أثناء التصفح أو القراءة.</div>\n      </div>\n      <a href=\"overlay_hub.html\" class=\"overlay-launch-link\" id=\"launchOverlayLink\">\n        <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path>\n          <polyline points=\"15 3 21 3 21 9\"></polyline>\n          <line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"></line>\n        </svg>\n        <span>طبقة عائمة</span>\n      </a>\n    </section>\n\n  </main>\n\n  <!-- Bottom Native Navigation -->\n  <nav class=\"bottom-nav\" aria-label=\"التنقل السريع\">\n    <a href=\"games.html\" class=\"nav-item\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"3\"></rect>\n        <path d=\"M6 12h4\"></path>\n        <path d=\"M8 10v4\"></path>\n        <circle cx=\"15\" cy=\"11\" r=\"1\" fill=\"currentColor\"></circle>\n        <circle cx=\"18\" cy=\"13\" r=\"1\" fill=\"currentColor\"></circle>\n      </svg>\n      <span>الألعاب المصغرة</span>\n    </a>\n\n    <a href=\"overlay_hub.html\" class=\"nav-item highlight\" id=\"bottomOverlayLink\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"></rect>\n        <rect x=\"11\" y=\"11\" width=\"8\" height=\"8\" rx=\"1.5\" fill=\"currentColor\"></rect>\n      </svg>\n      <span>التحكم بالطبقة العائمة</span>\n    </a>\n  </nav>\n\n<script>\n(function() {\n  \"use strict\";\n\n  // Emergency inline SVG panel used ONLY if comics.json fails to load\n  var FALLBACK_COMIC_SVG =\n    \"data:image/svg+xml;utf8,\" +\n    encodeURIComponent(\n      \"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 240 240'>\" +\n      \"<rect width='240' height='240' fill='#141624'/>\" +\n      \"<rect x='12' y='12' width='104' height='104' rx='8' fill='#D90429' stroke='#FFFFFF' stroke-width='4'/>\" +\n      \"<rect x='124' y='12' width='104' height='104' rx='8' fill='#FFB703' stroke='#FFFFFF' stroke-width='4'/>\" +\n      \"<rect x='12' y='124' width='104' height='104' rx='8' fill='#2B2D42' stroke='#FFFFFF' stroke-width='4'/>\" +\n      \"<rect x='124' y='124' width='104' height='104' rx='8' fill='#FB8500' stroke='#FFFFFF' stroke-width='4'/>\" +\n      \"<polygon points='64,28 76,56 106,58 82,76 90,104 64,88 38,104 46,76 22,58 52,56' fill='#FFB703' stroke='#141624' stroke-width='3'/>\" +\n      \"<circle cx='176' cy='64' r='30' fill='#D90429' stroke='#141624' stroke-width='4'/>\" +\n      \"<polygon points='176,42 186,64 176,86 166,64' fill='#FFFFFF'/>\" +\n      \"<path d='M32 196 L64 148 L96 196 Z' fill='#06D6A0' stroke='#FFFFFF' stroke-width='3'/>\" +\n      \"<circle cx='176' cy='176' r='26' fill='#141624' stroke='#FFFFFF' stroke-width='4'/>\" +\n      \"<polygon points='168,162 192,176 168,190' fill='#FFB703'/>\" +\n      \"</svg>\"\n    );\n\n  // State\n  var comicsList = [];\n  var selectedComicIndex = 0;\n  var gridSize = 3; // 3x3 or 4x4\n  var board = []; // array of tile numbers: 0..(N*N-2) for tiles, -1 for empty slot\n  var emptyPos = 0;\n  var moves = 0;\n  var secondsElapsed = 0;\n  var timerId = null;\n  var gameActive = false;\n  var gameWon = false;\n  var showNumbers = true;\n  var soundEnabled = true;\n  var audioCtx = null;\n  var swipeStart = null;\n  var undoLastMovePos = -1;\n\n  // DOM Elements\n  var mainWrap = document.getElementById(\"mainWrap\");\n  var modeBadge = document.getElementById(\"modeBadge\");\n  var simOverlayBtn = document.getElementById(\"simOverlayBtn\");\n  var exitSimBtn = document.getElementById(\"exitSimBtn\");\n  var soundToggleBtn = document.getElementById(\"soundToggleBtn\");\n  var soundIconOn = document.getElementById(\"soundIconOn\");\n  var soundIconOff = document.getElementById(\"soundIconOff\");\n\n  var dataAlert = document.getElementById(\"dataAlert\");\n  var dataAlertText = document.getElementById(\"dataAlertText\");\n  var retryLoadBtn = document.getElementById(\"retryLoadBtn\");\n\n  var comicsStrip = document.getElementById(\"comicsStrip\");\n  var comicsCountBadge = document.getElementById(\"comicsCountBadge\");\n  var activeComicTitle = document.getElementById(\"activeComicTitle\");\n\n  var puzzleStage = document.getElementById(\"puzzleStage\");\n  var puzzleGrid = document.getElementById(\"puzzleGrid\");\n  var peekBtn = document.getElementById(\"peekBtn\");\n  var peekLayer = document.getElementById(\"peekLayer\");\n  var peekImage = document.getElementById(\"peekImage\");\n  var toggleNumbersBtn = document.getElementById(\"toggleNumbersBtn\");\n\n  var movesVal = document.getElementById(\"movesVal\");\n  var timerVal = document.getElementById(\"timerVal\");\n  var bestVal = document.getElementById(\"bestVal\");\n  var progressFill = document.getElementById(\"progressFill\");\n  var progressBadge = document.getElementById(\"progressBadge\");\n\n  var winLayer = document.getElementById(\"winLayer\");\n  var winStatsText = document.getElementById(\"winStatsText\");\n  var playAgainBtn = document.getElementById(\"playAgainBtn\");\n  var nextComicBtn = document.getElementById(\"nextComicBtn\");\n  var shuffleBtn = document.getElementById(\"shuffleBtn\");\n  var hintMoveBtn = document.getElementById(\"hintMoveBtn\");\n\n  var launchOverlayLink = document.getElementById(\"launchOverlayLink\");\n  var bottomOverlayLink = document.getElementById(\"bottomOverlayLink\");\n\n  // Safe localStorage helpers\n  function safeGet(key, fallback) {\n    try {\n      var val = window.localStorage.getItem(key);\n      return val !== null ? val : fallback;\n    } catch (e) {\n      return fallback;\n    }\n  }\n\n  function safeSet(key, value) {\n    try {\n      window.localStorage.setItem(key, String(value));\n    } catch (e) {\n      // Ignore when storage is blocked\n    }\n  }\n\n  // Web Audio API short SFX (no <audio> tags)\n  function playTone(freq, duration, type) {\n    if (!soundEnabled) return;\n    try {\n      var AudioContextClass = window.AudioContext || window.webkitAudioContext;\n      if (!AudioContextClass) return;\n      if (!audioCtx) {\n        audioCtx = new AudioContextClass();\n      }\n      if (audioCtx.state === \"suspended\") {\n        audioCtx.resume();\n      }\n      var osc = audioCtx.createOscillator();\n      var gain = audioCtx.createGain();\n      osc.type = type || \"triangle\";\n      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);\n      gain.gain.setValueAtTime(0.08, audioCtx.currentTime);\n      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n      osc.connect(gain);\n      gain.connect(audioCtx.destination);\n      osc.start();\n      osc.stop(audioCtx.currentTime + duration);\n    } catch (e) {\n      // Audio unavailable\n    }\n  }\n\n  function playSlideSfx() {\n    playTone(390, 0.06, \"triangle\");\n  }\n\n  function playWinSfx() {\n    playTone(523, 0.12, \"square\");\n    setTimeout(function() { playTone(659, 0.12, \"square","at":1795370315614}