{"job":"jmws3yu10zbsm","file":"favorites.html","text":"<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>المفضلة وسجل القراءة - كوميكس أوفرلاي</title>\n<style>\n:root{\n  --primary:#D90429;\n  --primary-dark:#8D0801;\n  --accent:#FFB703;\n  --highlight:#FB8500;\n  --control:#2B2D42;\n  --bg:#F1F3F8;\n  --surface:#FFFFFF;\n  --surface-alt:#E7EAF2;\n  --text:#161824;\n  --text-muted:#575B73;\n  --border:#2B2D42;\n  --success:#16A34A;\n}\n\n*{\n  box-sizing:border-box;\n  margin:0;\n  padding:0;\n}\n\nhtml,body{\n  width:100%;\n  min-height:100%;\n  background-color:var(--bg);\n  color:var(--text);\n  font-family:'Segoe UI',Tahoma,Arial,sans-serif;\n  line-height:1.5;\n  overflow-x:hidden;\n}\n\nbody{\n  background-image:radial-gradient(rgba(43,45,66,0.08) 1.2px, transparent 1.2px);\n  background-size:14px 14px;\n  padding-bottom:92px;\n}\n\na{\n  text-decoration:none;\n  color:inherit;\n}\n\nbutton,input,select{\n  font-family:inherit;\n}\n\n.rt-selectable{\n  -webkit-user-select:text;\n  user-select:text;\n}\n\n/* Top App Bar */\n.app-bar{\n  position:sticky;\n  top:0;\n  z-index:40;\n  background-color:var(--control);\n  color:#FFFFFF;\n  border-bottom:3px solid var(--accent);\n  padding-top:env(safe-area-inset-top);\n  box-shadow:0 4px 12px rgba(22,24,36,0.22);\n}\n\n.app-bar-inner{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  padding:10px 12px;\n  min-height:60px;\n}\n\n.app-bar-start{\n  display:flex;\n  align-items:center;\n  min-width:0;\n  flex:1;\n}\n\n.icon-btn{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  width:44px;\n  height:44px;\n  min-width:44px;\n  min-height:44px;\n  border-radius:12px;\n  border:2px solid rgba(255,255,255,0.18);\n  background-color:rgba(255,255,255,0.1);\n  color:#FFFFFF;\n  cursor:pointer;\n  transition:transform 0.14s ease, background-color 0.14s ease;\n}\n\n.icon-btn:active{\n  transform:scale(0.93);\n  background-color:rgba(255,255,255,0.22);\n}\n\n.app-title-wrap{\n  margin-right:10px;\n  min-width:0;\n}\n\n.app-title{\n  font-size:18px;\n  font-weight:800;\n  color:#FFFFFF;\n  white-space:nowrap;\n  overflow:hidden;\n  text-overflow:ellipsis;\n}\n\n.app-subtitle{\n  font-size:12px;\n  color:var(--accent);\n  font-weight:700;\n}\n\n.app-bar-actions{\n  display:flex;\n  align-items:center;\n  margin-right:8px;\n}\n\n.app-bar-actions .icon-btn + .icon-btn{\n  margin-right:8px;\n}\n\n.icon-btn-accent{\n  background-color:var(--primary);\n  border-color:var(--accent);\n  color:#FFFFFF;\n}\n\n.icon-btn-accent:active{\n  background-color:var(--primary-dark);\n}\n\n/* Main Container */\n.container{\n  max-width:760px;\n  margin:0 auto;\n  padding:14px 14px 20px 14px;\n}\n\n/* Hero Summary Banner */\n.hero-card{\n  background:linear-gradient(135deg, var(--control) 0%, #1B1D2E 100%);\n  color:#FFFFFF;\n  border:2.5px solid var(--border);\n  border-radius:16px;\n  padding:14px;\n  box-shadow:0 4px 0 var(--primary);\n  margin-bottom:14px;\n}\n\n.stats-row{\n  display:flex;\n  align-items:stretch;\n  justify-content:space-between;\n  margin-bottom:12px;\n}\n\n.stat-box{\n  flex:1;\n  background-color:rgba(255,255,255,0.08);\n  border:1.5px solid rgba(255,255,255,0.14);\n  border-radius:12px;\n  padding:8px 6px;\n  text-align:center;\n}\n\n.stat-box + .stat-box{\n  margin-right:8px;\n}\n\n.stat-value{\n  display:block;\n  font-size:20px;\n  font-weight:900;\n  color:var(--accent);\n  line-height:1.2;\n}\n\n.stat-label{\n  display:block;\n  font-size:11px;\n  color:#E2E6F0;\n  font-weight:600;\n  margin-top:2px;\n}\n\n.continue-banner{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  background-color:rgba(255,183,3,0.14);\n  border:1.5px solid var(--accent);\n  border-radius:12px;\n  padding:10px 12px;\n}\n\n.continue-info{\n  min-width:0;\n  flex:1;\n  margin-left:10px;\n}\n\n.continue-kicker{\n  font-size:11px;\n  font-weight:800;\n  color:var(--accent);\n  display:block;\n}\n\n.continue-title{\n  font-size:14px;\n  font-weight:800;\n  color:#FFFFFF;\n  white-space:nowrap;\n  overflow:hidden;\n  text-overflow:ellipsis;\n}\n\n.continue-meta{\n  font-size:12px;\n  color:#E2E6F0;\n}\n\n.btn-continue-mini{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  min-height:44px;\n  padding:0 14px;\n  border-radius:10px;\n  background-color:var(--primary);\n  border:2px solid var(--accent);\n  color:#FFFFFF;\n  font-size:13px;\n  font-weight:800;\n  white-space:nowrap;\n  transition:transform 0.14s ease, background-color 0.14s ease;\n}\n\n.btn-continue-mini:active{\n  transform:scale(0.95);\n  background-color:var(--primary-dark);\n}\n\n/* Search & Filter Drawer */\n.search-panel{\n  display:none;\n  background-color:var(--surface);\n  border:2px solid var(--border);\n  border-radius:14px;\n  padding:10px;\n  margin-bottom:14px;\n  box-shadow:0 3px 0 var(--border);\n}\n\n.search-panel.open{\n  display:block;\n}\n\n.search-row{\n  display:flex;\n  align-items:center;\n}\n\n.search-input-wrap{\n  position:relative;\n  flex:1;\n}\n\n.search-input{\n  width:100%;\n  height:44px;\n  padding:0 38px 0 12px;\n  border:2px solid var(--border);\n  border-radius:10px;\n  background-color:var(--bg);\n  color:var(--text);\n  font-size:14px;\n  font-weight:600;\n  outline:none;\n}\n\n.search-input:focus{\n  border-color:var(--primary);\n  background-color:#FFFFFF;\n}\n\n.search-icon{\n  position:absolute;\n  right:10px;\n  top:50%;\n  transform:translateY(-50%);\n  color:var(--text-muted);\n  pointer-events:none;\n}\n\n.sort-select{\n  height:44px;\n  margin-right:8px;\n  padding:0 10px;\n  border:2px solid var(--border);\n  border-radius:10px;\n  background-color:var(--surface-alt);\n  color:var(--text);\n  font-size:13px;\n  font-weight:700;\n}\n\n/* Segmented Tabs */\n.tabs-bar{\n  display:flex;\n  background-color:var(--surface);\n  border:2.5px solid var(--border);\n  border-radius:14px;\n  padding:4px;\n  margin-bottom:14px;\n  box-shadow:0 3px 0 var(--border);\n}\n\n.tab-btn{\n  flex:1;\n  min-height:44px;\n  border:none;\n  border-radius:10px;\n  background-color:transparent;\n  color:var(--text-muted);\n  font-size:13px;\n  font-weight:800;\n  cursor:pointer;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  padding:4px 6px;\n  transition:background-color 0.16s ease, color 0.16s ease, transform 0.12s ease;\n}\n\n.tab-btn:active{\n  transform:scale(0.97);\n}\n\n.tab-btn.active{\n  background-color:var(--primary);\n  color:#FFFFFF;\n  box-shadow:0 2px 0 var(--primary-dark);\n}\n\n.tab-count{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  min-width:22px;\n  height:22px;\n  padding:0 6px;\n  margin-right:6px;\n  border-radius:99px;\n  font-size:11px;\n  font-weight:800;\n  background-color:var(--surface-alt);\n  color:var(--control);\n}\n\n.tab-btn.active .tab-count{\n  background-color:var(--accent);\n  color:var(--control);\n}\n\n/* Section Toolbar */\n.toolbar{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  margin-bottom:12px;\n}\n\n.section-heading{\n  font-size:15px;\n  font-weight:900;\n  color:var(--control);\n  display:flex;\n  align-items:center;\n}\n\n.section-heading svg{\n  margin-left:6px;\n  color:var(--primary);\n}\n\n.toolbar-actions{\n  display:flex;\n  align-items:center;\n}\n\n.btn-text-danger{\n  min-height:44px;\n  padding:0 12px;\n  border-radius:10px;\n  border:2px solid var(--primary);\n  background-color:#FFF1F2;\n  color:var(--primary-dark);\n  font-size:12px;\n  font-weight:800;\n  cursor:pointer;\n  display:inline-flex;\n  align-items:center;\n}\n\n.btn-text-danger:active{\n  background-color:#FFE4E6;\n  transform:scale(0.96);\n}\n\n.btn-text-danger svg{\n  margin-left:5px;\n}\n\n/* Cards List */\n.cards-list{\n  display:block;\n}\n\n.item-card{\n  background-color:var(--surface);\n  border:2.5px solid var(--border);\n  border-radius:16px;\n  padding:12px;\n  margin-bottom:14px;\n  box-shadow:0 4px 0 var(--border);\n  transition:transform 0.15s ease;\n}\n\n.card-top{\n  display:flex;\n  align-items:flex-start;\n}\n\n.cover-wrap{\n  width:78px;\n  height:96px;\n  min-width:78px;\n  border-radius:12px;\n  border:2px solid var(--border);\n  overflow:hidden;\n  background-color:var(--control);\n  position:relative;\n}\n\n.cover-img{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  display:block;\n}\n\n.type-badge{\n  position:absolute;\n  bottom:4px;\n  right:4px;\n  left:4px;\n  text-align:center;\n  font-size:10px;\n  font-weight:800;\n  padding:2px 4px;\n  border-radius:6px;\n  background-color:rgba(22,24,36,0.88);\n  color:var(--accent);\n  border:1px solid var(--accent);\n}\n\n.card-body{\n  flex:1;\n  min-width:0;\n  margin-right:12px;\n}\n\n.card-header-line{\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n}\n\n.card-title{\n  font-size:16px;\n  font-weight:900;\n  color:var(--text);\n  line-height:1.35;\n  margin-bottom:4px;\n  flex:1;\n}\n\n.fav-toggle-btn{\n  width:44px;\n  height:44px;\n  min-width:44px;\n  min-height:44px;\n  margin-right:6px;\n  margin-top:-6px;\n  margin-left:-6px;\n  border:none;\n  background:transparent;\n  color:var(--text-muted);\n  cursor:pointer;\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  border-radius:10px;\n}\n\n.fav-toggle-btn:active{\n  background-color:var(--surface-alt);\n  transform:scale(0.92);\n}\n\n.fav-toggle-btn.is-fav{\n  color:var(--highlight);\n}\n\n.meta-chips{\n  display:flex;\n  flex-wrap:wrap;\n  align-items:center;\n  margin-bottom:6px;\n}\n\n.chip{\n  display:inline-flex;\n  align-items:center;\n  font-size:11px;\n  font-weight:800;\n  padding:3px 8px;\n  border-radius:8px;\n  margin-left:6px;\n  margin-bottom:4px;\n  background-color:var(--surface-alt);\n  color:var(--control);\n  border:1.5px solid #CBD2E1;\n}\n\n.chip-accent{\n  background-color:#FFF7DB;\n  border-color:var(--accent);\n  color:#7A4D00;\n}\n\n.chip-primary{\n  background-color:#FFE5E9;\n  border-color:#F5A3B0;\n  color:var(--primary-dark);\n}\n\n.card-desc{\n  font-size:13px;\n  color:var(--text-muted);\n  display:-webkit-box;\n  -webkit-line-clamp:2;\n  -webkit-box-orient:vertical;\n  overflow:hidden;\n  margin-bottom:6px;\n}\n\n.pdf-url-box{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  background-color:var(--bg);\n  border:1.5px dashed #8B92A8;\n  border-radius:10px;\n  padding:4px 8px;\n  margin-top:4px;\n}\n\n.pdf-url-text{\n  font-size:12px;\n  font-weight:700;\n  color:var(--control);\n  direction:ltr;\n  text-align:left;\n  white-space:nowrap;\n  overflow:hidden;\n  text-overflow:ellipsis;\n  flex:1;\n  margin-left:8px;\n}\n\n.copy-mini-btn{\n  min-height:36px;\n  min-width:44px;\n  padding:4px 10px;\n  border-radius:8px;\n  border:1.5px solid var(--border);\n  background-color:var(--surface);\n  color:var(--control);\n  font-size:11px;\n  font-weight:800;\n  cursor:pointer;\n}\n\n.copy-mini-btn:active{\n  background-color:var(--accent);\n}\n\n/* Reading Progress Block */\n.progress-box{\n  margin-top:10px;\n  padding:10px;\n  border-radius:12px;\n  background-color:#F8FAFC;\n  border:1.5px solid #D8DFEC;\n}\n\n.progress-top{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  margin-bottom:6px;\n  font-size:12px;\n  font-weight:800;\n}\n\n.progress-page{\n  color:var(--control);\n}\n\n.progress-page strong{\n  color:var(--primary);\n}\n\n.progress-percent{\n  color:#FFFFFF;\n  background-color:var(--control);\n  padding:2px 8px;\n  border-radius:99px;\n  font-size:11px;\n}\n\n.progress-track{\n  width:100%;\n  height:10px;\n  background-color:#DCE1EE;\n  border-radius:99px;\n  overflow:hidden;\n  border:1px solid #BFC7DA;\n}\n\n.progress-fill{\n  height:100%;\n  background:linear-gradient(90deg, var(--highlight) 0%, var(--accent) 100%);\n  border-radius:99px;\n  transition:width 0.3s ease;\n}\n\n.progress-time{\n  margin-top:5px;\n  font-size:11px;\n  color:var(--text-muted);\n  font-weight:600;\n}\n\n/* Card Footer Actions */\n.card-actions{\n  display:flex;\n  align-items:center;\n  margin-top:10px;\n  padding-top:10px;\n  border-top:1.5px solid #E5E8F0;\n}\n\n.btn-primary-action{\n  flex:1;\n  min-height:44px;\n  padding:0 12px;\n  border-radius:12px;\n  border:2px solid var(--border);\n  background-color:var(--primary);\n  color:#FFFFFF;\n  font-size:13px;\n  font-weight:800;\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  box-shadow:0 3px 0 var(--primary-dark);\n  transition:transform 0.12s ease, background-color 0.12s ease;\n}\n\n.btn-primary-action:active{\n  transform:translateY(2px);\n  box-shadow:0 1px 0 var(--primary-dark);\n}\n\n.btn-primary-action svg{\n  margin-left:6px;\n}\n\n.btn-secondary-action{\n  min-height:44px;\n  min-width:44px;\n  padding:0 12px;\n  margin-right:8px;\n  border-radius:12px;\n  border:2px solid var(--border);\n  background-color:var(--accent);\n  color:var(--control);\n  font-size:12px;\n  font-weight:800;\n  cursor:pointer;\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  box-shadow:0 3px 0 #C48A00;\n}\n\n.btn-secondary-action:active{\n  transform:translateY(2px);\n  box-shadow:0 1px 0 #C48A00;\n}\n\n.btn-icon-remove{\n  width:44px;\n  height:44px;\n  min-width:44px;\n  margin-right:8px;\n  border-radius:12px;\n  border:2px solid #CBD2E1;\n  background-color:var(--surface-alt);\n  color:var(--text-muted);\n  cursor:pointer;\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n}\n\n.btn-icon-remove:active{\n  background-color:#FFE4E6;\n  color:var(--primary);\n  border-color:var(--primary);\n}\n\n/* Empty & Error States */\n.state-card{\n  background-color:var(--surface);\n  border:2.5px solid var(--border);\n  border-radius:16px;\n  padding:28px 18px;\n  text-align:center;\n  box-shadow:0 4px 0 var(--border);\n  margin-top:8px;\n}\n\n.state-icon{\n  width:68px;\n  height:68px;\n  margin:0 auto 12px auto;\n  border-radius:50%;\n  background-color:#FFF7DB;\n  border:2.5px solid var(--border);\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  color:var(--primary);\n}\n\n.state-title{\n  font-size:17px;\n  font-weight:900;\n  color:var(--control);\n  margin-bottom:6px;\n}\n\n.state-desc{\n  font-size:13px;\n  color:var(--text-muted);\n  margin-bottom:16px;\n}\n\n.state-actions{\n  display:flex;\n  flex-wrap:wrap;\n  justify-content:center;\n}\n\n.state-btn{\n  min-height:44px;\n  padding:0 16px;\n  margin:4px;\n  border-radius:12px;\n  border:2px solid var(--border);\n  background-color:var(--primary);\n  color:#FFFFFF;\n  font-size:13px;\n  font-weight:800;\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  cursor:pointer;\n}\n\n.state-btn-alt{\n  background-color:var(--accent);\n  color:var(--control);\n}\n\n.state-btn:active{\n  transform:scale(0.96);\n}\n\n/* Loading Skeleton */\n.skeleton-card{\n  background-color:var(--surface);\n  border:2px solid #D0D6E4;\n  border-radius:16px;\n  padding:14px;\n  margin-bottom:12px;\n  display:flex;\n  align-items:center;\n}\n\n.skel-box{\n  background-color:#E2E6F0;\n  border-radius:10px;\n}\n\n.skel-cover{\n  width:76px;\n  height:92px;\n  margin-left:12px;\n}\n\n.skel-lines{\n  flex:1;\n}\n\n.skel-line{\n  height:14px;\n  margin-bottom:10px;\n}\n\n.skel-line.short{\n  width:55%;\n}\n\n/* Modals / Bottom Sheets */\n.modal-backdrop{\n  display:none;\n  position:fixed;\n  top:0;\n  right:0;\n  bottom:0;\n  left:0;\n  z-index:80;\n  background-color:rgba(22,24,36,0.68);\n  align-items:flex-end;\n  justify-content:center;\n  padding:12px;\n}\n\n.modal-backdrop.open{\n  display:flex;\n}\n\n.modal-backdrop.center-modal{\n  align-items:center;\n}\n\n.modal-sheet{\n  width:100%;\n  max-width:540px;\n  max-height:82vh;\n  background-color:var(--surface);\n  border:3px solid var(--border);\n  border-radius:20px;\n  box-shadow:0 8px 0 var(--control);\n  display:flex;\n  flex-direction:column;\n  overflow:hidden;\n}\n\n.modal-header{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  padding:12px 14px;\n  background-color:var(--control);\n  color:#FFFFFF;\n  border-bottom:2.5px solid var(--accent);\n}\n\n.modal-title{\n  font-size:16px;\n  font-weight:900;\n}\n\n.modal-body{\n  padding:14px;\n  overflow-y:auto;\n}\n\n.picker-group-title{\n  font-size:13px;\n  font-weight:900;\n  color:var(--primary-dark);\n  margin:8px 0 8px 0;\n  padding-bottom:4px;\n  border-bottom:2px solid var(--surface-alt);\n}\n\n.picker-row{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  padding:8px 10px;\n  border:2px solid #D8DFEC;\n  border-radius:12px;\n  margin-bottom:8px;\n  background-color:#FAFBFD;\n}\n\n.picker-thumb{\n  width:46px;\n  height:52px;\n  border-radius:8px;\n  border:1.5px solid var(--border);\n  object-fit:cover;\n  margin-left:10px;\n  background-color:var(--control);\n}\n\n.picker-info{\n  flex:1;\n  min-width:0;\n  margin-left:8px;\n}\n\n.picker-name{\n  font-size:14px;\n  font-weight:800;\n  color:var(--text);\n  white-space:nowrap;\n  overflow:hidden;\n  text-overflow:ellipsis;\n}\n\n.picker-sub{\n  font-size:11px;\n  color:var(--text-muted);\n  font-weight:600;\n}\n\n.picker-toggle-btn{\n  min-height:44px;\n  padding:0 12px;\n  border-radius:10px;\n  border:2px solid var(--border);\n  background-color:var(--surface-alt);\n  color:var(--control);\n  font-size:12px;\n  font-weight:800;\n  cursor:pointer;\n}\n\n.picker-toggle-btn.active{\n  background-color:var(--accent);\n  color:var(--control);\n}\n\n.page-form-group{\n  margin-bottom:14px;\n}\n\n.page-form-label{\n  display:block;\n  font-size:13px;\n  font-weight:800;\n  color:var(--control);\n  margin-bottom:6px;\n}\n\n.page-input{\n  width:100%;\n  height:46px;\n  padding:0 12px;\n  border:2px solid var(--border);\n  border-radius:12px;\n  font-size:16px;\n  font-weight:800;\n  color:var(--text);\n  background-color:var(--bg);\n}\n\n.modal-footer-btns{\n  display:flex;\n  justify-content:flex-end;\n  margin-top:8px;\n}\n\n.modal-footer-btns button{\n  min-height:44px;\n  padding:0 18px;\n  border-radius:12px;\n  border:2px solid var(--border);\n  font-size:13px;\n  font-weight:800;\n  cursor:pointer;\n}\n\n.btn-cancel{\n  background-color:var(--surface-alt);\n  color:var(--control);\n  margin-left:8px;\n}\n\n.btn-confirm{\n  background-color:var(--primary);\n  color:#FFFFFF;\n}\n\n/* Toast */\n.toast{\n  position:fixed;\n  bottom:84px;\n  left:50%;\n  transform:translateX(-50%) translateY(20px);\n  background-color:var(--control);\n  color:#FFFFFF;\n  border:2px solid var(--accent);\n  border-radius:99px;\n  padding:10px 18px;\n  font-size:13px;\n  font-weight:800;\n  z-index:95;\n  opacity:0;\n  pointer-events:none;\n  transition:opacity 0.2s ease, transform 0.2s ease;\n  white-space:nowrap;\n  box-shadow:0 6px 16px rgba(0,0,0,0.28);\n}\n\n.toast.show{\n  opacity:1;\n  transform:translateX(-50%) translateY(0);\n}\n\n/* Bottom Navigation */\n.bottom-nav{\n  position:fixed;\n  bottom:0;\n  right:0;\n  left:0;\n  z-index:50;\n  background-color:var(--control);\n  border-top:3px solid var(--accent);\n  padding-bottom:env(safe-area-inset-bottom);\n  box-shadow:0 -4px 14px rgba(22,24,36,0.22);\n}\n\n.bottom-nav-inner{\n  display:flex;\n  align-items:stretch;\n  justify-content:space-around;\n  max-width:760px;\n  margin:0 auto;\n  height:62px;\n}\n\n.nav-item{\n  flex:1;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  justify-content:center;\n  color:#CBD2E1;\n  font-size:11px;\n  font-weight:800;\n  min-height:44px;\n  transition:color 0.14s ease, background-color 0.14s ease;\n}\n\n.nav-item:active{\n  background-color:rgba(255,255,255,0.08);\n}\n\n.nav-item.active{\n  color:var(--accent);\n  position:relative;\n}\n\n.nav-item.active::before{\n  content:'';\n  position:absolute;\n  top:0;\n  width:42px;\n  height:3px;\n  background-color:var(--primary);\n  border-radius:0 0 4px 4px;\n}\n\n.nav-item svg{\n  margin-bottom:3px;\n}\n</style>\n</head>\n<body>\n\n<header class=\"app-bar\">\n  <div class=\"app-bar-inner\">\n    <div class=\"app-bar-start\">\n      <a href=\"home.html\" class=\"icon-btn\" aria-label=\"العودة إلى الرئيسية\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <polyline points=\"9 18 15 12 9 6\"></polyline>\n        </svg>\n      </a>\n      <div class=\"app-title-wrap\">\n        <h1 class=\"app-title\">المفضلة وسجل القراءة</h1>\n        <div class=\"app-subtitle\" id=\"headerSubtitle\">محفوظاتك وآخر الصفحات</div>\n      </div>\n    </div>\n    <div class=\"app-bar-actions\">\n      <button type=\"button\" class=\"icon-btn\" id=\"toggleSearchBtn\" aria-label=\"بحث وفرز\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"11\" cy=\"11\" r=\"7\"></circle>\n          <line x1=\"20\" y1=\"20\" x2=\"16.2\" y2=\"16.2\"></line>\n        </svg>\n      </button>\n      <button type=\"button\" class=\"icon-btn icon-btn-accent\" id=\"openPickerBtn\" aria-label=\"إضافة إلى المفضلة\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n          <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n        </svg>\n      </button>\n    </div>\n  </div>\n</header>\n\n<main class=\"container\">\n  <section class=\"hero-card\" aria-label=\"ملخص القراءة\">\n    <div class=\"stats-row\">\n      <div class=\"stat-box\">\n        <span class=\"stat-value\" id=\"statComics\">0</span>\n        <span class=\"stat-label\">قصص مفضلة</span>\n      </div>\n      <div class=\"stat-box\">\n        <span class=\"stat-value\" id=\"statPdfs\">0</span>\n        <span class=\"stat-label\">ملفات PDF</span>\n      </div>\n      <div class=\"stat-box\">\n        <span class=\"stat-value\" id=\"statHistory\">0</span>\n        <span class=\"stat-label\">سجل القراءة</span>\n      </div>\n    </div>\n    <div class=\"continue-banner\" id=\"continueBanner\" style=\"display:none;\">\n      <div class=\"continue-info\">\n        <span class=\"continue-kicker\">استئناف آخر قراءة</span>\n        <div class=\"continue-title\" id=\"continueTitle\">--</div>\n        <div class=\"continue-meta\" id=\"continueMeta\">--</div>\n      </div>\n      <a href=\"reader.html\" class=\"btn-continue-mini\" id=\"continueLink\">متابعة</a>\n    </div>\n  </section>\n\n  <section class=\"search-panel\" id=\"searchPanel\">\n    <div class=\"search-row\">\n      <div class=\"search-input-wrap\">\n        <svg class=\"search-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\">\n          <circle cx=\"11\" cy=\"11\" r=\"7\"></circle>\n          <line x1=\"20\" y1=\"20\" x2=\"16.2\" y2=\"16.2\"></line>\n        </svg>\n        <input type=\"search\" id=\"searchInput\" class=\"search-input\" placeholder=\"ابحث بالعنوان أو التصنيف أو المؤلف...\">\n      </div>\n      <select id=\"sortSelect\" class=\"sort-select\" aria-label=\"ترتيب العناصر\">\n        <option value=\"recent\">الأحدث</option>\n        <option value=\"progress\">نسبة التقدم</option>\n        <option value=\"title\">الأبجدي</option>\n      </select>\n    </div>\n  </section>\n\n  <nav class=\"tabs-bar\" aria-label=\"تصنيفات المحفوظات\">\n    <button type=\"button\" class=\"tab-btn active\" data-tab=\"history\">\n      <span>سجل القراءة</span>\n      <span class=\"tab-count\" id=\"tabCountHistory\">0</span>\n    </button>\n    <button type=\"button\" class=\"tab-btn\" data-tab=\"comic