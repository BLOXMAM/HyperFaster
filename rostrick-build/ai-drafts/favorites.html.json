kerModal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"pickerModalTitle\">\n  <div class=\"modal-sheet\">\n    <div class=\"modal-header\">\n      <div class=\"modal-title\" id=\"pickerModalTitle\">إضافة من المكتبة والروابط</div>\n      <button type=\"button\" class=\"icon-btn\" id=\"closePickerBtn\" aria-label=\"إغلاق\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line>\n          <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line>\n        </svg>\n      </button>\n    </div>\n    <div class=\"modal-body\" id=\"pickerBody\"></div>\n  </div>\n</div>\n\n<!-- Edit Last Page Modal -->\n<div class=\"modal-backdrop center-modal\" id=\"pageModal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"pageModalTitle\">\n  <div class=\"modal-sheet\">\n    <div class=\"modal-header\">\n      <div class=\"modal-title\" id=\"pageModalTitle\">تحديث آخر صفحة توقفت عندها</div>\n      <button type=\"button\" class=\"icon-btn\" id=\"closePageModalBtn\" aria-label=\"إغلاق\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line>\n          <line x1=\"6\" y1=\"6\" x2=\"18\"","at":1795372821895}