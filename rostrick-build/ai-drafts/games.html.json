{"job":"jmwsqrwc5vubm","file":"games.html","text":"<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n  <meta name=\"rostrick-statusbar\" content=\"color=#0D0C1D; icons=light; overlay=true\">\n  <title>الألعاب المصغرة - نيون أركيد</title>\n  <style>\n    :root {\n      --primary: #6C3BFF;\n      --primary-dark: #4A22C9;\n      --accent: #00E5FF;\n      --highlight: #FF3D7F;\n      --control: #B8B5D1;\n      --bg-dark: #0D0C1D;\n      --card-bg: #16142E;\n      --card-border: rgba(108, 59, 255, 0.35);\n      --card-glow: rgba(0, 229, 255, 0.15);\n      --text-main: #FFFFFF;\n      --text-muted: #A09CBF;\n      --rt-statusbar-height: 0px;\n    }\n\n    * {\n      box-sizing: border-box;\n      -webkit-tap-highlight-color: transparent;\n      user-select: none;\n      -webkit-user-select: none;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      background-color: var(--bg-dark);\n      color: var(--text-main);\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      min-height: 100vh;\n      display: flex;\n      flex-direction: column;\n      overflow-x: hidden;\n      padding-top: var(--rt-statusbar-height);\n      padding-bottom: env(safe-area-inset-bottom);\n    }\n\n    /* Top App Bar */\n    .app-header {\n      background: linear-gradient(180deg, rgba(22, 20, 46, 0.95) 0%, rgba(13, 12, 29, 0.9) 100%);\n      backdrop-filter: blur(10px);\n      border-bottom: 1px solid rgba(108, 59, 255, 0.3);\n      position: sticky;\n      top: 0;\n      z-index: 100;\n      padding: 12px 16px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      height: 60px;\n    }\n\n    .header-title-box {\n      display: flex;\n      align-items: center;\n    }\n\n    .header-icon {\n      width: 32px;\n      height: 32px;\n      margin-left: 10px;\n      color: var(--accent);\n      filter: drop-shadow(0 0 6px var(--accent));\n    }\n\n    .header-title {\n      font-size: 1.2rem;\n      font-weight: 800;\n      letter-spacing: 0.5px;\n      background: linear-gradient(90deg, #FFFFFF, var(--accent));\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n    }\n\n    .icon-btn {\n      min-width: 44px;\n      min-height: 44px;\n      border-radius: 12px;\n      border: 1px solid rgba(0, 229, 255, 0.3);\n      background: rgba(108, 59, 255, 0.15);\n      color: #FFFFFF;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      text-decoration: none;\n    }\n\n    .icon-btn:active {\n      transform: scale(0.92);\n      background: var(--primary);\n      box-shadow: 0 0 12px var(--accent);\n    }\n\n    .icon-btn svg {\n      width: 22px;\n      height: 22px;\n      fill: currentColor;\n    }\n\n    /* Container */\n    .container {\n      padding: 16px;\n      flex: 1;\n      max-width: 768px;\n      margin: 0 auto;\n      width: 100%;\n    }\n\n    /* Stats Hero Banner */\n    .hero-banner {\n      background: linear-gradient(135deg, rgba(108, 59, 255, 0.3) 0%, rgba(255, 61, 127, 0.2) 100%);\n      border: 1px solid var(--accent);\n      border-radius: 20px;\n      padding: 18px;\n      margin-bottom: 20px;\n      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), inset 0 0 15px rgba(0, 229, 255, 0.15);\n      position: relative;\n      overflow: hidden;\n    }\n\n    .hero-banner::before {\n      content: '';\n      position: absolute;\n      top: -50%;\n      left: -50%;\n      width: 200%;\n      height: 200%;\n      background: radial-gradient(circle, rgba(0,229,255,0.08) 0%, transparent 60%);\n      pointer-events: none;\n    }\n\n    .hero-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 12px;\n    }\n\n    .hero-title {\n      font-size: 1.1rem;\n      font-weight: 700;\n      color: #FFFFFF;\n      display: flex;\n      align-items: center;\n    }\n\n    .hero-title svg {\n      width: 20px;\n      height: 20px;\n      margin-left: 8px;\n      fill: var(--highlight);\n    }\n\n    .hero-badge {\n      background: rgba(255, 61, 127, 0.2);\n      border: 1px solid var(--highlight);\n      color: #FF7BA4;\n      font-size: 0.75rem;\n      font-weight: 700;\n      padding: 4px 10px;\n      border-radius: 20px;\n      text-transform: uppercase;\n    }\n\n    .stats-grid {\n      display: flex;\n      justify-content: space-between;\n    }\n\n    .stat-card {\n      flex: 1;\n      background: rgba(13, 12, 29, 0.6);\n      border-radius: 12px;\n      padding: 10px;\n      text-align: center;\n      border: 1px solid rgba(184, 181, 209, 0.15);\n    }\n\n    .stat-card:first-child {\n      margin-left: 10px;\n    }\n\n    .stat-val {\n      font-size: 1.3rem;\n      font-weight: 900;\n      color: var(--accent);\n      text-shadow: 0 0 8px rgba(0, 229, 255, 0.5);\n    }\n\n    .stat-lbl {\n      font-size: 0.72rem;\n      color: var(--text-muted);\n      margin-top: 2px;\n    }\n\n    /* Filters */\n    .filter-scroll {\n      display: flex;\n      overflow-x: auto;\n      white-space: nowrap;\n      margin-bottom: 20px;\n      padding-bottom: 4px;\n      -webkit-overflow-scrolling: touch;\n    }\n\n    .filter-scroll::-webkit-scrollbar {\n      display: none;\n    }\n\n    .filter-chip {\n      background: var(--card-bg);\n      border: 1px solid rgba(108, 59, 255, 0.3);\n      color: var(--control);\n      padding: 10px 18px;\n      border-radius: 25px;\n      font-size: 0.88rem;\n      font-weight: 600;\n      cursor: pointer;\n      margin-left: 8px;\n      min-height: 44px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      transition: all 0.2s;\n    }\n\n    .filter-chip.active {\n      background: var(--primary);\n      border-color: var(--accent);\n      color: #FFFFFF;\n      box-shadow: 0 0 12px rgba(108, 59, 255, 0.6);\n    }\n\n    /* Section Title */\n    .section-title-wrap {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 14px;\n    }\n\n    .section-title {\n      font-size: 1.1rem;\n      font-weight: 800;\n      color: #FFFFFF;\n      display: flex;\n      align-items: center;\n    }\n\n    .section-title::before {\n      content: '';\n      display: inline-block;\n      width: 4px;\n      height: 18px;\n      background: var(--highlight);\n      margin-left: 8px;\n      border-radius: 2px;\n      box-shadow: 0 0 8px var(--highlight);\n    }\n\n    /* Game Cards Grid */\n    .games-grid {\n      display: flex;\n      flex-direction: column;\n      margin-bottom: 30px;\n    }\n\n    .game-card {\n      background: var(--card-bg);\n      border: 1px solid var(--card-border);\n      border-radius: 18px;\n      margin-bottom: 16px;\n      padding: 16px;\n      position: relative;\n      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);\n      transition: transform 0.2s, border-color 0.2s;\n      overflow: hidden;\n    }\n\n    .game-card:active {\n      transform: scale(0.99);\n      border-color: var(--accent);\n    }\n\n    .game-card-main {\n      display: flex;\n      align-items: flex-start;\n      margin-bottom: 14px;\n    }\n\n    .game-cover {\n      width: 84px;\n      height: 84px;\n      border-radius: 14px;\n      object-fit: cover;\n      background: #090814;\n      border: 1px solid rgba(0, 229, 255, 0.3);\n      margin-left: 14px;\n      flex-shrink: 0;\n      box-shadow: 0 4px 10px rgba(0,0,0,0.5);\n    }\n\n    .game-info {\n      flex: 1;\n      min-width: 0;\n    }\n\n    .game-header-row {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      margin-bottom: 4px;\n    }\n\n    .game-title {\n      font-size: 1.05rem;\n      font-weight: 800;\n      color: #FFFFFF;\n      line-height: 1.3;\n    }\n\n    .game-tag {\n      font-size: 0.7rem;\n      padding: 2px 8px;\n      border-radius: 6px;\n      background: rgba(108, 59, 255, 0.3);\n      color: var(--accent);\n      border: 1px solid rgba(0, 229, 255, 0.2);\n      white-space: nowrap;\n      margin-right: 6px;\n    }\n\n    .game-desc {\n      font-size: 0.82rem;\n      color: var(--text-muted);\n      line-height: 1.4;\n      margin-bottom: 8px;\n      display: -webkit-box;\n      -webkit-line-clamp: 2;\n      -webkit-box-orient: vertical;\n      overflow: hidden;\n    }\n\n    .score-badge {\n      display: inline-flex;\n      align-items: center;\n      background: rgba(255, 61, 127, 0.12);\n      border: 1px solid rgba(255, 61, 127, 0.4);\n      color: #FFA3C4;\n      padding: 4px 10px;\n      border-radius: 8px;\n      font-size: 0.78rem;\n      font-weight: 700;\n    }\n\n    .score-badge svg {\n      width: 14px;\n      height: 14px;\n      fill: var(--highlight);\n      margin-left: 5px;\n    }\n\n    /* Card Action Buttons */\n    .game-actions {\n      display: flex;\n      border-top: 1px solid rgba(184, 181, 209, 0.1);\n      padding-top: 12px;\n      margin-top: 4px;\n    }\n\n    .btn-play-full {\n      flex: 2;\n      min-height: 44px;\n      background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%);\n      border: 1px solid var(--accent);\n      border-radius: 12px;\n      color: #FFFFFF;\n      font-size: 0.9rem;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      text-decoration: none;\n      box-shadow: 0 4px 12px rgba(108, 59, 255, 0.4);\n      transition: all 0.2s;\n    }\n\n    .btn-play-full:active {\n      transform: scale(0.96);\n      box-shadow: 0 0 15px var(--accent);\n    }\n\n    .btn-play-full svg {\n      width: 18px;\n      height: 18px;\n      margin-left: 6px;\n      fill: #FFFFFF;\n    }\n\n    .btn-play-overlay {\n      flex: 1;\n      min-height: 44px;\n      background: rgba(0, 229, 255, 0.1);\n      border: 1px solid var(--accent);\n      border-radius: 12px;\n      color: var(--accent);\n      font-size: 0.82rem;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      margin-right: 8px;\n      transition: all 0.2s;\n    }\n\n    .btn-play-overlay:active {\n      background: var(--accent);\n      color: var(--bg-dark);\n    }\n\n    .btn-play-overlay svg {\n      width: 16px;\n      height: 16px;\n      margin-left: 5px;\n      fill: currentColor;\n    }\n\n    .btn-share {\n      width: 44px;\n      height: 44px;\n      background: rgba(184, 181, 209, 0.1);\n      border: 1px solid rgba(184, 181, 209, 0.2);\n      border-radius: 12px;\n      color: var(--control);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      margin-right: 8px;\n      flex-shrink: 0;\n    }\n\n    .btn-share:active {\n      background: rgba(184, 181, 209, 0.3);\n      color: #FFFFFF;\n    }\n\n    .btn-share svg {\n      width: 18px;\n      height: 18px;\n      fill: currentColor;\n    }\n\n    /* Toast Notification */\n    .toast {\n      position: fixed;\n      bottom: 75px;\n      left: 50%;\n      transform: translateX(-50%) translateY(100px);\n      background: var(--card-bg);\n      border: 1px solid var(--accent);\n      color: #FFFFFF;\n      padding: 12px 22px;\n      border-radius: 30px;\n      font-size: 0.88rem;\n      font-weight: 700;\n      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 15px rgba(0, 229, 255, 0.4);\n      z-index: 1000;\n      opacity: 0;\n      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n      pointer-events: none;\n      display: flex;\n      align-items: center;\n      white-space: nowrap;\n    }\n\n    .toast.show {\n      transform: translateX(-50%) translateY(0);\n      opacity: 1;\n    }\n\n    .toast svg {\n      width: 18px;\n      height: 18px;\n      margin-left: 8px;\n      fill: var(--accent);\n    }\n\n    /* Bottom Navigation Bar */\n    .bottom-nav {\n      position: fixed;\n      bottom: 0;\n      left: 0;\n      right: 0;\n      height: 62px;\n      background: linear-gradient(0deg, rgba(13, 12, 29, 0.98) 0%, rgba(22, 20, 46, 0.95) 100%);\n      border-top: 1px solid rgba(108, 59, 255, 0.3);\n      display: flex;\n      justify-content: space-around;\n      align-items: center;\n      z-index: 90;\n      padding-bottom: env(safe-area-inset-bottom);\n    }\n\n    .nav-item {\n      flex: 1;\n      height: 100%;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      color: var(--control);\n      text-decoration: none;\n      font-size: 0.72rem;\n      font-weight: 600;\n      transition: color 0.2s;\n    }\n\n    .nav-item.active {\n      color: var(--accent);\n      font-weight: 800;\n    }\n\n    .nav-item svg {\n      width: 22px;\n      height: 22px;\n      fill: currentColor;\n      margin-bottom: 3px;\n    }\n\n    .nav-item.active svg {\n      filter: drop-shadow(0 0 6px var(--accent));\n    }\n\n    /* Loading Spinner */\n    .loading-box {\n      text-align: center;\n      padding: 40px 20px;\n      color: var(--text-muted);\n    }\n\n    .spinner {\n      width: 40px;\n      height: 40px;\n      border: 3px solid rgba(108, 59, 255, 0.2);\n      border-top-color: var(--accent);\n      border-radius: 50%;\n      animation: spin 0.8s linear infinite;\n      margin: 0 auto 14px;\n    }\n\n    @keyframes spin {\n      to { transform: rotate(360deg); }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Top App Bar -->\n  <header class=\"app-header\">\n    <div class=\"header-title-box\">\n      <svg class=\"header-icon\" viewBox=\"0 0 24 24\">\n        <path d=\"M21,6H3A2,2 0 0,0 1,8V16A2,2 0 0,0 3,18H21A2,2 0 0,0 23,16V8A2,2 0 0,0 21,6M6,15H4V13H6V15M6,11H4V9H6V11M9,13H7V11H9V13M15,15H13V13H15V15M15,11H13V9H15V11M18,13H16V11H18V13M20,15H18V13H20V15Z\"/>\n      </svg>\n      <h1 class=\"header-title\">صالة الألعاب النيون</h1>\n    </div>\n    <a href=\"overlay-hub.html?section=games\" class=\"icon-btn\" title=\"فتح مركز النافذة العائمة\" id=\"btn-overlay-hub\">\n      <svg viewBox=\"0 0 24 24\">\n        <path d=\"M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,7H5V5H19V7M19,19H5V9H19V19M13,11H17V15H13V11Z\"/>\n      </svg>\n    </a>\n  </header>\n\n  <!-- Main Content -->\n  <main class=\"container\">\n\n    <!-- Stats Hero -->\n    <section class=\"hero-banner\">\n      <div class=\"hero-header\">\n        <div class=\"hero-title\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z\"/></svg>\n          إحصائيات اللاعب\n        </div>\n        <span class=\"hero-badge\">وضع النيون نشط</span>\n      </div>\n      <div class=\"stats-grid\">\n        <div class=\"stat-card\">\n          <div class=\"stat-val\" id=\"stat-total-games\">4</div>\n          <div class=\"stat-lbl\">الألعاب المتاحة</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-val\" id=\"stat-total-score\">0</div>\n          <div class=\"stat-lbl\">مجموع النقاط القياسية</div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Filters -->\n    <div class=\"filter-scroll\" id=\"filters-bar\">\n      <button class=\"filter-chip active\" data-filter=\"all\">جميع الألعاب</button>\n      <button class=\"filter-chip\" data-filter=\"arcade\">أركيد وتصويب</button>\n      <button class=\"filter-chip\" data-filter=\"speed\">سرعة وتحدي</button>\n      <button class=\"filter-chip\" data-filter=\"puzzle\">ألغاز وتفكير</button>\n    </div>\n\n    <!-- Section Title -->\n    <div class=\"section-title-wrap\">\n      <h2 class=\"section-title\">الألعاب المصغرة الفورية</h2>\n    </div>\n\n    <!-- Games Grid -->\n    <div class=\"games-grid\" id=\"games-container\">\n      <div class=\"loading-box\">\n        <div class=\"spinner\"></div>\n        <div>جاري تحميل الألعاب والتحديات...</div>\n      </div>\n    </div>\n\n  </main>\n\n  <!-- Bottom Navigation Bar -->\n  <nav class=\"bottom-nav\">\n    <a href=\"home.html\" class=\"nav-item\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z\"/></svg>\n      <span>الرئيسية</span>\n    </a>\n    <a href=\"games.html\" class=\"nav-item active\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M21,6H3A2,2 0 0,0 1,8V16A2,2 0 0,0 3,18H21A2,2 0 0,0 23,16V8A2,2 0 0,0 21,6M6,15H4V13H6V15M6,11H4V9H6V11M9,13H7V11H9V13M15,15H13V13H15V15M15,11H13V9H15V11M18,13H16V11H18V13M20,15H18V13H20V15Z\"/></svg>\n      <span>الألعاب</span>\n    </a>\n    <a href=\"overlay-hub.html?section=games\" class=\"nav-item\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,7H5V5H19V7M19,19H5V9H19V19M13,11H17V15H13V11Z\"/></svg>\n      <span>العائمة</span>\n    </a>\n  </nav>\n\n  <!-- Notification Toast -->\n  <div class=\"toast\" id=\"toast\">\n    <svg viewBox=\"0 0 24 24\"><path d=\"M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z\"/></svg>\n    <span id=\"toast-text\">تمت العملية بنجاح</span>\n  </div>\n\n  <script>\n    // System & Audio Setup\n    var audioCtx = null;\n\n    function playBeep(freq, type, duration) {\n      try {\n        if (!audioCtx) {\n          var AudioContext = window.AudioContext || window.webkitAudioContext;\n          if (AudioContext) audioCtx = new AudioContext();\n        }\n        if (audioCtx && audioCtx.state === 'suspended') {\n          audioCtx.resume();\n        }\n        if (!audioCtx) return;\n\n        var osc = audioCtx.createOscillator();\n        var gain = audioCtx.createGain();\n        osc.type = type || 'sine';\n        osc.frequency.setValueAtTime(freq || 440, audioCtx.currentTime);\n        gain.gain.setValueAtTime(0.15, audioCtx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + (duration || 0.15));\n        osc.connect(gain);\n        gain.connect(audioCtx.destination);\n        osc.start();\n        osc.stop(audioCtx.currentTime + (duration || 0.15));\n      } catch (e) {\n        // Ignore web audio restrictions\n      }\n    }\n\n    function triggerHaptic() {\n      if (window.RosTrickDevice && typeof RosTrickDevice.haptic === 'function') {\n        try { RosTrickDevice.haptic('click'); } catch(e){}\n      }\n    }\n\n    function showToast(message) {\n      var toast = document.getElementById('toast');\n      var toastText = document.getElementById('toast-text');\n      toastText.textContent = message;\n      toast.classList.add('show');\n      setTimeout(function() {\n        toast.classList.remove('show');\n      }, 3000);\n    }\n\n    // Default primary mini-games list matching project structure\n    var defaultGames = [\n      {\n        id: \"game-space\",\n        title: \"غزاة المجرة\",\n        genre: \"arcade\",\n        genreName: \"أركيد وتصويب\",\n        file: \"game-space.html\",\n        cover: \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><rect width='120' height='120' rx='20' fill='%230B091A'/><polygon points='60,18 75,55 105,75 60,65 15,75 45,55' fill='%2300E5FF'/><circle cx='60' cy='42' r='8' fill='%23FF3D7F'/><line x1='60' y1='10' x2='60' y2='25' stroke='%23FF3D7F' stroke-width='4'/><circle cx='30' cy='25' r='2' fill='%23FFFFFF'/><circle cx='95' cy='30' r='3' fill='%23FFFFFF'/><circle cx='20' cy='90' r='2' fill='%23FFFFFF'/></svg>\",\n        description: \"لعبة تصويب فضائية مصغرة سريعة الإيقاع بأسلوب الأركيد مع تسجيل أعلى النقاط.\",\n        scoreKey: \"highscore_game-space\"\n      },\n      {\n        id: \"game-runner\",\n        title: \"عداء السايبر\",\n        genre: \"speed\",\n        genreName: \"سرعة وتحدي\",\n        file: \"game-runner.html\",\n        cover: \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><rect width='120' height='120' rx='20' fill='%23120C24'/><path d='M25 90 L95 90' stroke='%236C3BFF' stroke-width='6'/><path d='M40 75 L55 45 L70 50 L85 25' fill='none' stroke='%23FF3D7F' stroke-width='5' stroke-linecap='round'/><circle cx='85' cy='25' r='7' fill='%2300E5FF'/><rect x='30' y='65' width='14' height='14' fill='%2300E5FF'/></svg>\",\n        description: \"لعبة قفز وتخطي عقبات لا نهائية بتأثيرات نيون مع سرعة متزايدة.\",\n        scoreKey: \"highscore_game-runner\"\n      },\n      {\n        id: \"game-puzzle\",\n        title: \"مصفوفة النيون\",\n        genre: \"puzzle\",\n        genreName: \"ألغاز وتفكير\",\n        file: \"game-puzzle.html\",\n        cover: \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><rect width='120' height='120' rx='20' fill='%2316142E'/><rect x='20' y='20' width='36' height='36' rx='8' fill='%236C3BFF'/><rect x='64' y='20' width='36' height='36' rx='8' fill='%2300E5FF'/><rect x='20' y='64' width='36' height='36' rx='8' fill='%23FF3D7F'/><rect x='64' y='64' width='36' height='36' rx='8' fill='none' stroke='%2300E5FF' stroke-width='4' stroke-dasharray='6 4'/></svg>\",\n        description: \"لعبة ألغاز ومطابقة سريعة باللمس مع مستويات متدرجة ومؤقت زمني.\",\n        scoreKey: \"highscore_game-puzzle\"\n      },\n      {\n        id: \"game-snake\",\n        title: \"ثعبان السايبر\",\n        genre: \"arcade\",\n        genreName: \"أركيد وتصويب\",\n        file: \"game-snake.html\",\n        cover: \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><rect width='120' height='120' rx='20' fill='%230A1224'/><path d='M20 70 H50 V40 H80 V60 H100' fill='none' stroke='%2300E5FF' stroke-width='10' stroke-linejoin='round' stroke-linecap='round'/><circle cx='100' cy='60' r='7' fill='%23FF3D7F'/><circle cx='30' cy='30' r='6' fill='%23FF3D7F'/></svg>\",\n        description: \"لعبة الثعبان الكلاسيكية بواجهة نيون وتحكم لمسي سلس وحفظ أعلى نتيجة.\",\n        scoreKey: \"highscore_game-snake\"\n      }\n    ];\n\n    var allGamesData = [];\n    var currentFilter = 'all';\n\n    // Helper to get high score from localStorage safely\n    function getHighScore(key) {\n      try {\n        var score = localStorage.getItem(key);\n        return score ? parseInt(score, 10) : 0;\n      } catch (e) {\n        return 0;\n      }\n    }\n\n    // Load Games Data from games.json or Fallback\n    function loadGamesData() {\n      fetch('games.json')\n        .then(function(res) {\n          if (!res.ok) throw new Error('HTTP status ' + res.status);\n          return res.json();\n        })\n        .then(function(jsonData) {\n          if (Array.isArray(jsonData) && jsonData.length > 0) {\n            // Map external JSON format to inner structure if needed\n            allGamesData = jsonData.map(function(g) {\n              return {\n                id: g.id || 'game-' + Math.random().toString(36).substring(2,7),\n                title: g.title || 'لعبة نيون',\n                genre: g.genre || 'arcade',\n                genreName: g.genre === 'puzzle' ? 'ألغاز وتفكير' : (g.genre === 'speed' ? 'سرعة وتحدي' : 'أركيد وتصويب'),\n                file: g.file || 'game-space.html',\n                cover: g.cover || defaultGames[0].cover,\n                description: g.description || g.summary || 'لعبة مصغرة ممتعة دعمت وضع النيون.',\n                scoreKey: 'highscore_' + (g.id || 'game')\n              };\n            });\n          } else {\n            allGamesData = defaultGames;\n          }\n          renderGames();\n        })\n        .catch(function(err) {\n          // Fallback to offline defaults\n          allGamesData = defaultGames;\n          renderGames();\n        });\n    }\n\n    // Render Grid & Update Stats\n    function renderGames() {\n      var container = document.getElementById('games-container');\n      container.innerHTML = '';\n\n      var filtered = allGamesData.filter(function(g) {\n        if (currentFilter === 'all') return true;\n        return g.genre === currentFilter;\n      });\n\n      var totalHighScoreSum = 0;\n\n      if (filtered.length === 0) {\n        container.innerHTML = '<div class=\"loading-box\">لا توجد ألعاب متطابقة مع التصنيف المختار</div>';\n        return;\n      }\n\n      filtered.forEach(function(game) {\n        var highScore = getHighScore(game.scoreKey);\n        totalHighScoreSum += highScore;\n\n        var card = document.createElement('div');\n        card.className = 'game-card';\n        card.innerHTML = \n          '<div class=\"game-card-main\">' +\n            '<img src=\"' + game.cover + '\" alt=\"' + game.title + '\" class=\"game-cover\">' +\n            '<div class=\"game-info\">' +\n              '<div class=\"game-header-row\">' +\n                '<h3 class=\"game-title\">' + game.title + '</h3>' +\n                '<span class=\"game-tag\">' + game.genreName + '</span>' +\n              '</div>' +\n              '<p class=\"game-desc\">' + game.description + '</p>' +\n              '<div class=\"score-badge\">' +\n                '<svg viewBox=\"0 0 24 24\"><path d=\"M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z\"/></svg>' +\n                'أعلى نتيجة: ' + highScore +\n              '</div>' +\n            '</div>' +\n          '</div>' +\n          '<div class=\"game-actions\">' +\n            '<a href=\"' + game.file + '\" class=\"btn-play-full\" data-action=\"play\">' +\n              '<svg viewBox=\"0 0 24 24\"><path d=\"M8,5.14V19.14L19,12.14L8,5.14Z\"/></svg>' +\n              'لعب بملء الشاشة' +\n            '</a>' +\n            '<button class=\"btn-play-overlay\" data-file=\"' + game.file + '\" data-title=\"' + game.title + '\">' +\n              '<svg viewBox=\"0 0 24 24\"><path d=\"M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,7H5V5H19V7M19,19H5V9H19V19M13,11H17V15H13V11Z\"/></svg>' +\n              'عائمة' +\n            '</button>' +\n            '<button class=\"btn-share\" data-title=\"' + game.title + '\" data-score=\"' + highScore + '\" title=\"مشاركة النتيجة\">' +\n              '<svg viewBox=\"0 0 24 24\"><path d=\"M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19A3,3 0 0,0 18.08,22A3,3 0 0,0 21.08,19A3,3 0 0,0 18.08,16.08Z\"/></svg>' +\n            '</button>' +\n          '</div>';\n\n        container.appendChild(card);\n      });\n\n      // Update Statistics Header\n","at":1795413652702}