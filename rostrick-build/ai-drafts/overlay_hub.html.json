{"job":"jmws3yu10zbsm","file":"overlay_hub.html","text":"<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>التحكم بالطبقة العائمة - كوميكس أوفرلاي</title>\n<style>\n:root{\n  --primary:#D90429;\n  --primary-dark:#8D0801;\n  --accent:#FFB703;\n  --highlight:#FB8500;\n  --control:#2B2D42;\n  --bg:#F4F5F8;\n  --surface:#FFFFFF;\n  --ink:#141624;\n  --muted:#5C6078;\n  --border:#2B2D42;\n  --success:#16A34A;\n  --danger:#DC2626;\n}\n*{\n  box-sizing:border-box;\n  -webkit-tap-highlight-color:transparent;\n}\nhtml,body{\n  margin:0;\n  padding:0;\n  background-color:var(--bg);\n  color:var(--ink);\n  font-family:\"Tahoma\",\"Segoe UI\",\"Arial\",sans-serif;\n  font-size:15px;\n  line-height:1.5;\n  overflow-x:hidden;\n}\nbody{\n  padding-top:env(safe-area-inset-top);\n  padding-bottom:calc(78px + env(safe-area-inset-bottom));\n  background-image:radial-gradient(#D9DCE6 1.2px,transparent 1.2px);\n  background-size:16px 16px;\n}\na{\n  text-decoration:none;\n  color:inherit;\n}\nbutton{\n  font-family:inherit;\n  cursor:pointer;\n  border:none;\n  background:none;\n  padding:0;\n  color:inherit;\n}\nimg{\n  display:block;\n  max-width:100%;\n}\n\n/* App Bar */\n.app-bar{\n  position:sticky;\n  top:0;\n  z-index:40;\n  background:linear-gradient(135deg,var(--control) 0%,#1B1D2C 100%);\n  color:#FFFFFF;\n  border-bottom:3px solid var(--accent);\n  box-shadow:0 4px 12px rgba(20,22,36,0.22);\n  padding-top:env(safe-area-inset-top);\n}\n.app-bar-inner{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  padding:10px 14px;\n  min-height:60px;\n}\n.app-bar-start{\n  display:flex;\n  align-items:center;\n  min-width:0;\n}\n.icon-btn{\n  width:44px;\n  height:44px;\n  min-width:44px;\n  min-height:44px;\n  border-radius:12px;\n  background:rgba(255,255,255,0.12);\n  border:2px solid rgba(255,255,255,0.2);\n  color:#FFFFFF;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  transition:transform 0.12s ease, background-color 0.15s ease;\n}\n.icon-btn:active{\n  transform:scale(0.93);\n  background:rgba(255,255,255,0.22);\n}\n.app-title-wrap{\n  margin-right:10px;\n  min-width:0;\n}\n.app-title{\n  margin:0;\n  font-size:17px;\n  font-weight:700;\n  color:#FFFFFF;\n  white-space:nowrap;\n  overflow:hidden;\n  text-overflow:ellipsis;\n}\n.app-subtitle{\n  font-size:11px;\n  color:var(--accent);\n  font-weight:700;\n}\n.status-chip{\n  display:inline-flex;\n  align-items:center;\n  min-height:32px;\n  padding:4px 10px;\n  border-radius:999px;\n  font-size:11px;\n  font-weight:700;\n  border:2px solid #FFFFFF;\n  background:var(--primary);\n  color:#FFFFFF;\n  white-space:nowrap;\n}\n.status-chip.granted{\n  background:var(--success);\n  border-color:#DCFCE7;\n}\n.status-dot{\n  width:8px;\n  height:8px;\n  border-radius:50%;\n  background:#FFFFFF;\n  margin-left:6px;\n}\n\n/* Main Container */\n.container{\n  padding:14px;\n  max-width:720px;\n  margin:0 auto;\n}\n\n/* Comic Card Style */\n.comic-card{\n  background:var(--surface);\n  border:2.5px solid var(--border);\n  border-radius:16px;\n  box-shadow:4px 4px 0 var(--control);\n  padding:14px;\n  margin-bottom:16px;\n  position:relative;\n}\n.comic-card.hero-card{\n  background:linear-gradient(155deg,#FFFFFF 0%,#FFF8E6 100%);\n  border-color:var(--primary-dark);\n  box-shadow:5px 5px 0 var(--primary);\n}\n.section-head{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  margin-bottom:12px;\n}\n.section-title-wrap{\n  display:flex;\n  align-items:center;\n}\n.section-badge{\n  width:34px;\n  height:34px;\n  border-radius:10px;\n  background:var(--primary);\n  color:#FFFFFF;\n  border:2px solid var(--control);\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  margin-left:10px;\n  flex-shrink:0;\n}\n.section-badge.accent{\n  background:var(--accent);\n  color:var(--control);\n}\n.section-badge.control{\n  background:var(--control);\n  color:var(--accent);\n}\n.section-title{\n  margin:0;\n  font-size:16px;\n  font-weight:700;\n  color:var(--ink);\n}\n.section-sub{\n  font-size:12px;\n  color:var(--muted);\n  margin:2px 0 0 0;\n}\n\n/* Permission Banner */\n.perm-state-row{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  background:#FFFFFF;\n  border:2px solid var(--control);\n  border-radius:12px;\n  padding:10px 12px;\n  margin-bottom:12px;\n}\n.perm-label{\n  font-size:13px;\n  font-weight:700;\n}\n.perm-pill{\n  padding:4px 10px;\n  border-radius:8px;\n  font-size:12px;\n  font-weight:700;\n}\n.perm-pill.off{\n  background:#FEE2E2;\n  color:var(--primary-dark);\n  border:1.5px solid var(--primary);\n}\n.perm-pill.on{\n  background:#DCFCE7;\n  color:#14532D;\n  border:1.5px solid var(--success);\n}\n.perm-desc{\n  font-size:13px;\n  color:var(--muted);\n  margin:0 0 12px 0;\n}\n.btn-row{\n  display:flex;\n  flex-wrap:wrap;\n  margin:-4px;\n}\n.btn-row > *{\n  margin:4px;\n}\n.btn{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  min-height:44px;\n  padding:10px 16px;\n  border-radius:12px;\n  font-size:14px;\n  font-weight:700;\n  border:2px solid var(--control);\n  box-shadow:0 3px 0 var(--control);\n  transition:transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;\n}\n.btn:active{\n  transform:translateY(2px);\n  box-shadow:0 1px 0 var(--control);\n}\n.btn-primary{\n  background:var(--primary);\n  color:#FFFFFF;\n}\n.btn-accent{\n  background:var(--accent);\n  color:var(--ink);\n}\n.btn-control{\n  background:var(--control);\n  color:#FFFFFF;\n}\n.btn-outline{\n  background:#FFFFFF;\n  color:var(--control);\n}\n.btn-success{\n  background:var(--success);\n  color:#FFFFFF;\n}\n.btn-sm{\n  min-height:44px;\n  padding:8px 12px;\n  font-size:13px;\n}\n.btn svg{\n  margin-left:6px;\n  flex-shrink:0;\n}\n.btn-full{\n  width:100%;\n}\n\n/* Controls Grid */\n.control-box{\n  background:#F8F9FC;\n  border:2px solid #DCE0EB;\n  border-radius:12px;\n  padding:12px;\n  margin-bottom:10px;\n}\n.control-label-row{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  margin-bottom:8px;\n  font-size:13px;\n  font-weight:700;\n}\n.range-input{\n  width:100%;\n  height:32px;\n  accent-color:var(--primary);\n}\n.seg-group{\n  display:flex;\n  background:#E5E7F0;\n  border:2px solid var(--control);\n  border-radius:12px;\n  padding:3px;\n}\n.seg-btn{\n  flex:1;\n  min-height:40px;\n  border-radius:9px;\n  font-size:13px;\n  font-weight:700;\n  color:var(--control);\n  transition:background-color 0.15s ease, color 0.15s ease;\n}\n.seg-btn.active{\n  background:var(--primary);\n  color:#FFFFFF;\n}\n.toggle-row{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  min-height:48px;\n  padding:6px 0;\n  border-top:1.5px dashed #D3D7E4;\n}\n.toggle-row:first-child{\n  border-top:none;\n}\n.toggle-title{\n  font-size:13px;\n  font-weight:700;\n  color:var(--ink);\n}\n.toggle-sub{\n  font-size:11px;\n  color:var(--muted);\n}\n.switch-btn{\n  width:56px;\n  height:34px;\n  min-width:56px;\n  min-height:44px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n.switch-track{\n  width:52px;\n  height:30px;\n  border-radius:999px;\n  background:#CBD2E1;\n  border:2px solid var(--control);\n  position:relative;\n  transition:background-color 0.2s ease;\n}\n.switch-thumb{\n  width:22px;\n  height:22px;\n  border-radius:50%;\n  background:#FFFFFF;\n  border:2px solid var(--control);\n  position:absolute;\n  top:2px;\n  right:2px;\n  transition:transform 0.2s ease;\n}\n.switch-btn.on .switch-track{\n  background:var(--accent);\n}\n.switch-btn.on .switch-thumb{\n  transform:translateX(-22px);\n}\n\n/* Active Windows List */\n.active-window-item{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  background:#FFF7E0;\n  border:2px solid var(--highlight);\n  border-radius:12px;\n  padding:10px;\n  margin-bottom:8px;\n}\n.active-window-info{\n  min-width:0;\n  margin-left:8px;\n}\n.active-window-title{\n  font-size:14px;\n  font-weight:700;\n  white-space:nowrap;\n  overflow:hidden;\n  text-overflow:ellipsis;\n}\n.active-window-meta{\n  font-size:11px;\n  color:var(--muted);\n}\n.empty-box{\n  text-align:center;\n  padding:18px 12px;\n  background:#F8F9FC;\n  border:2px dashed #B9C0D4;\n  border-radius:12px;\n  color:var(--muted);\n  font-size:13px;\n}\n\n/* Item Cards (Games / Comics / PDFs) */\n.tabs-bar{\n  display:flex;\n  background:#EDEFF5;\n  border:2px solid var(--control);\n  border-radius:12px;\n  padding:4px;\n  margin-bottom:12px;\n}\n.tab-btn{\n  flex:1;\n  min-height:44px;\n  border-radius:9px;\n  font-size:13px;\n  font-weight:700;\n  color:var(--control);\n}\n.tab-btn.active{\n  background:var(--control);\n  color:var(--accent);\n}\n.media-item{\n  display:flex;\n  align-items:flex-start;\n  background:#FFFFFF;\n  border:2px solid var(--control);\n  border-radius:14px;\n  padding:10px;\n  margin-bottom:10px;\n  box-shadow:3px 3px 0 #D4D8E6;\n}\n.media-thumb{\n  width:72px;\n  height:72px;\n  border-radius:12px;\n  border:2px solid var(--control);\n  object-fit:cover;\n  flex-shrink:0;\n  margin-left:12px;\n  background:#1A1D2E;\n}\n.media-body{\n  flex:1;\n  min-width:0;\n}\n.media-title{\n  margin:0 0 4px 0;\n  font-size:14px;\n  font-weight:700;\n  color:var(--ink);\n}\n.media-meta{\n  font-size:12px;\n  color:var(--muted);\n  margin-bottom:8px;\n}\n.badge-pill{\n  display:inline-block;\n  font-size:11px;\n  font-weight:700;\n  padding:2px 8px;\n  border-radius:6px;\n  background:var(--accent);\n  color:var(--control);\n  border:1.5px solid var(--control);\n  margin-bottom:6px;\n}\n.badge-pill.red{\n  background:#FFE4E6;\n  color:var(--primary-dark);\n  border-color:var(--primary);\n}\n.item-actions{\n  display:flex;\n  flex-wrap:wrap;\n  margin:-3px;\n}\n.item-actions > *{\n  margin:3px;\n}\n\n/* Bottom Navigation */\n.bottom-nav{\n  position:fixed;\n  bottom:0;\n  left:0;\n  right:0;\n  z-index:45;\n  background:var(--control);\n  border-top:3px solid var(--accent);\n  padding-bottom:env(safe-area-inset-bottom);\n  display:flex;\n  align-items:stretch;\n  box-shadow:0 -4px 14px rgba(20,22,36,0.2);\n}\n.nav-item{\n  flex:1;\n  min-height:60px;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  justify-content:center;\n  color:#CBD2E1;\n  font-size:11px;\n  font-weight:700;\n  padding:6px 4px;\n  transition:background-color 0.15s ease, color 0.15s ease;\n}\n.nav-item:active{\n  background:rgba(255,255,255,0.1);\n}\n.nav-item.active{\n  color:var(--accent);\n  background:rgba(255,183,3,0.12);\n}\n.nav-item svg{\n  margin-bottom:3px;\n}\n\n/* Floating Overlay Window (Interactive Live Simulation & WebView Layer) */\n.floating-window{\n  position:fixed;\n  z-index:90;\n  top:90px;\n  right:16px;\n  width:290px;\n  background:#FFFFFF;\n  border:3px solid var(--control);\n  border-radius:16px;\n  box-shadow:0 14px 32px rgba(20,22,36,0.42), 5px 5px 0 var(--primary);\n  overflow:hidden;\n  display:none;\n  flex-direction:column;\n}\n.floating-window.visible{\n  display:flex;\n}\n.floating-window.size-s{\n  width:240px;\n}\n.floating-window.size-m{\n  width:300px;\n}\n.floating-window.size-l{\n  width:340px;\n}\n.floating-header{\n  background:linear-gradient(135deg,var(--primary) 0%,var(--primary-dark) 100%);\n  color:#FFFFFF;\n  padding:6px 8px;\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  cursor:move;\n  touch-action:none;\n  border-bottom:2.5px solid var(--control);\n}\n.floating-drag-title{\n  display:flex;\n  align-items:center;\n  min-width:0;\n  font-size:12px;\n  font-weight:700;\n}\n.floating-drag-title svg{\n  margin-left:6px;\n  flex-shrink:0;\n}\n.floating-title-text{\n  white-space:nowrap;\n  overflow:hidden;\n  text-overflow:ellipsis;\n}\n.floating-win-btns{\n  display:flex;\n  align-items:center;\n}\n.win-btn{\n  width:36px;\n  height:36px;\n  min-width:36px;\n  min-height:36px;\n  border-radius:8px;\n  background:rgba(255,255,255,0.18);\n  color:#FFFFFF;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  margin-right:4px;\n}\n.win-btn:active{\n  background:rgba(255,255,255,0.35);\n}\n.floating-body{\n  background:#161824;\n  color:#FFFFFF;\n  position:relative;\n}\n.floating-iframe{\n  width:100%;\n  height:270px;\n  border:0;\n  display:block;\n  background:#161824;\n}\n.floating-window.size-s .floating-iframe{\n  height:220px;\n}\n.floating-window.size-l .floating-iframe{\n  height:330px;\n}\n.mini-reader-box{\n  padding:12px;\n  background:#1B1E2E;\n  color:#FFFFFF;\n}\n.mini-comic-stage{\n  background:#FFFFFF;\n  color:var(--ink);\n  border:2px solid var(--accent);\n  border-radius:12px;\n  padding:12px;\n  min-height:175px;\n  display:flex;\n  flex-direction:column;\n  justify-content:space-between;\n  margin-bottom:10px;\n}\n.mini-comic-cover-row{\n  display:flex;\n  align-items:center;\n  margin-bottom:8px;\n}\n.mini-comic-cover-row img{\n  width:48px;\n  height:48px;\n  border-radius:8px;\n  border:2px solid var(--control);\n  margin-left:10px;\n}\n.mini-reader-controls{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n}\n.mini-page-pill{\n  font-size:12px;\n  font-weight:700;\n  color:var(--accent);\n}\n.floating-footer{\n  background:var(--control);\n  padding:6px 10px;\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  font-size:11px;\n  color:#E2E8F0;\n}\n.floating-footer a{\n  color:var(--accent);\n  font-weight:700;\n  padding:6px 8px;\n  min-height:32px;\n  display:inline-flex;\n  align-items:center;\n}\n\n/* Floating Bubble */\n.floating-bubble{\n  position:fixed;\n  z-index:92;\n  bottom:96px;\n  left:16px;\n  width:60px;\n  height:60px;\n  border-radius:50%;\n  background:linear-gradient(135deg,var(--primary) 0%,var(--highlight) 100%);\n  border:3px solid #FFFFFF;\n  box-shadow:0 6px 18px rgba(20,22,36,0.45), 0 0 0 3px var(--control);\n  color:#FFFFFF;\n  display:none;\n  align-items:center;\n  justify-content:center;\n  touch-action:none;\n}\n.floating-bubble.visible{\n  display:flex;\n}\n.bubble-badge{\n  position:absolute;\n  top:-4px;\n  right:-4px;\n  min-width:22px;\n  height:22px;\n  border-radius:999px;\n  background:var(--accent);\n  color:var(--control);\n  border:2px solid var(--control);\n  font-size:11px;\n  font-weight:700;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  padding:0 4px;\n}\n\n/* Permission Modal / Bottom Sheet */\n.sheet-backdrop{\n  position:fixed;\n  top:0;\n  left:0;\n  right:0;\n  bottom:0;\n  z-index:100;\n  background:rgba(20,22,36,0.65);\n  display:none;\n  align-items:flex-end;\n  justify-content:center;\n  padding:12px;\n}\n.sheet-backdrop.open{\n  display:flex;\n}\n.sheet-panel{\n  width:100%;\n  max-width:480px;\n  background:#FFFFFF;\n  border:3px solid var(--control);\n  border-radius:20px;\n  box-shadow:0 -4px 24px rgba(0,0,0,0.3);\n  padding:18px;\n  margin-bottom:env(safe-area-inset-bottom);\n}\n.sheet-handle{\n  width:46px;\n  height:5px;\n  border-radius:999px;\n  background:#CBD2E1;\n  margin:0 auto 14px auto;\n}\n.sheet-icon{\n  width:56px;\n  height:56px;\n  border-radius:16px;\n  background:#FFF3CD;\n  border:2.5px solid var(--control);\n  color:var(--primary);\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  margin:0 auto 12px auto;\n}\n.sheet-title{\n  margin:0 0 6px 0;\n  text-align:center;\n  font-size:17px;\n  font-weight:700;\n}\n.sheet-text{\n  margin:0 0 14px 0;\n  text-align:center;\n  font-size:13px;\n  color:var(--muted);\n}\n.perm-code-box{\n  background:#F4F5F8;\n  border:1.5px solid #CBD2E1;\n  border-radius:10px;\n  padding:8px 10px;\n  font-size:12px;\n  color:var(--control);\n  text-align:center;\n  margin-bottom:14px;\n  direction:ltr;\n}\n\n/* Toast Notification */\n.toast{\n  position:fixed;\n  bottom:84px;\n  left:50%;\n  transform:translateX(-50%) translateY(20px);\n  z-index:110;\n  background:var(--control);\n  color:#FFFFFF;\n  border:2px solid var(--accent);\n  border-radius:12px;\n  padding:10px 16px;\n  font-size:13px;\n  font-weight:700;\n  opacity:0;\n  pointer-events:none;\n  transition:opacity 0.2s ease, transform 0.2s ease;\n  max-width:90%;\n  text-align:center;\n}\n.toast.show{\n  opacity:1;\n  transform:translateX(-50%) translateY(0);\n}\n</style>\n</head>\n<body>\n\n<header class=\"app-bar\">\n  <div class=\"app-bar-inner\">\n    <div class=\"app-bar-start\">\n      <a href=\"home.html\" class=\"icon-btn\" aria-label=\"العودة إلى الرئيسية\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <polyline points=\"9 18 15 12 9 6\"></polyline>\n        </svg>\n      </a>\n      <div class=\"app-title-wrap\">\n        <h1 class=\"app-title\">التحكم بالطبقة العائمة</h1>\n        <div class=\"app-subtitle\">النوافذ العائمة فوق التطبيقات</div>\n      </div>\n    </div>\n    <button type=\"button\" id=\"headerPermChip\" class=\"status-chip\" aria-label=\"حالة إذن الظهور فوق التطبيقات\">\n      <span class=\"status-dot\"></span>\n      <span id=\"headerPermText\">الإذن غير مفعّل</span>\n    </button>\n  </div>\n</header>\n\n<main class=\"container\">\n\n  <!-- 1. Permission Request Card -->\n  <section class=\"comic-card hero-card\" aria-labelledby=\"permCardTitle\">\n    <div class=\"section-head\">\n      <div class=\"section-title-wrap\">\n        <div class=\"section-badge\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"3\" y=\"3\" width=\"14\" height=\"14\" rx=\"2\"></rect>\n            <path d=\"M7 21h12a2 2 0 0 0 2-2V7\"></path>\n          </svg>\n        </div>\n        <div>\n          <h2 id=\"permCardTitle\" class=\"section-title\">إذن الظهور فوق التطبيقات الأخرى</h2>\n          <p class=\"section-sub\">مطلوب لتثبيت قارئ الكوميكس أو الألعاب فوق أي تطبيق</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"perm-state-row\">\n      <span class=\"perm-label\">حالة النظام:</span>\n      <span id=\"permStatusBadge\" class=\"perm-pill off\">يتطلب التفعيل</span>\n    </div>\n\n    <p class=\"perm-desc\" id=\"permDescText\">\n      فعّل إذن العرض فوق التطبيقات لتتمكن من سحب نافذة القراءة أو تشغيل الألعاب المصغرة أثناء استخدام تطبيقات أخرى.\n    </p>\n\n    <div class=\"btn-row\">\n      <button type=\"button\" id=\"requestPermBtn\" class=\"btn btn-primary\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n        </svg>\n        <span id=\"requestPermBtnText\">طلب إذن الظهور الآن</span>\n      </button>\n      <button type=\"button\" id=\"toggleBubbleBtn\" class=\"btn btn-accent\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"12\" cy=\"12\" r=\"9\"></circle>\n          <polygon points=\"10 8 16 12 10 16 10 8\"></polygon>\n        </svg>\n        <span>إطلاق الفقاعة العائمة</span>\n      </button>\n    </div>\n  </section>\n\n  <!-- 2. Active Windows & Overlay Settings -->\n  <section class=\"comic-card\" aria-labelledby=\"activeWinTitle\">\n    <div class=\"section-head\">\n      <div class=\"section-title-wrap\">\n        <div class=\"section-badge accent\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"3\"></rect>\n            <line x1=\"2\" y1=\"9\" x2=\"22\" y2=\"9\"></line>\n          </svg>\n        </div>\n        <div>\n          <h2 id=\"activeWinTitle\" class=\"section-title\">إدارة النوافذ العائمة النشطة</h2>\n          <p class=\"section-sub\">تحكم بالحجم والشفافية والمحاذاة</p>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"activeWindowsList\"></div>\n\n    <div class=\"control-box\">\n      <div class=\"control-label-row\">\n        <span>شفافية النافذة العائمة</span>\n        <span id=\"opacityValText\">100%</span>\n      </div>\n      <input type=\"range\" id=\"opacitySlider\" class=\"range-input\" min=\"50\" max=\"100\" step=\"5\" value=\"100\" aria-label=\"شفافية النافذة العائمة\">\n    </div>\n\n    <div class=\"control-box\">\n      <div class=\"control-label-row\">\n        <span>حجم النافذة العائمة</span>\n      </div>\n      <div class=\"seg-group\" role=\"group\" aria-label=\"حجم النافذة\">\n        <button type=\"button\" class=\"seg-btn\" data-size=\"s\">صغير</button>\n        <button type=\"button\" class=\"seg-btn active\" data-size=\"m\">متوسط</button>\n        <button type=\"button\" class=\"seg-btn\" data-size=\"l\">كبير</button>\n      </div>\n    </div>\n\n    <div class=\"control-box\">\n      <div class=\"toggle-row\">\n        <div>\n          <div class=\"toggle-title\">الالتصاق التلقائي بحواف الشاشة</div>\n          <div class=\"toggle-sub\">تثبيت الفقاعة على أقرب حافة عند الإفلات</div>\n        </div>\n        <button type=\"button\" id=\"snapToggleBtn\" class=\"switch-btn on\" role=\"switch\" aria-checked=\"true\" aria-label=\"الالتصاق التلقائي بحواف الشاشة\">\n          <span class=\"switch-track\"><span class=\"switch-thumb\"></span></span>\n        </button>\n      </div>\n      <div class=\"toggle-row\">\n        <div>\n          <div class=\"toggle-title\">التصغير السريع عند الخروج</div>\n          <div class=\"toggle-sub\">تحويل النافذة إلى فقاعة عائمة بدلاً من إغلاقها</div>\n        </div>\n        <button type=\"button\" id=\"minimizeOnCloseBtn\" class=\"switch-btn on\" role=\"switch\" aria-checked=\"true\" aria-label=\"التصغير السريع عند الخروج\">\n          <span class=\"switch-track\"><span class=\"switch-thumb\"></span></span>\n        </button>\n      </div>\n    </div>\n  </section>\n\n  <!-- 3. Floating Mini-Games Launcher -->\n  <section class=\"comic-card\" aria-labelledby=\"gamesSectionTitle\">\n    <div class=\"section-head\">\n      <div class=\"section-title-wrap\">\n        <div class=\"section-badge\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"4\"></rect>\n            <line x1=\"6\" y1=\"12\" x2=\"10\" y2=\"12\"></line>\n            <line x1=\"8\" y1=\"10\" x2=\"8\" y2=\"14\"></line>\n            <circle cx=\"16\" cy=\"10\" r=\"1\"></circle>\n            <circle cx=\"18\" cy=\"13\" r=\"1\"></circle>\n          </svg>\n        </div>\n        <div>\n          <h2 id=\"gamesSectionTitle\" class=\"section-title\">الألعاب المصغرة في الطبقة العائمة</h2>\n          <p class=\"section-sub\">شغّل اللعبة كنافذة عائمة أو بملء الشاشة</p>\n        </div>\n      </div>\n      <a href=\"games.html\" class=\"btn btn-outline btn-sm\">كل الألعاب</a>\n    </div>\n\n    <div id=\"gamesListContainer\">\n      <div class=\"empty-box\">جاري تحميل قائمة الألعاب المصغرة...</div>\n    </div>\n  </section>\n\n  <!-- 4. Floating Comics & PDF Reader Launcher -->\n  <section class=\"comic-card\" aria-labelledby=\"comicsSectionTitle\">\n    <div class=\"section-head\">\n      <div class=\"section-title-wrap\">\n        <div class=\"section-badge control\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"></path>\n            <path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"></path>\n          </svg>\n        </div>\n        <div>\n          <h2 id=\"comicsSectionTitle\" class=\"section-title\">قراءة الكوميكس وملفات PDF عائماً</h2>\n          <p class=\"section-sub\">افتح فصلاً سريعاً في النافذة العائمة فوق التطبيقات</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"tabs-bar\" role=\"tablist\">\n      <button type=\"button\" class=\"tab-btn active\" data-tab=\"comics\" role=\"tab\" aria-selected=\"true\">قصص الكوميكس</button>\n      <button type=\"button\" class=\"tab-btn\" data-tab=\"pdfs\" role=\"tab\" aria-selected=\"false\">روابط ملفات PDF</button>\n    </div>\n\n    <div id=\"comicsTabPanel\">\n      <div class=\"empty-box\">جاري تحميل قصص الكوميكس...</div>\n    </div>\n    <div id=\"pdfsTabPanel\" style=\"display:none;\">\n      <div class=\"empty-box\">جاري تحميل روابط PDF...</div>\n    </div>\n  </section>\n\n</main>\n\n<!-- Interactive Floating Window -->\n<div id=\"floatingWindow\" class=\"floating-window size-m\" role=\"dialog\" aria-label=\"النافذة العائمة\">\n  <div id=\"floatingDragBar\" class=\"floating-header\">\n    <div class=\"floating-drag-title\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <polyline points=\"5 9 2 12 5 15\"></polyline>\n        <polyline points=\"9 5 12 2 15 5\"></polyline>\n        <polyline points=\"15 19 12 22 9 19\"></polyline>\n        <polyline points=\"19 9 22 12 19 15\"></polyline>\n        <line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"></line>\n        <line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"22\"></line>\n      </svg>\n      <span id=\"floatingWinTitle\" class=\"floating-title-text\">النافذة العائمة</span>\n    </div>\n    <div class=\"floating-win-btns\">\n      <button type=\"button\" id=\"winMinimizeBtn\" class=\"win-btn\" aria-label=\"تصغير إلى فقاعة\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n          <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n        </svg>\n      </button>\n      <button type=\"button\" id=\"winCloseBtn\" class=\"win-btn\" aria-label=\"إغلاق النافذة العائمة\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n          <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line>\n          <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line>\n        </svg>\n      </button>\n    </div>\n  </div>\n  <div id=\"floatingBody\" class=\"floating-body\"></div>\n  <div class=\"floating-footer\">\n    <span id=\"floatingModeLabel\">وضع الطبقة العائمة</span>\n    <a id=\"floatingOpenFullLink\" href=\"reader.html\">فتح بملء الشاشة</a>\n  </div>\n</div>\n\n<!-- Floating Bubble -->\n<button type=\"button\" id=\"floatingBubble\" class=\"floating-bubble\" aria-label=\"استعادة النافذة العائمة\">\n  <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <rect x=\"3\" y=\"3\" width=\"14\" height=\"14\" rx=\"3\"></rect>\n    <path d=\"M8 21h10a3 3 0 0 0 3-3V8\"></path>\n  </svg>\n  <span id=\"bubbleBadgeCount\" class=\"bubble-badge\">1</span>\n</button>\n\n<!-- Permission Bottom Sheet -->\n<div id=\"permSheetBackdrop\" class=\"sheet-backdrop\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sheetTitle\">\n  <div class=\"sheet-panel\">\n    <div class=\"sheet-handle\"></div>\n    <div class=\"sheet-icon\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n        <path d=\"M9 12l2 2 4-4\"></path>\n      </svg>\n    </div>\n    <h3 id=\"sheetTitle\" class=\"sheet-title\">السماح بالظهور فوق التطبيقات الأخرى</h3>\n    <p class=\"sheet-text\">\n      يطلب تطبيق كوميكس أوفرلاي إذن النظام لعرض نافذة قراءة الكوميكس والألعاب المصغرة فوق التطبيقات الأخرى أثناء التنقل.\n    </p>\n    <div class=\"perm-code-box rt-selectable\">android.permission.SYSTEM_ALERT_WINDOW</div>\n    <div class=\"btn-row\">\n      <button type=\"button\" id=\"grantPermConfirmBtn\" class=\"btn btn-success btn-full\">السماح وتفعيل الطبقة العائمة</button>\n      <button type=\"button\" id=\"revokePermConfirmBtn\" class=\"btn btn-outline btn-full\">إلغاء الإذن</button>\n      <button type=\"button\" id=\"closeSheetBtn\" class=\"btn btn-control btn-full\">إغلاق</button>\n    </div>\n  </div>\n</div>\n\n<!-- Toast -->\n<div id=\"toastMsg\" class=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n\n<!-- Bottom Navigation -->\n<nav class=\"bottom-nav\" aria-label=\"التنقل الرئيسي\">\n  <a href=\"home.html\" class=\"nav-item\">\n    <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path>\n      <polyline points=\"9 22 9 12 15 12 15 22\"></polyline>\n    </svg>\n    <span>المكتبة</span>\n  </a>\n  <a href=\"reader.html\" class=\"nav-item\">\n    <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\"></path>\n      <path d=\"M22 3h-6a4 4 ","at":1795369244365}